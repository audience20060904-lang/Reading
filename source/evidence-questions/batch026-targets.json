    },
    {
      "order": 9,
      "questionId": "qe-c07-0066",
      "sentenceId": "c07-s03-p073-03210-s001",
      "sentenceText": "Is there any empirical evidence that suggests playfulness is actually good?",
      "sentenceSha256": "7a383fc401dcc003636f81a0e7a5fb48def9f70a9103f8f0a79ffda85b533ed0",
      "readingUnitId": "c07-s03-p073-03210-r001-004",
