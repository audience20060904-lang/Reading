    {
      "order": 18,
      "questionId": "qe-c07-0075",
      "sentenceId": "c07-s04-p074-04185-s001",
      "sentenceText": "When I got a faculty position at the University of Minnesota, I hoped to do the same and dropped by a nearby assistant professor’s office.",
