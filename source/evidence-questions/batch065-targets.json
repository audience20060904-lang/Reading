      "pdfPages": [
        166
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c14-0073",
      "sentenceId": "c14-s03-p166-00750-s008",
      "sentenceText": "Sacks had all three forms of a good life after all.",
      "sentenceSha256": "3ed5d0ef79caaa9cccf9254ff6c7d75da06fad68c52c98b8cabb549c4f11633a",
      "readingUnitId": "c14-s03-p166-00750-r008-010",
      "parentQuestionId": "q-c14-045",
