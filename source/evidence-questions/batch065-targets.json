      "pdfPages": [
        165
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c14-0070",
      "sentenceId": "c14-s03-p166-00750-s001",
      "sentenceText": "In this book, I have showcased a new path to a good life: psychological richness.",
