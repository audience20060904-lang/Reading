      "parentFingerprint": "446df1344800b2f6868400cc2951c9b53435f71906e3dc22feecc9765d86afda",
      "passageSha256": "8a8154cf992f2ef96a94bee11516ea8e28bf14345994f7cf8a3173b533e109ca",
      "pdfPages": [
        166
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c14-0071",
      "sentenceId": "c14-s03-p166-00750-s004",
      "sentenceText": "Like Goldmund in Narcissus and Goldmund, even if you aren’t happy and don’t find your life to be meaningful, you can still lead a good life if you fill it with diverse, interesting, and perspective-changing experiences.",
      "sentenceSha256": "2fa324cc0e2dd1f37f1b41f85fdc025a08c3b3cb95d1e3c6629c37d489fdfd68",
      "readingUnitId": "c14-s03-p166-00750-r004-007",
      "parentQuestionId": "q-c14-044",
      "parentFingerprint": "d9224d2ace62869bff1909af6a6d83f5fb4393efc053477f73764ffb887351e3",
      "passageSha256": "21b3697c3d8e9eeff25755dac71833b8c085b6e570cf45b4367ae1fbbc695060",
      "pdfPages": [
        166
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c14-0072",
      "sentenceId": "c14-s03-p166-00750-s006",
      "sentenceText": "For instance, Oliver Sacks seemed to be very happy at the end of his life.",
      "sentenceSha256": "5a5de32b2175cc741436b1ba2ce5d47aa086a43f8fdf067fce32412a02451636",
      "readingUnitId": "c14-s03-p166-00750-r004-007",
