    },
    {
      "order": 10,
      "questionId": "qe-c14-0068",
      "sentenceId": "c14-s03-p165-04650-s008",
      "sentenceText": "Other places encourage us to explore and gain psychological richness.",
      "sentenceSha256": "2bd75c3d183d4c4b2149c97a776120d5625ad56690d9a4f489f58e297a35645a",
      "readingUnitId": "c14-s03-p165-04650-r005-008",
