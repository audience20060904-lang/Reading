      "pdfPages": [
        166
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c14-0075",
      "sentenceId": "c14-s03-p166-03675-s004",
      "sentenceText": "Now we have discovered a third dimension: psychological richness.",
      "sentenceSha256": "a96b5a051db152552f37f41b89ebc34db5528b2881f71fed67ff2156918313cb",
      "readingUnitId": "c14-s03-p166-03675-r001-004",
