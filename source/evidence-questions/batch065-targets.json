      "pdfPages": [
        166
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c14-0074",
      "sentenceId": "c14-s03-p166-03675-s001",
      "sentenceText": "So, it’s fair to wonder: are there any other paths to a good life?",
