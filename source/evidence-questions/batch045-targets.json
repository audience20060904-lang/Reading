  "targets": [
    {
      "order": 1,
      "questionId": "qe-c10-0153",
      "sentenceId": "c10-s08-p117-03090-s004",
      "sentenceText": "They wanted variety!",
      "sentenceSha256": "8da980c6bacf1426651d8f13513184319106cabd2b04080380a0f8fe6b9f9ce9",
      "readingUnitId": "c10-s08-p117-03090-r001-004",
      "parentQuestionId": "q-c10-090",
      "parentFingerprint": "24be01d66b62514036a12422df70424f92efa1f9b320b65172602f1392746530",
      "passageSha256": "6211fc3403dc308fac1404f662fd970d79f9e3ed5b6a1cd975be4f69178b6bf7",
      "pdfPages": [
        117
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c10-0154",
      "sentenceId": "c10-s08-p117-05040-s002",
      "sentenceText": "We like the idea of going to a different restaurant every week, but we actually tend to stick with our favorite restaurant again and again.",
      "sentenceSha256": "8ab919ccd58ab1b6ac88cce09be3b257b91acf11b334b3069aceaee9a3b5cb57",
      "readingUnitId": "c10-s08-p117-05040-r001-004",
      "parentQuestionId": "q-c10-092",
      "parentFingerprint": "7ce2059530e9390e01c98a6319b85922b7ef4cd0c8e2c191cf536de1c0408582",
      "passageSha256": "f249fac7aba196acfa48fd9abfa656dde484f72d4db6bcf546c276f00203c8e1",
      "pdfPages": [
        117
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c10-0155",
      "sentenceId": "c10-s08-p117-05040-s003",
      "sentenceText": "In the planning phase, we seek variety.",
      "sentenceSha256": "5ce96d7f576ee4e48b6c1845ca12891f5fe63aec44b3b87137eaf10eac596e2b",
      "readingUnitId": "c10-s08-p117-05040-r001-004",
      "parentQuestionId": "q-c10-092",
      "parentFingerprint": "7ce2059530e9390e01c98a6319b85922b7ef4cd0c8e2c191cf536de1c0408582",
      "passageSha256": "f249fac7aba196acfa48fd9abfa656dde484f72d4db6bcf546c276f00203c8e1",
      "pdfPages": [
        117
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c10-0156",
      "sentenceId": "c10-s08-p117-05040-s004",
      "sentenceText": "Imagining different snacks is exciting!",
      "sentenceSha256": "719391b980ff30ec931bfd3832ca47acdee7df9cf093cfff8a70b9e9cbd2cc8e",
      "readingUnitId": "c10-s08-p117-05040-r001-004",
      "parentQuestionId": "q-c10-092",
      "parentFingerprint": "7ce2059530e9390e01c98a6319b85922b7ef4cd0c8e2c191cf536de1c0408582",
      "passageSha256": "f249fac7aba196acfa48fd9abfa656dde484f72d4db6bcf546c276f00203c8e1",
      "pdfPages": [
        117
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c10-0157",
      "sentenceId": "c10-s08-p117-05040-s005",
      "sentenceText": "Imagining a hike in the Alps is exciting!",
      "sentenceSha256": "8bb7d323d8bd15736dc522933a69c7bcb55ca823638ef7977ac525f3f7ce6ac5",
      "readingUnitId": "c10-s08-p117-05040-r005-008",
      "parentQuestionId": "q-c10-093",
      "parentFingerprint": "d5ca2facc2daedd210c8ea16eff554d4813ee28689c5e08bf7334a03b561f424",
      "passageSha256": "dfd77c74b0aea6a43817b7cca59131563bf6bbd53e7f059535a268990f63c3a1",
      "pdfPages": [
        117
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c10-0158",
      "sentenceId": "c10-s08-p117-05040-s007",
      "sentenceText": "When faced with an actual choice, we tend to choose a sure “winner” rather than a risky product.",
      "sentenceSha256": "54059345af5e5ca4920dcaa74be1474f4efd16aba10a63198fd27574f1f8e7e1",
      "readingUnitId": "c10-s08-p117-05040-r005-008",
      "parentQuestionId": "q-c10-093",
      "parentFingerprint": "d5ca2facc2daedd210c8ea16eff554d4813ee28689c5e08bf7334a03b561f424",
      "passageSha256": "dfd77c74b0aea6a43817b7cca59131563bf6bbd53e7f059535a268990f63c3a1",
      "pdfPages": [
        117
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c10-0159",
      "sentenceId": "c10-s08-p117-05040-s008",
      "sentenceText": "We’ll settle for something familiar because trying something new is too much work.",
      "sentenceSha256": "8ba55456d3d785a9e460d34ad85408626899df7c1d67f1d0223b3f1ce9e9956b",
      "readingUnitId": "c10-s08-p117-05040-r005-008",
      "parentQuestionId": "q-c10-093",
      "parentFingerprint": "d5ca2facc2daedd210c8ea16eff554d4813ee28689c5e08bf7334a03b561f424",
      "passageSha256": "dfd77c74b0aea6a43817b7cca59131563bf6bbd53e7f059535a268990f63c3a1",
      "pdfPages": [
        117
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c10-0160",
      "sentenceId": "c10-s08-p117-05040-s010",
      "sentenceText": "Familiarity is warm and fuzzy, and it has a surprising power over us, steering us away from psychological richness.",
      "sentenceSha256": "bf983d17829dde4f733e94b1af79c99fcb8efb95433fa03d8c15b80fc9c8bf23",
      "readingUnitId": "c10-s08-p117-05040-r009-010",
      "parentQuestionId": "q-c10-094",
      "parentFingerprint": "1eae29dee8e16a53284d2f10db2c07174e37a19e7efc1cdce31e7e1380a2611c",
      "passageSha256": "000ddbc44b69291fb4b524b198fb3a7b6e17d7b2c0b651d60cf5136988f134b5",
      "pdfPages": [
        117,
        118
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c10-0161",
      "sentenceId": "c10-s08-p118-01140-s001",
      "sentenceText": "This is also related to a larger human tendency: loss aversion.",
      "sentenceSha256": "8a35bae34d59a78ccbe9922bb321442365d562bc666698cd116d887a10e348c9",
      "readingUnitId": "c10-s08-p118-01140-r001-004",
      "parentQuestionId": "q-c10-095",
      "parentFingerprint": "ce44c695ed67f751b2a95827ce059ee2a0969baff57b58aa453e28fff28dc46c",
      "passageSha256": "47660631dcd74605c8da17fafdd92517fd4f0c36b775edf7fb53687c9dca3f62",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c10-0162",
      "sentenceId": "c10-s08-p118-01140-s002",
      "sentenceText": "Daniel Kahneman and Amos Tversky asked subjects: Given a 50 percent chance of winning £1,000 vs. a 100 percent chance of winning £450, which would you prefer?",
      "sentenceSha256": "c72d49e9746c49fd2f7b1191d28fe1373f551e24e87f0677b36fdc0753a506b6",
      "readingUnitId": "c10-s08-p118-01140-r001-004",
      "parentQuestionId": "q-c10-095",
      "parentFingerprint": "ce44c695ed67f751b2a95827ce059ee2a0969baff57b58aa453e28fff28dc46c",
      "passageSha256": "47660631dcd74605c8da17fafdd92517fd4f0c36b775edf7fb53687c9dca3f62",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c10-0163",
      "sentenceId": "c10-s08-p118-01140-s004",
      "sentenceText": "Nevertheless, most of us would choose the latter.",
      "sentenceSha256": "3ba8e023611ae0e460b72bf67a841d9ea78795df0ff50f711255cb8906b38686",
      "readingUnitId": "c10-s08-p118-01140-r001-004",
      "parentQuestionId": "q-c10-095",
      "parentFingerprint": "ce44c695ed67f751b2a95827ce059ee2a0969baff57b58aa453e28fff28dc46c",
      "passageSha256": "47660631dcd74605c8da17fafdd92517fd4f0c36b775edf7fb53687c9dca3f62",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c10-0164",
      "sentenceId": "c10-s08-p118-01140-s005",
      "sentenceText": "We want a sure gain rather than a hypothetical gain, even when the hypothetical gain could be larger than the sure gain.",
      "sentenceSha256": "f9bd6a9147c3488a9d216c647ffc2554694d769b3a90071ffe9c3eb3f18048b3",
      "readingUnitId": "c10-s08-p118-01140-r005-008",
      "parentQuestionId": "q-c10-096",
      "parentFingerprint": "c095e0f869c85ecac5aef85d9260995460cca46b0578dd6a3b2d7ae46553f5ff",
      "passageSha256": "78e7def2d87258d339101d1b32e2235b8500b2362d0e487c752a25d06f0de6c6",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c10-0165",
      "sentenceId": "c10-s08-p118-01140-s008",
      "sentenceText": "Loss aversion makes us conservative in many decision-making situations.",
      "sentenceSha256": "8715021a8517d37898b4f1d41325c56427e5354d9a278aa910f63d610df18cfa",
      "readingUnitId": "c10-s08-p118-01140-r005-008",
      "parentQuestionId": "q-c10-096",
      "parentFingerprint": "c095e0f869c85ecac5aef85d9260995460cca46b0578dd6a3b2d7ae46553f5ff",
      "passageSha256": "78e7def2d87258d339101d1b32e2235b8500b2362d0e487c752a25d06f0de6c6",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c10-0166",
      "sentenceId": "c10-s08-p118-01140-s009",
      "sentenceText": "But if we always chose a sure bet, we would never venture outside of our comfort zone.",
      "sentenceSha256": "d2e9ce2844db803e12ab0382f88938e0868e8de016a0b59ad66ca3bc94ad5342",
      "readingUnitId": "c10-s08-p118-01140-r009-010",
      "parentQuestionId": "q-c10-097",
      "parentFingerprint": "03321c97687dc4056d247b5d92009be5e8489d7c4ddb464259cf0323eb4c8733",
      "passageSha256": "9bc78d4d070ad714c4aa9ca918dd1817a82d07ca4e1352f685aa57aac1e5f1f6",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c10-0167",
      "sentenceId": "c10-s08-p118-03675-s001",
      "sentenceText": "There is endless empirical and real-life evidence for the mere exposure effect and the power of familiarity or certainty, which seems to spell doom for psychological richness.",
      "sentenceSha256": "e8b26fe5a1a17abbfa29b146525a770d9819a17e4f15fae044b2489ad0af3003",
      "readingUnitId": "c10-s08-p118-03675-r001-004",
      "parentQuestionId": "q-c10-098",
      "parentFingerprint": "0325e6810d7b3aac8aa5b1a8f37166b5595450a6070b163d3e502f54b4ff2cd3",
      "passageSha256": "0d39ccb9fcc5a614b5e6f9ff431de28ebf7b6a3744359eaba01926433b06f020",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c10-0168",
      "sentenceId": "c10-s08-p118-03675-s002",
      "sentenceText": "At the same time, there is an interesting twist here.",
      "sentenceSha256": "257134e64c4aea4a0bea6415ca0d8165c9d626dbb9d1c01c33898842a9c754f1",
      "readingUnitId": "c10-s08-p118-03675-r001-004",
      "parentQuestionId": "q-c10-098",
      "parentFingerprint": "0325e6810d7b3aac8aa5b1a8f37166b5595450a6070b163d3e502f54b4ff2cd3",
      "passageSha256": "0d39ccb9fcc5a614b5e6f9ff431de28ebf7b6a3744359eaba01926433b06f020",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c10-0169",
      "sentenceId": "c10-s08-p118-03675-s004",
      "sentenceText": "We tend to think it won’t be fun to talk to a stranger.",
      "sentenceSha256": "4a5514795995323f692ca3cdedea4c477e486def77428d5c002e8081c0a96437",
      "readingUnitId": "c10-s08-p118-03675-r001-004",
      "parentQuestionId": "q-c10-098",
      "parentFingerprint": "0325e6810d7b3aac8aa5b1a8f37166b5595450a6070b163d3e502f54b4ff2cd3",
      "passageSha256": "0d39ccb9fcc5a614b5e6f9ff431de28ebf7b6a3744359eaba01926433b06f020",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c10-0170",
      "sentenceId": "c10-s08-p118-03675-s005",
      "sentenceText": "But when we actually interact with a stranger, we tend to enjoy it far more than we think.",
      "sentenceSha256": "fba06445a247fd64db0287a47d80cef85636ddaa57956ac8f64c421539e1dc88",
      "readingUnitId": "c10-s08-p118-03675-r005-008",
      "parentQuestionId": "q-c10-099",
      "parentFingerprint": "68ec134fad1452df73c5249b04392bb29edbfb4d5a3602c79f4eb3886c1d5b65",
      "passageSha256": "80d72d200c8f151f00ace60863b45e170f296820f74efeaadc26a2a4acf2a342",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c10-0171",
      "sentenceId": "c10-s08-p118-03675-s007",
      "sentenceText": "Social psychologists Nick Epley and Juliana Schroeder tested how much people enjoy talking to strangers in a clever field experiment on a commuter train.",
      "sentenceSha256": "a670fc0c50b1b431d28494b8624be97d696a64d70e585a6cf58f098608f99b60",
      "readingUnitId": "c10-s08-p118-03675-r005-008",
      "parentQuestionId": "q-c10-099",
      "parentFingerprint": "68ec134fad1452df73c5249b04392bb29edbfb4d5a3602c79f4eb3886c1d5b65",
      "passageSha256": "80d72d200c8f151f00ace60863b45e170f296820f74efeaadc26a2a4acf2a342",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c10-0172",
      "sentenceId": "c10-s08-p118-03675-s008",
      "sentenceText": "Their research assistants approached 118 commuters at the Homewood Metra station, one of the first stations on the express line to the Millennium Station in downtown Chicago.",
      "sentenceSha256": "540175bbc8cf736f7ddd1ff4b5fe46565db020535aa897ae06d8e6c9f5dc195a",
      "readingUnitId": "c10-s08-p118-03675-r005-008",
      "parentQuestionId": "q-c10-099",
      "parentFingerprint": "68ec134fad1452df73c5249b04392bb29edbfb4d5a3602c79f4eb3886c1d5b65",
      "passageSha256": "80d72d200c8f151f00ace60863b45e170f296820f74efeaadc26a2a4acf2a342",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c10-0173",
      "sentenceId": "c10-s08-p118-03675-s009",
      "sentenceText": "One third of the commuters were told to “have a conversation with a new person on the train today, try to make a connection, find out something interesting about the person.”",
      "sentenceSha256": "23f545008cf9b6a0fb9673cfd7555d0aabcdafb28e78b9773d94bcab5fb27cdd",
      "readingUnitId": "c10-s08-p118-03675-r009-011",
      "parentQuestionId": "q-c10-100",
      "parentFingerprint": "3d549dde1964e9e43274c64ceb937754a21340edc1f837e5ace4d53854f07bde",
      "passageSha256": "9f5d7501a38de06ab27157c3be88aa84bfbc13d45b3f324e9c743daa8c7f0eff",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c10-0174",
      "sentenceId": "c10-s08-p118-03675-s010",
      "sentenceText": "One third were told to “keep to yourself and enjoy your solitude on the train today.”",
      "sentenceSha256": "44c839e4757952f2208fa29741a37da74eaaf787bc6550ca28e2dd84361e615f",
      "readingUnitId": "c10-s08-p118-03675-r009-011",
      "parentQuestionId": "q-c10-100",
      "parentFingerprint": "3d549dde1964e9e43274c64ceb937754a21340edc1f837e5ace4d53854f07bde",
      "passageSha256": "9f5d7501a38de06ab27157c3be88aa84bfbc13d45b3f324e9c743daa8c7f0eff",
      "pdfPages": [
        118
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c10-0175",
      "sentenceId": "c10-s08-p118-03675-s012",
      "sentenceText": "They were all given an envelope with a survey and told to complete the survey at the end of their train ride and mail it back with the return envelope with a stamp.",
      "sentenceSha256": "9d57cafbf75749865d89e0ca0b2f554799821acb29a46bf8f5ec65cb4a7b1221",
      "readingUnitId": "c10-s08-p118-03675-r012-014",
      "parentQuestionId": "q-c10-101",
      "parentFingerprint": "551eb03669a90407106c6fd6551323906144a20c14937bcf51ac35b5245837c8",
      "passageSha256": "3fddeebb8637a1dac82066e2819f633ec5c810341ea9456b623454133bf2fc46",
      "pdfPages": [
        118,
        119
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c10-0176",
      "sentenceId": "c10-s08-p118-03675-s013",
      "sentenceText": "Out of 118 commuters, 97 returned the survey.",
      "sentenceSha256": "ba0b8d2be89e9b17005ba2a32582782c5834a917effabd377d7ce602b31d7c21",
      "readingUnitId": "c10-s08-p118-03675-r012-014",
      "parentQuestionId": "q-c10-101",
      "parentFingerprint": "551eb03669a90407106c6fd6551323906144a20c14937bcf51ac35b5245837c8",
      "passageSha256": "3fddeebb8637a1dac82066e2819f633ec5c810341ea9456b623454133bf2fc46",
      "pdfPages": [
        118,
        119
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c10-0177",
      "sentenceId": "c10-s08-p119-01335-s001",
      "sentenceText": "Interestingly, Epley and Schroeder recruited another 105 commuters from the Homewood Metra station and asked them simply to imagine how they would feel if they were in the talk-to-a-stranger condition, the solitude condition, and the control condition.",
      "sentenceSha256": "42fb076fa1841118e32fb93708574c1ef1a4df60a7ea9d64cc05918fc67bee88",
      "readingUnitId": "c10-s08-p119-01335-r001-002",
      "parentQuestionId": "q-c10-102",
      "parentFingerprint": "f16d76cfb5e8241812dc6bc4dcf957cfcc89bc0efea573b6b1536133143c0339",
      "passageSha256": "6cffa64203624bc4cc8b36333c666bb4916b4b9e98ac49d5693c81b83408f882",
      "pdfPages": [
        119
      ]
    }
  ]
}
