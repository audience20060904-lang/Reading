      "pdfPages": [
        156
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c13-0127",
      "sentenceId": "c13-s06-p156-03795-s003",
      "sentenceText": "They had three members composing songs, John, Paul, and George, giving them more variety than the Beach Boys, with Brian Wilson as a solo composer.",
      "sentenceSha256": "bd236fd41e5aa7148d3ed26b0ba8cb0fbf415cf5b6a58e8861d3a11c5b5c7683",
      "readingUnitId": "c13-s06-p156-03795-r003-005",
      "parentQuestionId": "q-c13-083",
      "parentFingerprint": "1d87678c96c873cd48ff1ad1751319b563a31c00884fbd892e2ccf6d61cb7fc7",
