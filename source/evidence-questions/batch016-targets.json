    },
    {
      "order": 2,
      "questionId": "qe-c05-0062",
      "sentenceId": "c05-s04-p048-06525-s019",
      "sentenceText": "He then asked, “Who’s your favorite musician?”",
      "sentenceSha256": "25c0a086be6a08978c79761bf8cb072b548087e9d1b771b4df704051fbff9bc2",
      "readingUnitId": "c05-s04-p048-06525-r017-020",
