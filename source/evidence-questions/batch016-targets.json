    },
    {
      "order": 3,
      "questionId": "qe-c05-0063",
      "sentenceId": "c05-s04-p048-06525-s021",
      "sentenceText": "After a long pause, I said, “Bill Evans.”",
      "sentenceSha256": "0870160cf7db5b5ce0b7726b82a6a553a8564ca6b01cc9de4028c63d599b50f1",
      "readingUnitId": "c05-s04-p048-06525-r021-024",
      "parentQuestionId": "q-c05-037",
      "parentFingerprint": "76e05fa4f49f5b40b51ff975d1d1d4a4838b85740e633816b7580e36b469d23f",
      "passageSha256": "3bfa7531ed6c3e095c5f8a3236aa6111807bfdc4ec9895b4a6f87f947ad912b5",
      "pdfPages": [
        49
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c05-0064",
      "sentenceId": "c05-s04-p048-06525-s022",
      "sentenceText": "Dean Reese immediately said, “Get out of here!”",
      "sentenceSha256": "3f3e96392bc0cbd3d26d32cb2f84aa2a23f3b33c951b6f3348e8c486e52278b8",
      "readingUnitId": "c05-s04-p048-06525-r021-024",
      "parentQuestionId": "q-c05-037",
      "parentFingerprint": "76e05fa4f49f5b40b51ff975d1d1d4a4838b85740e633816b7580e36b469d23f",
      "passageSha256": "3bfa7531ed6c3e095c5f8a3236aa6111807bfdc4ec9895b4a6f87f947ad912b5",
      "pdfPages": [
        49
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c05-0065",
      "sentenceId": "c05-s04-p048-06525-s023",
      "sentenceText": "I was scared.",
      "sentenceSha256": "a99048b52c0fbdc9cf86e17ce428612256ee643f104d59d03c74f72c62190651",
      "readingUnitId": "c05-s04-p048-06525-r021-024",
      "parentQuestionId": "q-c05-037",
      "parentFingerprint": "76e05fa4f49f5b40b51ff975d1d1d4a4838b85740e633816b7580e36b469d23f",
      "passageSha256": "3bfa7531ed6c3e095c5f8a3236aa6111807bfdc4ec9895b4a6f87f947ad912b5",
      "pdfPages": [
        49
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c05-0066",
      "sentenceId": "c05-s04-p049-04260-s003",
      "sentenceText": "For instance, I shared my dorm room with a student named Mike.",
      "sentenceSha256": "03a6aa583331c4b4f89fdffdb9520aac94f2081a234142254456b4da5712563f",
      "readingUnitId": "c05-s04-p049-04260-r001-004",
      "parentQuestionId": "q-c05-039",
      "parentFingerprint": "fc9ebdc068e478897d5ddf17f09bb1e9fdb2fba24627f6e27eb8880cb5ce31b2",
      "passageSha256": "3228186cc0201d73824d1db1e2f9e70429bcdbf3530024e3f7078327f73e264a",
      "pdfPages": [
        49
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c05-0067",
      "sentenceId": "c05-s04-p049-04260-s004",
      "sentenceText": "I’d often pick up the phone and hear, “Is Mike there?”",
      "sentenceSha256": "84ae969ca6338884899ae57192d3d8f50082374df365ab312030b01f20e331a5",
      "readingUnitId": "c05-s04-p049-04260-r001-004",
      "parentQuestionId": "q-c05-039",
      "parentFingerprint": "fc9ebdc068e478897d5ddf17f09bb1e9fdb2fba24627f6e27eb8880cb5ce31b2",
      "passageSha256": "3228186cc0201d73824d1db1e2f9e70429bcdbf3530024e3f7078327f73e264a",
      "pdfPages": [
        49
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c05-0068",
      "sentenceId": "c05-s04-p049-04260-s005",
      "sentenceText": "and I’d say, “No.”",
      "sentenceSha256": "b102902f34898b295141906ee87f16f0946e33659fb36ced28b3bf5a1f375ab4",
      "readingUnitId": "c05-s04-p049-04260-r001-004",
      "parentQuestionId": "q-c05-039",
      "parentFingerprint": "fc9ebdc068e478897d5ddf17f09bb1e9fdb2fba24627f6e27eb8880cb5ce31b2",
      "passageSha256": "3228186cc0201d73824d1db1e2f9e70429bcdbf3530024e3f7078327f73e264a",
      "pdfPages": [
        49
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c05-0069",
      "sentenceId": "c05-s04-p049-04260-s006",
      "sentenceText": "Then the voice on the other end usually said, “Could you tell him so-and-so called?”",
      "sentenceSha256": "b0e9b2a2963d92a9c3cbe2b353f832977e7b7269c7ae3da7689017600f5253fe",
      "readingUnitId": "c05-s04-p049-04260-r005-008",
      "parentQuestionId": "q-c05-040",
      "parentFingerprint": "34ac6009319a56532f46adaa748f870af904254adcf7e9d700ddbcfb33feec94",
      "passageSha256": "6ba86af6ee3749769eea10e28e78dcbefd38b68c0399b5214edf3e1b90d6a8f4",
      "pdfPages": [
        49
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c05-0070",
      "sentenceId": "c05-s04-p049-04260-s008",
      "sentenceText": "so I could write it down.",
      "sentenceSha256": "04873b4470581f30b97d93cbe81eee96383c2818e167236ca720e39da770c19f",
      "readingUnitId": "c05-s04-p049-04260-r005-008",
      "parentQuestionId": "q-c05-040",
      "parentFingerprint": "34ac6009319a56532f46adaa748f870af904254adcf7e9d700ddbcfb33feec94",
