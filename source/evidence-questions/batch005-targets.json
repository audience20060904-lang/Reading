      ]
    },
    {
      "order": 2,
      "questionId": "qe-c02-0043",
      "sentenceId": "c02-s03-p020-06720-s005",
      "sentenceText": "These findings have been replicated.",
      "sentenceSha256": "28e1e4640cfae69c91eba7c494cf5c5f6ae56614f51eb1995a03c24d20a1ae48",
      "readingUnitId": "c02-s03-p020-06720-r005-006",
      "parentQuestionId": "q-c02-049",
      "parentFingerprint": "6d9eab394e5894489fbde04464631980d2af6b8e0cdb8af4222e27c8a6cc8b0f",
      "passageSha256": "bff1e3add0abce985fa246e33e9b20472819f824d17af4db929a2af722d161fd",
      "pdfPages": [
        21
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c02-0044",
      "sentenceId": "c02-s03-p021-01725-s003",
      "sentenceText": "In one experiment, participants were asked to solve anagrams with or without the pressure to be happy.",
      "sentenceSha256": "f03d9bbe139c6a022afa6546a3cfb411a43ec92ce6089a63ac3c84a5ff703d92",
      "readingUnitId": "c02-s03-p021-01725-r001-003",
      "parentQuestionId": "q-c02-050",
      "parentFingerprint": "7064957b009c494d254b1b4b1ee4fe488e258965266f986f25297944df77cb05",
      "passageSha256": "3cee7ac9c53b1162e6809ae81596fc868af9145eeac0bc9bd10ef437bb4015f8",
      "pdfPages": [
        21
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c02-0045",
      "sentenceId": "c02-s03-p021-03480-s004",
      "sentenceText": "In short, many Americans are stuck in a happiness trap.",
      "sentenceSha256": "0ce87ce2afbe0fd40a9bdfc1860c6772dc8c24e856264eaa6d676e5b84d55e11",
      "readingUnitId": "c02-s03-p021-03480-r003-004",
      "parentQuestionId": "q-c02-053",
      "parentFingerprint": "2313f62fc477b32c9f4659c92d462a36724b983f8665180b5d568676e22f8aae",
      "passageSha256": "1e6d7966f1b74e2e1cae6a2f5a2271f7456d23787d3552129a5d99084e82904c",
      "pdfPages": [
        21
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c02-0046",
      "sentenceId": "c02-s04-p021-06330-s001",
      "sentenceText": "For example, take an experience I had multiple times when I lived in New York City.",
      "sentenceSha256": "ee0c472761201347991534e6eb4c239d2f3ad7e3d8893328dd5bdff85357f895",
      "readingUnitId": "c02-s04-p021-06330-r001-004",
      "parentQuestionId": "q-c02-056",
      "parentFingerprint": "144426b0854ffc169483d67c1336320604619703c4e3962c8fc70bb606e6c07f",
      "passageSha256": "776388cf0a76977a8d4f2e9ce19d333201d09f100a16c9202b7ba5c680a87fdf",
      "pdfPages": [
        21
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c02-0047",
      "sentenceId": "c02-s04-p021-06330-s002",
      "sentenceText": "I lived in a building without a door attendant.",
      "sentenceSha256": "a43cf9653fb300d6939f8fb5269933053123cc5ab891f3502e3ec7c3159248b9",
      "readingUnitId": "c02-s04-p021-06330-r001-004",
      "parentQuestionId": "q-c02-056",
      "parentFingerprint": "144426b0854ffc169483d67c1336320604619703c4e3962c8fc70bb606e6c07f",
      "passageSha256": "776388cf0a76977a8d4f2e9ce19d333201d09f100a16c9202b7ba5c680a87fdf",
      "pdfPages": [
        21
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c02-0048",
      "sentenceId": "c02-s04-p021-06330-s009",
      "sentenceText": "I felt insulted.",
      "sentenceSha256": "27384459d0fa0c03e95f620ad6b7c09093336e2627f3b9acadf35aea0ad1a24b",
      "readingUnitId": "c02-s04-p021-06330-r008-010",
      "parentQuestionId": "q-c02-057",
      "parentFingerprint": "cae2361f35868e9629b05a57284ae564135d33e299115380e4310fbe59c6039c",
      "passageSha256": "26d1658a20aadb24ea1fd1643604e95fda9df7bcdd5b7d902557aa388bda188a",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c02-0049",
      "sentenceId": "c02-s04-p021-06330-s010",
      "sentenceText": "But stuff happens, right?",
      "sentenceSha256": "2b68a9f9c45ff07bddb7c643923792d219750f80ba204f14e63180a19b659d59",
      "readingUnitId": "c02-s04-p021-06330-r008-010",
      "parentQuestionId": "q-c02-057",
      "parentFingerprint": "cae2361f35868e9629b05a57284ae564135d33e299115380e4310fbe59c6039c",
      "passageSha256": "26d1658a20aadb24ea1fd1643604e95fda9df7bcdd5b7d902557aa388bda188a",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c02-0050",
      "sentenceId": "c02-s04-p022-01530-s001",
      "sentenceText": "Speaking of graduate school, when I was a fifth-year PhD student, my advisor told me the following story.",
      "sentenceSha256": "10f9823fe23f23387624b5656235ff5868916b8809a13387f70cd8c5ec863880",
      "readingUnitId": "c02-s04-p022-01530-r001-004",
      "parentQuestionId": "q-c02-058",
      "parentFingerprint": "b6cc7470b5320a019bf8943114e7d9dc365b3f77df40c827248d838763a96c53",
      "passageSha256": "d94c41fcf4ba2124d035f488e888cef35c3f5ac04a6ef39d28fb2c79d5ab7d58",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c02-0051",
      "sentenceId": "c02-s04-p022-01530-s002",
      "sentenceText": "Daniel Kahneman, a famous psychologist at Princeton, called my advisor, Ed Diener, up and asked him about me.",
      "sentenceSha256": "c1cbd282798a94dca8664a778292494201b04fe567a1d07da171eb7d2bf6bc86",
      "readingUnitId": "c02-s04-p022-01530-r001-004",
      "parentQuestionId": "q-c02-058",
      "parentFingerprint": "b6cc7470b5320a019bf8943114e7d9dc365b3f77df40c827248d838763a96c53",
      "passageSha256": "d94c41fcf4ba2124d035f488e888cef35c3f5ac04a6ef39d28fb2c79d5ab7d58",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c02-0052",
      "sentenceId": "c02-s04-p022-01530-s004",
      "sentenceText": "After they talked for a while, Kahneman asked my advisor, “Is Shige cocky?”",
      "sentenceSha256": "608f9b5a39eae8b994f1a1624fb250f6458193fd2050abc73629c76d20275e85",
      "readingUnitId": "c02-s04-p022-01530-r001-004",
      "parentQuestionId": "q-c02-058",
      "parentFingerprint": "b6cc7470b5320a019bf8943114e7d9dc365b3f77df40c827248d838763a96c53",
      "passageSha256": "d94c41fcf4ba2124d035f488e888cef35c3f5ac04a6ef39d28fb2c79d5ab7d58",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c02-0053",
      "sentenceId": "c02-s04-p022-01530-s005",
      "sentenceText": "My advisor said, “No, he’s not.”",
      "sentenceSha256": "5d822153469cc3d091c31c1ec0ef1c5e89aa14266a8412faa06e26c9bfe85972",
      "readingUnitId": "c02-s04-p022-01530-r005-008",
      "parentQuestionId": "q-c02-059",
      "parentFingerprint": "176763b6027e6e61ace2f942cc963592d826773742a33a7f5746a78ebd5b6877",
      "passageSha256": "1f302c299c7a6ee374a1649cb63f47ee7a3c24a909f459f8a813208fb73f3dbf",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c02-0054",
      "sentenceId": "c02-s04-p022-01530-s006",
      "sentenceText": "Kahneman said, “Well, in order to survive at Princeton, you have to be cocky.”",
      "sentenceSha256": "fa260266c8c5b8ef5eed9bd03d7f8ef31052bc2e112c213dc75691ea501b118a",
      "readingUnitId": "c02-s04-p022-01530-r005-008",
      "parentQuestionId": "q-c02-059",
      "parentFingerprint": "176763b6027e6e61ace2f942cc963592d826773742a33a7f5746a78ebd5b6877",
      "passageSha256": "1f302c299c7a6ee374a1649cb63f47ee7a3c24a909f459f8a813208fb73f3dbf",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c02-0055",
      "sentenceId": "c02-s04-p022-01530-s007",
      "sentenceText": "Then my advisor did what a good advisor does, I suppose.",
      "sentenceSha256": "14283ce27f92dedad08e40df29502c856f1b80b410110cc78c47f8f9e2e80c7d",
      "readingUnitId": "c02-s04-p022-01530-r005-008",
      "parentQuestionId": "q-c02-059",
      "parentFingerprint": "176763b6027e6e61ace2f942cc963592d826773742a33a7f5746a78ebd5b6877",
      "passageSha256": "1f302c299c7a6ee374a1649cb63f47ee7a3c24a909f459f8a813208fb73f3dbf",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c02-0056",
      "sentenceId": "c02-s04-p022-03480-s001",
      "sentenceText": "When events such as these happen, you will feel bad.",
      "sentenceSha256": "75a76df3c4b40befc6d093a764c1d3cda6a2be0031033dca5eab6c1f34ec7263",
      "readingUnitId": "c02-s04-p022-03480-r001-002",
      "parentQuestionId": "q-c02-061",
      "parentFingerprint": "1cea190f0ee30112387bebdd34c1c35d328515eb4e1f7de8fdb986b30964fda6",
      "passageSha256": "7bce679b767800292efee22294e2fcf3c4c4f188cee21d8e2cc426702edfde0c",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c02-0057",
      "sentenceId": "c02-s04-p022-03870-s001",
      "sentenceText": "People who feel pressure to feel happy will try almost anything to repair their moods.",
      "sentenceSha256": "ffdc8d443b4d002c956a34bc1d9c4df7f07b031c5551966c10ade913b6c4fb01",
      "readingUnitId": "c02-s04-p022-03870-r001-002",
      "parentQuestionId": "q-c02-062",
      "parentFingerprint": "51e7188ac7bde98bfed80ed87c99f2480dcecbb307f60b0b8588ec001693b263",
      "passageSha256": "0f749e5bf13160c55bff9e3490e4e46604b12c2bc046558add09a31e39c694cb",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c02-0058",
      "sentenceId": "c02-s04-p022-03870-s004",
      "sentenceText": "Personally, when I feel down, I listen to my favorite songs.",
      "sentenceSha256": "996854d9d3866a477bb413ef57b5e18a3c9399925297287597b2543533e23441",
      "readingUnitId": "c02-s04-p022-03870-r004-007",
      "parentQuestionId": "q-c02-063",
      "parentFingerprint": "845ca518a8c0028bb89989ba85ba6e7f6a85dc469cf61e000db3eadd63fe8ce6",
      "passageSha256": "9add99aa9744999f6487fb8951e53b52dcd09bef54996993d5ff74975c77410a",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c02-0059",
      "sentenceId": "c02-s04-p022-03870-s005",
      "sentenceText": "Sometimes I even sing along.",
      "sentenceSha256": "cce80d162a1f7817377b7439b97b10a4f2be2008643de470ff833022882229fe",
      "readingUnitId": "c02-s04-p022-03870-r004-007",
      "parentQuestionId": "q-c02-063",
      "parentFingerprint": "845ca518a8c0028bb89989ba85ba6e7f6a85dc469cf61e000db3eadd63fe8ce6",
      "passageSha256": "9add99aa9744999f6487fb8951e53b52dcd09bef54996993d5ff74975c77410a",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c02-0060",
      "sentenceId": "c02-s04-p022-03870-s006",
      "sentenceText": "Other times, I talk to my wife.",
      "sentenceSha256": "a03344a0b92b1a6ec8a2a3315099838509c3503f9a70c0479fd441b32f45216c",
      "readingUnitId": "c02-s04-p022-03870-r004-007",
      "parentQuestionId": "q-c02-063",
      "parentFingerprint": "845ca518a8c0028bb89989ba85ba6e7f6a85dc469cf61e000db3eadd63fe8ce6",
      "passageSha256": "9add99aa9744999f6487fb8951e53b52dcd09bef54996993d5ff74975c77410a",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c02-0061",
      "sentenceId": "c02-s04-p022-05430-s004",
      "sentenceText": "A divorced father of two young children might reinterpret the divorce as a God-sent opportunity to spend more time on his hobbies while his ex-wife has custody of the children.",
      "sentenceSha256": "564fd9f5a116079e9e1e4489cc522788fe119fa14f78fd24314626d8236829d1",
      "readingUnitId": "c02-s04-p022-05430-r003-006",
      "parentQuestionId": "q-c02-019",
      "parentFingerprint": "a092295400d075b5283899749c804fada43f713782f0dcbbf2dd987458f4bf9d",
      "passageSha256": "ed9fa811c132ec90b1359b795fd7888aab74e7d1c7356ab820c2c1458beda428",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c02-0062",
      "sentenceId": "c02-s04-p022-05430-s005",
      "sentenceText": "Other people might try to distance themselves from the divorce and start seeing the same event from the other person’s perspective, which could dampen their negative reaction to the trigger event.",
      "sentenceSha256": "124efc4914b74acbbc54ab495d5814901f59f2e168fdcdd1d9335925d09310dd",
      "readingUnitId": "c02-s04-p022-05430-r003-006",
      "parentQuestionId": "q-c02-019",
      "parentFingerprint": "a092295400d075b5283899749c804fada43f713782f0dcbbf2dd987458f4bf9d",
      "passageSha256": "ed9fa811c132ec90b1359b795fd7888aab74e7d1c7356ab820c2c1458beda428",
      "pdfPages": [
        22
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c02-0063",
      "sentenceId": "c02-s04-p022-05430-s007",
      "sentenceText": "Five years later, will I be suffering in the same way?",
      "sentenceSha256": "3167d2c5def671d4cf6f5a801b2aede732594f48b95175164ea4797ebec5b507",
      "readingUnitId": "c02-s04-p022-05430-r007-008",
      "parentQuestionId": "q-c02-065",
      "parentFingerprint": "d191b8e2fec2c937d556f985c0af520bda06ea9110a0dee7c8675e0453adcd6e",
      "passageSha256": "7f134a73bd69a7ad6bd45cd87f9db38b4dfaf2a5ac71f3bb8462f1b20fb295e2",
      "pdfPages": [
        22,
        23
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c02-0064",
      "sentenceId": "c02-s04-p023-01140-s003",
      "sentenceText": "These people believe that time heals everything.",
      "sentenceSha256": "94a17e77890f7a1e7987293e540525d54e1a1f87d185a6a6830feec5f00d7803",
      "readingUnitId": "c02-s04-p023-01140-r001-004",
      "parentQuestionId": "q-c02-066",
      "parentFingerprint": "b984d3766c0850e1c3ee8fa51bea3419e3a43973fc4679c7dc21d2bcd0dedaf8",
      "passageSha256": "359d702f5ad1cb4e1c9bd03dcce2d035637f078adcd917809e6a36d247735f40",
      "pdfPages": [
        23
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c02-0065",
      "sentenceId": "c02-s04-p023-01140-s004",
      "sentenceText": "And they are right.",
      "sentenceSha256": "434063f668bc1e6ae5794ea2000950faedaaf7d4ad779b7b58c8416656f9f1e5",
      "readingUnitId": "c02-s04-p023-01140-r001-004",
      "parentQuestionId": "q-c02-066",
      "parentFingerprint": "b984d3766c0850e1c3ee8fa51bea3419e3a43973fc4679c7dc21d2bcd0dedaf8",
      "passageSha256": "359d702f5ad1cb4e1c9bd03dcce2d035637f078adcd917809e6a36d247735f40",
      "pdfPages": [
        23
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c02-0066",
      "sentenceId": "c02-s04-p023-01140-s006",
      "sentenceText": "This is what Dan Gilbert, Tim Wilson, and their colleagues call the “psychological immune system.”",
      "sentenceSha256": "e68fb0be1a4ad70a85e3b2599a797224c36c51c44e5fa998574b8389118b6855",
      "readingUnitId": "c02-s04-p023-01140-r006-007",
