      "questionId": "qe-c14-0009",
      "sentenceId": "c14-s01-p160-06562-s006",
      "sentenceText": "At the end of your first job?",
      "sentenceSha256": "dc8705968b589cc6feb7f84bb4b8d4895353091afa826ef08c39462edf66bdbe",
      "readingUnitId": "c14-s01-p160-06562-r005-008",
