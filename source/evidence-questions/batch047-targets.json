    },
    {
      "order": 2,
      "questionId": "qe-c10-0204",
      "sentenceId": "c10-s09-p120-04065-s007",
      "sentenceText": "I entered an elevator and looked at the others already in it.",
      "sentenceSha256": "9bf3f42ac4f8aeb7e241408089daae4f55d850c80656a8202235f1180907b888",
      "readingUnitId": "c10-s09-p120-04065-r005-008",
      "parentQuestionId": "q-c10-112",
      "parentFingerprint": "e984a284d7992b26dcf5d5f4f71c5f25abd8057fb4d077ccb31b4322a7942853",
      "passageSha256": "00ba794578c2f36f8b08826f3b7c6a6c29a0a9ce22f15fc3b1b83f20f275e6bf",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c10-0205",
      "sentenceId": "c10-s09-p120-04065-s009",
      "sentenceText": "Why would they be scared of me?",
      "sentenceSha256": "f8ba30dff3a6fda6fe2ac899d5161352af5ba3da889416b369bb319dd9e0c906",
      "readingUnitId": "c10-s09-p120-04065-r009-012",
      "parentQuestionId": "q-c10-113",
      "parentFingerprint": "31b55ad1d5cb8e0bb4b6f6139b25f3d0dd418f29dfbfc6243557b007ede2de57",
      "passageSha256": "1b0dda92108905406f60cabdcfc3edd0e09b74874ee5f3992304ebe1679058ed",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c10-0206",
      "sentenceId": "c10-s09-p120-04065-s010",
      "sentenceText": "I am a friendly Japanese person!",
      "sentenceSha256": "902ead301ebfcef370df027ec6d753a0a38e7ef20843aaf16c9ec795ad806608",
      "readingUnitId": "c10-s09-p120-04065-r009-012",
      "parentQuestionId": "q-c10-113",
      "parentFingerprint": "31b55ad1d5cb8e0bb4b6f6139b25f3d0dd418f29dfbfc6243557b007ede2de57",
      "passageSha256": "1b0dda92108905406f60cabdcfc3edd0e09b74874ee5f3992304ebe1679058ed",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c10-0207",
      "sentenceId": "c10-s09-p120-04065-s012",
      "sentenceText": "Here is what you are supposed to do in Japan: You enter an elevator.",
      "sentenceSha256": "8104ba33e737395e0b50d76c4fa5e8e6b4872ae560433b0f5c182f8bf5cb2d10",
      "readingUnitId": "c10-s09-p120-04065-r009-012",
      "parentQuestionId": "q-c10-113",
      "parentFingerprint": "31b55ad1d5cb8e0bb4b6f6139b25f3d0dd418f29dfbfc6243557b007ede2de57",
      "passageSha256": "1b0dda92108905406f60cabdcfc3edd0e09b74874ee5f3992304ebe1679058ed",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c10-0208",
      "sentenceId": "c10-s09-p120-04065-s013",
      "sentenceText": "Never look at anyone directly.",
      "sentenceSha256": "09371028c860d3701c5c46f6cb731fd242e2a1de9b51caad87cea9d621d57563",
      "readingUnitId": "c10-s09-p120-04065-r013-016",
      "parentQuestionId": "q-c10-114",
      "parentFingerprint": "4ffd6699de14379ae408b4cb7f244b720ac7437aa8bf973034dbc99b5fe86ff0",
      "passageSha256": "41785c46c04220bcf854a4605fb103d747d3e695f9837e8a9f14e20d3e50532c",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c10-0209",
      "sentenceId": "c10-s09-p120-04065-s014",
      "sentenceText": "No eye contact.",
      "sentenceSha256": "43ca5bec2819c5dbb8e22056b65cecc9dd3b9722e5758b156a3a7493c283042c",
      "readingUnitId": "c10-s09-p120-04065-r013-016",
      "parentQuestionId": "q-c10-114",
      "parentFingerprint": "4ffd6699de14379ae408b4cb7f244b720ac7437aa8bf973034dbc99b5fe86ff0",
      "passageSha256": "41785c46c04220bcf854a4605fb103d747d3e695f9837e8a9f14e20d3e50532c",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c10-0210",
      "sentenceId": "c10-s09-p120-04065-s015",
      "sentenceText": "You look down and don’t bother anyone.",
      "sentenceSha256": "704ab94fbce6d6428768da1f2ff00bfd433033b82d71503b100cdfbd0550251d",
      "readingUnitId": "c10-s09-p120-04065-r013-016",
      "parentQuestionId": "q-c10-114",
      "parentFingerprint": "4ffd6699de14379ae408b4cb7f244b720ac7437aa8bf973034dbc99b5fe86ff0",
      "passageSha256": "41785c46c04220bcf854a4605fb103d747d3e695f9837e8a9f14e20d3e50532c",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c10-0211",
      "sentenceId": "c10-s09-p121-00750-s001",
      "sentenceText": "A recent review of studies also shows that the benefits of multicultural experiences go beyond creativity.",
      "sentenceSha256": "36d17ff405a5f43c3ded4b7603730c49320711a1285f9dacff6ca1e0df9c7b77",
      "readingUnitId": "c10-s09-p121-00750-r001-004",
      "parentQuestionId": "q-c10-115",
      "parentFingerprint": "2bff1326c0e19e9ec93f5e3d8e2e657ec168328f4ef7e5e1a524dd7cc6e1787b",
      "passageSha256": "653dca158596f0a6f4cd5702ba7b267cd30ef71f02e233c4e2173bc6a55f8f76",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c10-0212",
      "sentenceId": "c10-s09-p121-00750-s004",
      "sentenceText": "Those who have explored the world tend to hold fewer negative stereotypes and prejudices, and they discriminate against outgroup members less than those who have not.",
      "sentenceSha256": "e5e77d77812c58ad2e06458fe50601d51fe8a304ab1989627a938dbe18949965",
      "readingUnitId": "c10-s09-p121-00750-r001-004",
      "parentQuestionId": "q-c10-115",
      "parentFingerprint": "2bff1326c0e19e9ec93f5e3d8e2e657ec168328f4ef7e5e1a524dd7cc6e1787b",
      "passageSha256": "653dca158596f0a6f4cd5702ba7b267cd30ef71f02e233c4e2173bc6a55f8f76",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c10-0213",
      "sentenceId": "c10-s09-p121-02310-s001",
      "sentenceText": "It should be noted that there are some undesirable outcomes correlated with multicultural experience as well.",
      "sentenceSha256": "93c48a7134d7f686042003490b3910039117e1b7e0cddc28b8b8ccc54dc2b66c",
      "readingUnitId": "c10-s09-p121-02310-r001-003",
      "parentQuestionId": "q-c10-116",
      "parentFingerprint": "6a0c0fa9de7a641bd516056fc0187a5367ba59da020c39b0a6c9f7878f31e369",
      "passageSha256": "d5031474888e412857ceaa0d927196f6da2a61214db2ba12ffaeb14870bb6602",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c10-0214",
      "sentenceId": "c10-s09-p121-02310-s003",
      "sentenceText": "Furthermore, when there was a chance to cheat on a performance task, those with more cross-cultural experiences cheated more than those with fewer cross-cultural experiences.",
      "sentenceSha256": "70c3868aa7c103b8db1ee1796a87f1d79727ec9b2a0252cf43178ab81efed570",
      "readingUnitId": "c10-s09-p121-02310-r001-003",
      "parentQuestionId": "q-c10-116",
      "parentFingerprint": "6a0c0fa9de7a641bd516056fc0187a5367ba59da020c39b0a6c9f7878f31e369",
      "passageSha256": "d5031474888e412857ceaa0d927196f6da2a61214db2ba12ffaeb14870bb6602",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c10-0215",
      "sentenceId": "c10-s09-p121-03675-s001",
      "sentenceText": "After all, Steve Jobs did lie to the audience about particular device functions in several product launches.",
      "sentenceSha256": "a936e72d1cc8a5466a987152c184a83776b65bfeb9f73df28f452ddee586dfe4",
      "readingUnitId": "c10-s09-p121-03675-r001-004",
      "parentQuestionId": "q-c10-117",
      "parentFingerprint": "951b513b2f51b38c4a7635ce55017f8a0b98de1ee0aee0e107f4e31ab61572c2",
      "passageSha256": "bf7ad28c9e6dd7f2f5827c874da04c50fd14a8617473ac583f08953c31f1f18c",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c10-0216",
      "sentenceId": "c10-s09-p121-03675-s002",
      "sentenceText": "He regularly parked his car in the handicapped section at Whole Foods.",
      "sentenceSha256": "de65965b5eb2e88129e89e89b552af0978fa1b7eecca41676c85b0889a330fea",
      "readingUnitId": "c10-s09-p121-03675-r001-004",
      "parentQuestionId": "q-c10-117",
      "parentFingerprint": "951b513b2f51b38c4a7635ce55017f8a0b98de1ee0aee0e107f4e31ab61572c2",
      "passageSha256": "bf7ad28c9e6dd7f2f5827c874da04c50fd14a8617473ac583f08953c31f1f18c",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c10-0217",
      "sentenceId": "c10-s09-p121-03675-s005",
      "sentenceText": "He helped design the Mac, iPod, iPad, and iPhone.",
      "sentenceSha256": "e3c5f162c5bc2a409300008ed1d2ed3a66d3df05c3259ab68e2cda5efe31544b",
      "readingUnitId": "c10-s09-p121-03675-r005-008",
      "parentQuestionId": "q-c10-118",
      "parentFingerprint": "c758f3dab9999745a768b3fcba2108bb6e335a1ec63a47fd7842a4bca67301c5",
      "passageSha256": "fab2929872b79e66cddff62164b043da99ad8774a40f0dd6409420f76ac38b07",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c10-0218",
      "sentenceId": "c10-s09-p121-03675-s007",
      "sentenceText": "That’s what I’ve always tried to do—keep moving.",
      "sentenceSha256": "2ed66bf4bcd3e7a7a792563bcfe897e44c8c77574f7d23262742b61c2dd1c1ce",
      "readingUnitId": "c10-s09-p121-03675-r005-008",
      "parentQuestionId": "q-c10-118",
      "parentFingerprint": "c758f3dab9999745a768b3fcba2108bb6e335a1ec63a47fd7842a4bca67301c5",
      "passageSha256": "fab2929872b79e66cddff62164b043da99ad8774a40f0dd6409420f76ac38b07",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c10-0219",
      "sentenceId": "c10-s09-p121-03675-s008",
      "sentenceText": "Otherwise, as Dylan says, if you’re not busy being born, you’re busy dying.”",
      "sentenceSha256": "6e7df02cda062d3720e693e224a73bad8cf33dc1bb4ac0968b83c6a61d8f1421",
      "readingUnitId": "c10-s09-p121-03675-r005-008",
      "parentQuestionId": "q-c10-118",
      "parentFingerprint": "c758f3dab9999745a768b3fcba2108bb6e335a1ec63a47fd7842a4bca67301c5",
      "passageSha256": "fab2929872b79e66cddff62164b043da99ad8774a40f0dd6409420f76ac38b07",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c10-0220",
      "sentenceId": "c10-s09-p121-03675-s009",
      "sentenceText": "So keep moving.",
      "sentenceSha256": "07113a8ffc054f0c3d1686654ea03975d79aa6ec8249b09b2c5ec3d46fbab09e",
      "readingUnitId": "c10-s09-p121-03675-r009-011",
      "parentQuestionId": "q-c10-119",
      "parentFingerprint": "ec46309c6766e89367780600392c41c314c06fc03e9a9be83083df778b877f6c",
      "passageSha256": "2e65360fd9558f8306b0817e82320f33a7fa97bbab51328be9f1cc31aa0ba9e1",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c10-0221",
      "sentenceId": "c10-s09-p121-03675-s010",
      "sentenceText": "Keep exploring, despite the psychological biases holding you back.",
      "sentenceSha256": "c9677b9b7456e62d6d0d101c9c7f4a92308270bbb95ac007e01bd955f6a3259b",
      "readingUnitId": "c10-s09-p121-03675-r009-011",
      "parentQuestionId": "q-c10-119",
      "parentFingerprint": "ec46309c6766e89367780600392c41c314c06fc03e9a9be83083df778b877f6c",
      "passageSha256": "2e65360fd9558f8306b0817e82320f33a7fa97bbab51328be9f1cc31aa0ba9e1",
      "pdfPages": [
        121
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c11-0001",
      "sentenceId": "c11-s01-p122-03878-s001",
      "sentenceText": "Most psychologically rich experiences are intentional.",
      "sentenceSha256": "15a8869e6c1cf3bb98c7b212c71486c9bf4f580443d88f5cddcca9e1d330246e",
      "readingUnitId": "c11-s01-p122-03878-r001-004",
      "parentQuestionId": "q-c11-001",
      "parentFingerprint": "30dcd52e297c1a07384f99054f18c58045fe3c3d20638967c4ec4947268f640f",
      "passageSha256": "29b8c5efaf8aa7dd1d77862e8eb4dccb1ec9c263212c891d9b4efa3d86234762",
      "pdfPages": [
        122
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c11-0002",
      "sentenceId": "c11-s01-p122-03878-s002",
      "sentenceText": "One usually makes the choice to study abroad.",
      "sentenceSha256": "cdb4640024424f4c1f05c57064ba879df591b0339feecc5cc0af5458694e0787",
      "readingUnitId": "c11-s01-p122-03878-r001-004",
      "parentQuestionId": "q-c11-001",
      "parentFingerprint": "30dcd52e297c1a07384f99054f18c58045fe3c3d20638967c4ec4947268f640f",
      "passageSha256": "29b8c5efaf8aa7dd1d77862e8eb4dccb1ec9c263212c891d9b4efa3d86234762",
      "pdfPages": [
        122
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c11-0003",
      "sentenceId": "c11-s01-p122-03878-s003",
      "sentenceText": "One chooses to read Marcel Proust; one chooses to watch an Agnès Varda film; one chooses to take up a DIY project.",
      "sentenceSha256": "58cac6a0793dda1ccc9c10ce9fc98e1de444a7591d10571229199fb85a1d5157",
      "readingUnitId": "c11-s01-p122-03878-r001-004",
      "parentQuestionId": "q-c11-001",
      "parentFingerprint": "30dcd52e297c1a07384f99054f18c58045fe3c3d20638967c4ec4947268f640f",
      "passageSha256": "29b8c5efaf8aa7dd1d77862e8eb4dccb1ec9c263212c891d9b4efa3d86234762",
      "pdfPages": [
        122
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c11-0004",
      "sentenceId": "c11-s01-p122-03878-s005",
      "sentenceText": "A natural disaster such as an earthquake or hurricane or an illness is an unexpected and challenging experience.",
      "sentenceSha256": "e0b62992a316cef1ff8900a8fe097a82752e865c5b40c258a0d44222c059932b",
      "readingUnitId": "c11-s01-p122-03878-r005-007",
      "parentQuestionId": "q-c11-002",
      "parentFingerprint": "fefe924c6636e85d845df3a72260e8c14f2b7081bb74996a592be07cb8a22a08",
      "passageSha256": "32c71523bd6664067b79134f2b2ef700baae20418125834210b1c2e474df6745",
      "pdfPages": [
        122
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c11-0005",
      "sentenceId": "c11-s01-p122-03878-s006",
      "sentenceText": "These experiences typically provide victims with new perspectives.",
      "sentenceSha256": "0b0eb906e7348bd6f9ac1844b058b33262b20c616697bdd80d739fb946ccb147",
      "readingUnitId": "c11-s01-p122-03878-r005-007",
      "parentQuestionId": "q-c11-002",
      "parentFingerprint": "fefe924c6636e85d845df3a72260e8c14f2b7081bb74996a592be07cb8a22a08",
      "passageSha256": "32c71523bd6664067b79134f2b2ef700baae20418125834210b1c2e474df6745",
      "pdfPages": [
        122
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c11-0006",
      "sentenceId": "c11-s01-p122-05242-s002",
      "sentenceText": "As an expert on classical philosophy, Nietzsche was cognizant of the ancient world.",
      "sentenceSha256": "b8bb17f0198a2e0423c76e863a37b856b4e2f593b01968bbaa05f687b94fb9a9",
      "readingUnitId": "c11-s01-p122-05242-r001-004",
