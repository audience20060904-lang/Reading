      "passageSha256": "b229bb56213a3af7f9b43068b9ad3a32d5ffa00706c48591260a3bf1e487a6cf",
      "pdfPages": [
        27
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c03-0004",
      "sentenceId": "c03-s01-p027-05992-s001",
      "sentenceText": "Why so down on happiness?",
      "sentenceSha256": "b530079a2495dd201f216c2d23347ae834ac83c3100ba4d8d253366e5e4aa7bb",
      "readingUnitId": "c03-s01-p027-05992-r001-004",
      "parentQuestionId": "q-c03-003",
      "parentFingerprint": "efae1edc4fb21c5a03ff13b7d7c97bc9ab5e59237ff41bd4aec4f4685ffa28d5",
      "passageSha256": "218d6ad4ed2763b9566e35f2aad24bd94ffcbd006207da1fcc60304a04168150",
      "pdfPages": [
        27
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c03-0005",
      "sentenceId": "c03-s01-p027-05992-s005",
      "sentenceText": "Happy people volunteer more than unhappy people.",
      "sentenceSha256": "a88d277dc4403f34bd847c3acd912e9bb41723fefe833d50c24735358ac1a7b1",
      "readingUnitId": "c03-s01-p027-05992-r005-006",
      "parentQuestionId": "q-c03-004",
      "parentFingerprint": "3ef42993a175641b4946d31895f71741eb5347b0b3d21e1d1c8436fb9f69f2e7",
      "passageSha256": "0dbfef96c58da89579fe84b3da31e106bf9344b312428762c6f92dac2a615149",
      "pdfPages": [
        27
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c03-0006",
      "sentenceId": "c03-s01-p028-00750-s001",
      "sentenceText": "The novelist Donna Tartt suggested that it is “to make other people happy even at the expense of one’s own happiness”—in other words, what many scholars call a “meaningful life.”",
      "sentenceSha256": "af8d185c22beac08c66408d446335e1b51412830eaff4990d2a3558fbb15468a",
