      "pdfPages": [
        26
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c02-0105",
      "sentenceId": "c02-s05-p026-02700-s002",
      "sentenceText": "Zarathustra said to himself: “I am a wanderer and a mountain climber….",
      "sentenceSha256": "3a09b4343e8cbf580d3cb2166a9d9b3d431a8ba8e38f2c5450ee81734e862368",
      "readingUnitId": "c02-s05-p026-02700-r001-004",
      "parentQuestionId": "q-c02-083",
      "parentFingerprint": "bc3ee28d7860e101ee87d346210dd947e1e17ef097f94cf72aa28889d8b15cfa",
      "passageSha256": "091e355718b85895a35a48015a28367dcd1c177bc3bc6d21c53f70d072bd06d6",
      "pdfPages": [
        26
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c02-0106",
      "sentenceId": "c02-s05-p026-02700-s003",
      "sentenceText": "Only now are you going your way to greatness!",
      "sentenceSha256": "2bcb34c9fa1672e71dfdd4d58fb81a157d49349bd3c0ad9e7781c3e5c58510bc",
      "readingUnitId": "c02-s05-p026-02700-r001-004",
