      "questionId": "qe-c02-0098",
      "sentenceId": "c02-s05-p025-03285-s003",
      "sentenceText": "Many Danes said they don’t expect much in life.",
      "sentenceSha256": "e77d6978154de9f3c089a3815300d7ca2bc9800882d62ada6fd5ae88b91ff17a",
      "readingUnitId": "c02-s05-p025-03285-r003-006",
