      "questionId": "qe-c03-0001",
      "sentenceId": "c03-s01-p027-04238-s001",
      "sentenceText": "Happiness has many fans.",
      "sentenceSha256": "9c400605d7d149629d83934dc07e12b78cb8863d7e64ef8acf06816b6b235716",
      "readingUnitId": "c03-s01-p027-04238-r001-004",
      "parentQuestionId": "q-c03-001",
      "parentFingerprint": "490378e24a27ee49da807c8711ce883a5eef03daaae1c6feb9356a4a2fad8d0f",
      "passageSha256": "68888f2b64d18559972b9cb25fdfd91c9d3f7269b5e6b07e51673776e67bd5ea",
      "pdfPages": [
        27
