      "pdfPages": [
        26
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c02-0107",
      "sentenceId": "c02-s05-p026-02700-s006",
      "sentenceText": "Zarathustra was a “friend of all who travel far and do not like to live without danger….",
      "sentenceSha256": "f90b98f5cb4dd6e7a4b8e6a2dbb07098c1ebf0cdfae12c016bbca780c301105f",
      "readingUnitId": "c02-s05-p026-02700-r005-006",
      "parentQuestionId": "q-c02-084",
      "parentFingerprint": "ec7760f3b30c809bc2eb4a3c19b0a85b9a5b2eafe76fff5227d5ecd648028f78",
      "passageSha256": "8220edd2009334a4c6c358f5dc4c85fd335ec929d549f4fbba4b695cce26ed17",
      "pdfPages": [
        26
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c02-0108",
      "sentenceId": "c02-s05-p026-05625-s002",
      "sentenceText": "These emotions add complexity and richness to your inner life.",
      "sentenceSha256": "b178315d8a19793a65ddafa59fd75bd2dc528b7a42dd9cc0ddb2c205ce250724",
      "readingUnitId": "c02-s05-p026-05625-r001-006",
