    },
    {
      "order": 21,
      "questionId": "qe-c03-0002",
      "sentenceId": "c03-s01-p027-04238-s003",
      "sentenceText": "Flaubert wrote to Louise Colet, “To be stupid, selfish, and have good health are three requirements for happiness, though if stupidity is lacking, all is lost.”",
      "sentenceSha256": "1ac90ac786aec83d44a0569eb3b787866be744002814795180123bb973dd4a6a",
      "readingUnitId": "c03-s01-p027-04238-r001-004",
      "parentQuestionId": "q-c03-001",
      "parentFingerprint": "490378e24a27ee49da807c8711ce883a5eef03daaae1c6feb9356a4a2fad8d0f",
      "passageSha256": "68888f2b64d18559972b9cb25fdfd91c9d3f7269b5e6b07e51673776e67bd5ea",
      "pdfPages": [
        27
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c03-0003",
      "sentenceId": "c03-s01-p027-04238-s005",
      "sentenceText": "Shel Silverstein’s poem “The Land of Happy” might be the most poignant critique of happiness.",
      "sentenceSha256": "660e057a2d1bb615b034598931069abe00b483c7398fcf71bd1e82f4f7990abd",
      "readingUnitId": "c03-s01-p027-04238-r005-007",
      "parentQuestionId": "q-c03-002",
