    },
    {
      "order": 14,
      "questionId": "qe-c07-0046",
      "sentenceId": "c07-s01-p071-05235-s001",
      "sentenceText": "In the essay “Human, All Too Human” in his work Ecce Homo, Friedrich Nietzsche wrote about German specialization as follows: “I have discovered that a large number of young men experience the same distress: one antinatural step virtually compels the second.",
      "sentenceSha256": "c71fabf606d085cf92d3e9a08b58c8e38b37a177b033b45fbdfff723d48135f0",
      "readingUnitId": "c07-s01-p071-05235-r001-002",
      "parentQuestionId": "q-c07-027",
