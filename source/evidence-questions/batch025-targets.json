      "sentenceId": "c07-s01-p070-03675-s002",
      "sentenceText": "For every Michael Phelps and Simone Biles, there are athletes like Michael Jordan and Alex Morgan.",
      "sentenceSha256": "1a049d4f8739262c65e1fcaf25af4bd2912e2106139db1313a7548c9f87b1443",
      "readingUnitId": "c07-s01-p070-03675-r001-003",
