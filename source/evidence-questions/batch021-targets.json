    },
    {
      "order": 14,
      "questionId": "qe-c06-0100",
      "sentenceId": "c06-s05-p062-05355-s001",
      "sentenceText": "Is a happy person different from a psychologically rich person?",
      "sentenceSha256": "152e3dae1b4ead9aec978e406e1482b2f5745be0e7bdcf8c84a2b3c3cb60c432",
      "readingUnitId": "c06-s05-p062-05355-r001-004",
      "parentQuestionId": "q-c06-062",
      "parentFingerprint": "f8ba3a04adcd509a1508923f8f134ebfd52c56856ff4a0ca0821596b9f2cc643",
      "passageSha256": "97162c5edb1bb3436c0a2fa54940539717e90220c33adad7700ceef388aef65f",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c06-0101",
      "sentenceId": "c06-s05-p062-05355-s002",
      "sentenceText": "One example of a “happy” person is Mr. Rogers in Mister Rogers’ Neighborhood.",
      "sentenceSha256": "f8da5c6c6e4685171772ac7ab58f51b4480b473beb5eafc93822a0d8edab44cc",
      "readingUnitId": "c06-s05-p062-05355-r001-004",
      "parentQuestionId": "q-c06-062",
      "parentFingerprint": "f8ba3a04adcd509a1508923f8f134ebfd52c56856ff4a0ca0821596b9f2cc643",
      "passageSha256": "97162c5edb1bb3436c0a2fa54940539717e90220c33adad7700ceef388aef65f",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c06-0102",
      "sentenceId": "c06-s05-p062-05355-s004",
      "sentenceText": "The show consists of lots of singing, dancing, and puppet shows.",
      "sentenceSha256": "8d7e00b9e8875ac64e2d9b6f038c46d15206e1e9a79a3742630fc4a4e4e36ec0",
      "readingUnitId": "c06-s05-p062-05355-r001-004",
      "parentQuestionId": "q-c06-062",
      "parentFingerprint": "f8ba3a04adcd509a1508923f8f134ebfd52c56856ff4a0ca0821596b9f2cc643",
      "passageSha256": "97162c5edb1bb3436c0a2fa54940539717e90220c33adad7700ceef388aef65f",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c06-0103",
      "sentenceId": "c06-s05-p062-06330-s001",
      "sentenceText": "Mr. Rogers demonstrates the essential characteristics of happy people: extraverted, emotionally stable (lacking neuroticism), conscientious, and agreeable.",
      "sentenceSha256": "b5e859c94ae3b663f00c9599737cbb59f689e287862d47be177f1f2e6640c555",
      "readingUnitId": "c06-s05-p062-06330-r001-003",
      "parentQuestionId": "q-c06-064",
      "parentFingerprint": "e640c5e77ad159928ee6cbe643f9a85ae68f60c3b70ad296f9974fae3fe485a1",
      "passageSha256": "58f8e818afc67b21bd4e9bbee690a11b41f0518af97266ecda718bfceabc8b18",
      "pdfPages": [
        62,
        63
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c06-0104",
      "sentenceId": "c06-s05-p062-06330-s002",
      "sentenceText": "The patterns of correlation for psychological richness are quite different from those for happiness.",
      "sentenceSha256": "24b4e5aad20328e833ff385048fd80d91f4d1cd45193fc367e1dce83cd11de71",
      "readingUnitId": "c06-s05-p062-06330-r001-003",
      "parentQuestionId": "q-c06-064",
      "parentFingerprint": "e640c5e77ad159928ee6cbe643f9a85ae68f60c3b70ad296f9974fae3fe485a1",
      "passageSha256": "58f8e818afc67b21bd4e9bbee690a11b41f0518af97266ecda718bfceabc8b18",
      "pdfPages": [
        62,
        63
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c06-0105",
      "sentenceId": "c06-s05-p063-01335-s001",
      "sentenceText": "The two strongest personality predictors of a happy life are emotional stability and extraversion.",
      "sentenceSha256": "4f5385eeebb8f22bbed8b8111338f847f33f76fd9f911cfa4e0385b8fab5c47f",
      "readingUnitId": "c06-s05-p063-01335-r001-003",
      "parentQuestionId": "q-c06-065",
      "parentFingerprint": "182103f217babc2ec9460019573b6207d15ce5f92fa7285e771780715ee97aad",
      "passageSha256": "d02781765271e1f2ef5c1abfcd5102c15bc84d42003844eb7ece42a1dc8d9d3e",
      "pdfPages": [
        63
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c06-0106",
      "sentenceId": "c06-s05-p063-01335-s002",
      "sentenceText": "Some personality scholars conceptualize extraversion as positive affectivity (good moods) and neuroticism as negative affectivity (bad moods).",
      "sentenceSha256": "2bc1305cdd328270f4c7fee5ebc238bd38aa475cbf6adf7978036fa166ab4a88",
      "readingUnitId": "c06-s05-p063-01335-r001-003",
      "parentQuestionId": "q-c06-065",
      "parentFingerprint": "182103f217babc2ec9460019573b6207d15ce5f92fa7285e771780715ee97aad",
      "passageSha256": "d02781765271e1f2ef5c1abfcd5102c15bc84d42003844eb7ece42a1dc8d9d3e",
      "pdfPages": [
        63
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c06-0107",
      "sentenceId": "c06-s05-p063-02700-s001",
      "sentenceText": "Overall, the key difference between a happy personality and a psychologically rich personality is that happy people are not necessarily open to experiences, whereas psychologically rich people are quite open.",
      "sentenceSha256": "fc56934e08a27a5fb878f8d9f7fe862133bdf646615be1270284e048bbe3b13f",
      "readingUnitId": "c06-s05-p063-02700-r001-002",
      "parentQuestionId": "q-c06-066",
      "parentFingerprint": "d6e4a3abae385bcf354805b2dda15d4cfd845c5a456d176dbbac0cb52196c29b",
      "passageSha256": "5f21038bc7339700c2c2f32d0d4fee4ac1e632d1a27cbda0726185c995c411f4",
      "pdfPages": [
        63
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c06-0108",
      "sentenceId": "c06-s05-p063-04065-s001",
      "sentenceText": "Why are emotional stability, extraversion, conscientiousness, and agreeableness good for a happy life?",
      "sentenceSha256": "49f9830704c87d44eb0cc526823bee0d731a39d2a465864ba6eeaeadf940fbf4",
      "readingUnitId": "c06-s05-p063-04065-r001-004",
