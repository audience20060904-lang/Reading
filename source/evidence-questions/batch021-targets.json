      ]
    },
    {
      "order": 2,
      "questionId": "qe-c06-0088",
      "sentenceId": "c06-s04-p061-05160-s008",
      "sentenceText": "In the long run, then, extraverts are more likely to meet different kinds of people and are more likely to learn new things than an introvert like myself.",
      "sentenceSha256": "006832d6f1580868825d9402bb54bcc3fc3861cc07917dd8d0193d6bfb3193a5",
      "readingUnitId": "c06-s04-p061-05160-r005-008",
      "parentQuestionId": "q-c06-055",
      "parentFingerprint": "a1b1e8b77f33a3b0164e64d306c04a72356cf873d0955e5163bab04c93a71416",
