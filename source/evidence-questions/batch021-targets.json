    },
    {
      "order": 8,
      "questionId": "qe-c06-0094",
      "sentenceId": "c06-s04-p062-01140-s007",
      "sentenceText": "There is a positive spiral here, too.",
      "sentenceSha256": "e5a02ce5a18bedf3920d84795f07b82f90678e6833f8aed3be4afac0a70bed25",
      "readingUnitId": "c06-s04-p062-01140-r005-008",
      "parentQuestionId": "q-c06-058",
      "parentFingerprint": "77155b5d53a3a565a2e66d91f069b9431a2dad1a50894d86c61a7a5cea87c2d0",
      "passageSha256": "d643f70ccb620122d341618c847be7457f71872f23806b76b077e4cb01235599",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c06-0095",
      "sentenceId": "c06-s04-p062-03285-s001",
      "sentenceText": "Another aspect of extraversion that might be related to psychological richness is energy.",
      "sentenceSha256": "dbebc658adf2f0dc5b3d6a215d5f964516d7574b0da4539471c50c6db714d033",
      "readingUnitId": "c06-s04-p062-03285-r001-004",
      "parentQuestionId": "q-c06-060",
      "parentFingerprint": "a6a2e8a67f77ad735fc04a807705a0c2d18384473f61ede6e1d74e17842992ea",
      "passageSha256": "9e6ea01b973473a28a68a2097875cd96abb564322aaea4b7385de49db8ca20ad",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c06-0096",
      "sentenceId": "c06-s04-p062-03285-s002",
      "sentenceText": "Extraverts tend to be more energetic than introverts.",
      "sentenceSha256": "f8153e72398f9a5a8d5381db063184eb0752a10c723290bf62d85cb16fd74582",
      "readingUnitId": "c06-s04-p062-03285-r001-004",
      "parentQuestionId": "q-c06-060",
      "parentFingerprint": "a6a2e8a67f77ad735fc04a807705a0c2d18384473f61ede6e1d74e17842992ea",
      "passageSha256": "9e6ea01b973473a28a68a2097875cd96abb564322aaea4b7385de49db8ca20ad",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c06-0097",
      "sentenceId": "c06-s04-p062-03285-s003",
      "sentenceText": "The more energy one has, the more activities one can engage in.",
      "sentenceSha256": "e9d1f67ac938b940f829d81bfca7fb9d279a5519e4ffec30098537f6c07df8d4",
      "readingUnitId": "c06-s04-p062-03285-r001-004",
