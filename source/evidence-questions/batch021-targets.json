      ]
    },
    {
      "order": 3,
      "questionId": "qe-c06-0089",
      "sentenceId": "c06-s04-p062-01140-s001",
      "sentenceText": "On a basic level, why do extraverts explore the social world more?",
      "sentenceSha256": "34f4a81597966c10cd4dc622f728b22163440431ea817590222256f1cf521879",
      "readingUnitId": "c06-s04-p062-01140-r001-004",
      "parentQuestionId": "q-c06-057",
      "parentFingerprint": "d90ae1486a7aac10df544f2badcafabf08ed84f77e670ad61ea823de493f8450",
      "passageSha256": "d5b06a393a79de3615dabbaca9adadf5ee9b30344a512b487a853e79b520e8ad",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c06-0090",
      "sentenceId": "c06-s04-p062-01140-s003",
      "sentenceText": "When you are confident, meeting a new person is not threatening.",
      "sentenceSha256": "165305b89f5b33debc16ebfd2c7f97d5f064854b980626741d3e4adf484c1677",
      "readingUnitId": "c06-s04-p062-01140-r001-004",
      "parentQuestionId": "q-c06-057",
      "parentFingerprint": "d90ae1486a7aac10df544f2badcafabf08ed84f77e670ad61ea823de493f8450",
      "passageSha256": "d5b06a393a79de3615dabbaca9adadf5ee9b30344a512b487a853e79b520e8ad",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c06-0091",
      "sentenceId": "c06-s04-p062-01140-s004",
      "sentenceText": "What is there to lose?",
      "sentenceSha256": "326a9b5aacaebd032734fe99f22a1d4524680f2b4fa7e3fa960742d4b277ac20",
      "readingUnitId": "c06-s04-p062-01140-r001-004",
      "parentQuestionId": "q-c06-057",
