      ]
    },
    {
      "order": 12,
      "questionId": "qe-c06-0098",
      "sentenceId": "c06-s04-p062-03285-s005",
      "sentenceText": "Joy Ryan is again a great example here.",
      "sentenceSha256": "f925519c356d8d6e1fff1c2aad777b574466e48c11b7c977de57b87c388ef64b",
      "readingUnitId": "c06-s04-p062-03285-r005-007",
      "parentQuestionId": "q-c06-061",
      "parentFingerprint": "8247d1a7b93fa4bfa69ac2d2efea004628371143904b3f09604ad00653cdb558",
      "passageSha256": "b8b1e6957796768a7ef227efd0beac5dedc0bab888ccb1f3e2d6cbfa723a6bbf",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c06-0099",
      "sentenceId": "c06-s04-p062-03285-s007",
      "sentenceText": "Thanks to this, she can visit remote national parks and enjoy unusual, psychologically rich experiences.",
      "sentenceSha256": "d7426461cd6a4ba97bf08c999708ac477b61d4d6b677c2452471ffb8142b63f3",
      "readingUnitId": "c06-s04-p062-03285-r005-007",
