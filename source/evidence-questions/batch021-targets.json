      "passageSha256": "d643f70ccb620122d341618c847be7457f71872f23806b76b077e4cb01235599",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c06-0093",
      "sentenceId": "c06-s04-p062-01140-s006",
      "sentenceText": "Instead, you are thinking about the benefits: getting to know someone new, learning something new, sharing interesting stories.",
      "sentenceSha256": "c882d81940b93a3e9a86d28190bd8882c8ed33aff58cb11583ee883aabcc137f",
      "readingUnitId": "c06-s04-p062-01140-r005-008",
