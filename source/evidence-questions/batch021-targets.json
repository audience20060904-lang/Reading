      "passageSha256": "d5b06a393a79de3615dabbaca9adadf5ee9b30344a512b487a853e79b520e8ad",
      "pdfPages": [
        62
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c06-0092",
      "sentenceId": "c06-s04-p062-01140-s005",
      "sentenceText": "You are not worried about being negatively evaluated by this person or making a bad impression.",
      "sentenceSha256": "65a8a001bce088d76641616e9a77aaabafa888abd6531c1d7bb5c672dfab8d06",
      "readingUnitId": "c06-s04-p062-01140-r005-008",
