      "questionId": "qe-c06-0110",
      "sentenceId": "c06-s05-p063-04065-s004",
      "sentenceText": "Well, someone like Mr. Rogers: friendly, stable, reliable, and kind.",
      "sentenceSha256": "eb8a2070abdc08f086893aa6a8658bf05ac088c93da3454c5713fb7b83378399",
      "readingUnitId": "c06-s05-p063-04065-r001-004",
      "parentQuestionId": "q-c06-067",
