      "questionId": "qe-c06-0034",
      "sentenceId": "c06-s02-p057-01140-s001",
      "sentenceText": "A bit of history first.",
      "sentenceSha256": "1f76a24ceda082e6b7c321a5010cd8e7f8b4aa63f858c49c7fadef822e926501",
      "readingUnitId": "c06-s02-p057-01140-r001-004",
      "parentQuestionId": "q-c06-024",
      "parentFingerprint": "86fd18160bc878a81ad7e1b7ab10a50f2e6b9cd1a4ed79be179e488ee19be4b4",
