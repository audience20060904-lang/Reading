    },
    {
      "order": 22,
      "questionId": "qe-c06-0033",
      "sentenceId": "c06-s02-p056-06330-s003",
      "sentenceText": "Since I used to teach an intro to personality psychology class, I’m equipped to deliver this five-minute lecture on the Big Five personality traits.",
      "sentenceSha256": "5728b131491495ad7a37a22abafc3e93e5bb17bd829e9eaac0846bea783ce0dc",
      "readingUnitId": "c06-s02-p056-06330-r001-003",
