    },
    {
      "order": 13,
      "questionId": "qe-c06-0024",
      "sentenceId": "c06-s01-p055-05820-s005",
      "sentenceText": "That is, 34.5 percent of the people featured in Straits Times obituaries were rated to have led a rich life, far more than in the first two newspapers.",
      "sentenceSha256": "b6a4756ef4d1a5f5e6487effc9a146f5644d9ae0965fb059aca2f2e25c09f0ae",
      "readingUnitId": "c06-s01-p055-05820-r005-007",
      "parentQuestionId": "q-c06-015",
