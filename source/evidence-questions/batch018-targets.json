    },
    {
      "order": 24,
      "questionId": "qe-c06-0035",
      "sentenceId": "c06-s02-p057-01140-s002",
      "sentenceText": "In 1936, psychologists Gordon W. Allport and Henry S. Odbert set out to identify all the words describing personality or personal behavior in Webster’s 1925 New International Dictionary.",
      "sentenceSha256": "2f5845841193135979e0ea153635b01fce9c3b8527219ff168c593e7b1560103",
      "readingUnitId": "c06-s02-p057-01140-r001-004",
      "parentQuestionId": "q-c06-024",
      "parentFingerprint": "86fd18160bc878a81ad7e1b7ab10a50f2e6b9cd1a4ed79be179e488ee19be4b4",
      "passageSha256": "f2c8af4be651f7e736b79e685c42f43ccff16d2a2f6ebea6bd7edad4cad72141",
      "pdfPages": [
        57
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c06-0036",
      "sentenceId": "c06-s02-p057-01140-s003",
      "sentenceText": "That dictionary contained roughly 400,000 entries, of which they found 17,953 personal descriptors, or 4.5 percent of the English vocabulary recorded there.",
      "sentenceSha256": "fb659554d57c8b5af874a168a01aae00ffcfb254a9ff815435706b68dce12714",
      "readingUnitId": "c06-s02-p057-01140-r001-004",
