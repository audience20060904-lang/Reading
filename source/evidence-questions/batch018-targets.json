      "pdfPages": [
        56
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c06-0029",
      "sentenceId": "c06-s01-p056-03480-s002",
      "sentenceText": "Steve Jobs is a real-life example.",
      "sentenceSha256": "e7c7b84cee60e7fc13498bc47e75e0a54b80ee1997929c509f5af841ce2c9161",
      "readingUnitId": "c06-s01-p056-03480-r001-004",
      "parentQuestionId": "q-c06-019",
      "parentFingerprint": "870ac02484f43bf5ee47a227ff751060982a8d0d6945c4c8dab449b37fb4206b",
      "passageSha256": "3ebef574ad2f5d45fde08b3da477918390b9cfaaefefa513e061743aa6ef4bfe",
      "pdfPages": [
