    },
    {
      "order": 21,
      "questionId": "qe-c06-0032",
      "sentenceId": "c06-s02-p056-06330-s001",
      "sentenceText": "Are there any personality characteristics that differentiate those who lead a psychologically rich life from those who lead a happy or a meaningful life?",
