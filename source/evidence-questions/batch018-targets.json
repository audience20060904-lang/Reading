    },
    {
      "order": 19,
      "questionId": "qe-c06-0030",
      "sentenceId": "c06-s01-p056-03480-s003",
      "sentenceText": "He was often angry and alienated many people around him.",
      "sentenceSha256": "377a511fec3ead7891fe99e66c21d18f88c5b29ba3cbda4a6c31a0ba92e22847",
      "readingUnitId": "c06-s01-p056-03480-r001-004",
      "parentQuestionId": "q-c06-019",
      "parentFingerprint": "870ac02484f43bf5ee47a227ff751060982a8d0d6945c4c8dab449b37fb4206b",
      "passageSha256": "3ebef574ad2f5d45fde08b3da477918390b9cfaaefefa513e061743aa6ef4bfe",
      "pdfPages": [
        56
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c06-0031",
      "sentenceId": "c06-s01-p056-04650-s004",
      "sentenceText": "In sum, our research supports that a life of exploration is a distinct kind of good life, a psychologically rich one.",
