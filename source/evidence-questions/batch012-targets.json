      "sentenceId": "c04-s04-p039-03600-s001",
      "sentenceText": "After dropping out of college, Jobs worked in an apple orchard and became deeply interested in Eastern spirituality and LSD.",
      "sentenceSha256": "b319a9b9fb9cc31f995dbd1f80bbdb0bc40c9f490b4b1d5345a850034e033b48",
      "readingUnitId": "c04-s04-p039-03600-r001-004",
