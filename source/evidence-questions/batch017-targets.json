  "targets": [
    {
      "order": 1,
      "questionId": "qe-c05-0086",
      "sentenceId": "c05-s05-p051-01650-s001",
      "sentenceText": "In her popular book Bittersweet, Susan Cain contends that “light and dark, birth and death—bitter and sweet—are forever paired” and that negative emotions such as sorrow and longing “make us whole.”",
      "sentenceSha256": "c284035be402d122b23a3941ea553b8e1b7f3b80760be0633fe15555e551024a",
      "readingUnitId": "c05-s05-p051-01650-r001-003",
      "parentQuestionId": "q-c05-051",
      "parentFingerprint": "b03fdf9f8444a74f4c4c25f36a03eb28204059c5d89813b9644d41703956a03e",
      "passageSha256": "c2e8e2ecb419ac762e869189579f0bf7a63231b33877afbb2c3a2fe1d951a4b6",
      "pdfPages": [
        51
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c05-0087",
      "sentenceId": "c05-s05-p051-01650-s002",
      "sentenceText": "She argues that negative emotions play a central role in our emotional lives and make us more empathetic and even more creative.",
      "sentenceSha256": "b10214578eee2c500b6c2abca8d164bf8970c972409bfc952fc99561f5c6ec5e",
      "readingUnitId": "c05-s05-p051-01650-r001-003",
      "parentQuestionId": "q-c05-051",
      "parentFingerprint": "b03fdf9f8444a74f4c4c25f36a03eb28204059c5d89813b9644d41703956a03e",
      "passageSha256": "c2e8e2ecb419ac762e869189579f0bf7a63231b33877afbb2c3a2fe1d951a4b6",
      "pdfPages": [
        51
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c05-0088",
      "sentenceId": "c05-s05-p051-03015-s001",
      "sentenceText": "What role does emotional complexity play in psychological richness?",
      "sentenceSha256": "e74f603465ec27d75577e8bc43752ac77d187868247190b301b4195dd21f0421",
      "readingUnitId": "c05-s05-p051-03015-r001-004",
      "parentQuestionId": "q-c05-052",
      "parentFingerprint": "f67846d7f2dbd93526cd76900bc8773443d5ca58d362739594e76e11060c3048",
      "passageSha256": "b928ec98463dd2496645010204fd947fa8103248d4596ba6a375bc3cf7780fc3",
      "pdfPages": [
        51
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c05-0089",
      "sentenceId": "c05-s05-p051-03015-s002",
      "sentenceText": "In six studies, we explored the role of positive and negative emotions in happiness, meaning, and psychological richness.",
      "sentenceSha256": "c3710959bd8991330f6aa08dd68ddae0609f02780e78a28fc050e5f1088085c6",
      "readingUnitId": "c05-s05-p051-03015-r001-004",
      "parentQuestionId": "q-c05-052",
      "parentFingerprint": "f67846d7f2dbd93526cd76900bc8773443d5ca58d362739594e76e11060c3048",
      "passageSha256": "b928ec98463dd2496645010204fd947fa8103248d4596ba6a375bc3cf7780fc3",
      "pdfPages": [
        51
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c05-0090",
      "sentenceId": "c05-s05-p051-03015-s003",
      "sentenceText": "In all six, those who were leading a happy life experienced a lot of joy, contentment, and pleasantness but infrequently experienced sadness, anger, and fear.",
      "sentenceSha256": "0de2752294ec0e1336f472a6cebb5f00c103e716b174a7ab62b7a0bb17ac78ef",
      "readingUnitId": "c05-s05-p051-03015-r001-004",
      "parentQuestionId": "q-c05-052",
      "parentFingerprint": "f67846d7f2dbd93526cd76900bc8773443d5ca58d362739594e76e11060c3048",
      "passageSha256": "b928ec98463dd2496645010204fd947fa8103248d4596ba6a375bc3cf7780fc3",
      "pdfPages": [
        51
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c05-0091",
      "sentenceId": "c05-s05-p051-04770-s001",
      "sentenceText": "In the final experiment, we tested whether we could make people feel like they had a richer week.",
      "sentenceSha256": "50205ad249346c6d66bd9ef594648c1f813986d698e08a2fa413284f3aa69a5b",
      "readingUnitId": "c05-s05-p051-04770-r001-003",
      "parentQuestionId": "q-c05-054",
      "parentFingerprint": "a8ae185ca176b6da177a4debde8eedb918707cca062b2aee1ef14b508cc4db59",
      "passageSha256": "0a3b849930a75ce2b7ccebedc8fcafd5a37abdf5c53a865cca86cea30a2dda8b",
      "pdfPages": [
        51
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c05-0092",
      "sentenceId": "c05-s05-p051-04770-s003",
      "sentenceText": "After the writing task, they evaluated their lives over the previous week, reflecting on how much the writing task had made them think differently about themselves and the world (perspective change, in other words).",
      "sentenceSha256": "3d93356f1943c8612c2947f1d6582ac914039fbcb7a024f825bc2a13b364766d",
      "readingUnitId": "c05-s05-p051-04770-r001-003",
      "parentQuestionId": "q-c05-054",
      "parentFingerprint": "a8ae185ca176b6da177a4debde8eedb918707cca062b2aee1ef14b508cc4db59",
      "passageSha256": "0a3b849930a75ce2b7ccebedc8fcafd5a37abdf5c53a865cca86cea30a2dda8b",
      "pdfPages": [
        51
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c05-0093",
      "sentenceId": "c05-s05-p051-04770-s004",
      "sentenceText": "We found that compared to the participants who wrote about two positive events, those who wrote about both the best and the worst events reported a greater degree of perspective change.",
      "sentenceSha256": "61efb40c618ba326ce0c411ae1113689292e5c79ebea806f1b51688cab7d3db2",
      "readingUnitId": "c05-s05-p051-04770-r004-007",
      "parentQuestionId": "q-c05-055",
      "parentFingerprint": "264ee50705c5f48ff2a915109d75cf4abbec26142f523226804e1557859d6ece",
      "passageSha256": "3666b328c7ba99ebee37c53c67ea6cbee2c6c01ae3969c1aa95dd6a936646c34",
      "pdfPages": [
        51,
        52
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c05-0094",
      "sentenceId": "c05-s05-p051-04770-s005",
      "sentenceText": "Writing about the worst event, in short, increased the likelihood of perspective change.",
      "sentenceSha256": "675358a63fb4f8edef47d43e85b5e24f47835924f0fdccb962b758e709af1764",
      "readingUnitId": "c05-s05-p051-04770-r004-007",
      "parentQuestionId": "q-c05-055",
      "parentFingerprint": "264ee50705c5f48ff2a915109d75cf4abbec26142f523226804e1557859d6ece",
      "passageSha256": "3666b328c7ba99ebee37c53c67ea6cbee2c6c01ae3969c1aa95dd6a936646c34",
      "pdfPages": [
        51,
        52
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c05-0095",
      "sentenceId": "c05-s06-p052-02040-s001",
      "sentenceText": "So what are the ingredients of psychological richness?",
      "sentenceSha256": "0b13ea614fa8780e996bbeac6459d0a36675921dbe8b33f76f037073cba3155e",
      "readingUnitId": "c05-s06-p052-02040-r001-004",
      "parentQuestionId": "q-c05-057",
      "parentFingerprint": "1e102d5b7f158593cb9d8bba4330523a4247b8ed5fe3d307e4eaac0d8fbbde5e",
      "passageSha256": "36c9212df6221cd4bebc59fb28227a9a44f8b577116ccc9b976b3e2dcdf3b11e",
      "pdfPages": [
        52
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c05-0096",
      "sentenceId": "c05-s06-p052-02040-s002",
      "sentenceText": "The examples in this chapter, ranging from Grace’s WWE outing to an atypical day to a semester abroad, had some common elements.",
      "sentenceSha256": "03eb51c030cff0b075002fe4bc3b86a7ae47d36ca09db0c91319d6696b50711f",
      "readingUnitId": "c05-s06-p052-02040-r001-004",
      "parentQuestionId": "q-c05-057",
      "parentFingerprint": "1e102d5b7f158593cb9d8bba4330523a4247b8ed5fe3d307e4eaac0d8fbbde5e",
      "passageSha256": "36c9212df6221cd4bebc59fb28227a9a44f8b577116ccc9b976b3e2dcdf3b11e",
      "pdfPages": [
        52
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c05-0097",
      "sentenceId": "c05-s06-p052-02040-s005",
      "sentenceText": "Challenge: life is more difficult and complex than usual.",
      "sentenceSha256": "7570d69e40ec0e02199ce66f8b6a7a28e0360c41d20999ce1ee78076fefb0f40",
      "readingUnitId": "c05-s06-p052-02040-r005-008",
