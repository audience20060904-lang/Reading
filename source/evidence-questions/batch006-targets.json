      "parentFingerprint": "2bb06d9537c6294ff8477cada11102b05503045ef8a83ff48424e5c5aa52f29d",
      "passageSha256": "b912d0727b07c67cffc10251d3c744e153b0eeab4ec19a15da82c7a666136462",
      "pdfPages": [
        23
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c02-0072",
      "sentenceId": "c02-s05-p023-05160-s006",
      "sentenceText": "You have high SAT scores.",
      "sentenceSha256": "08b54d9ce61cd11ea11c3ea494fe88fec8496f31f7090c386772c84fdcd7f50b",
      "readingUnitId": "c02-s05-p023-05160-r005-008",
      "parentQuestionId": "q-c02-069",
