  "targets": [
    {
      "order": 1,
      "questionId": "qe-c02-0067",
      "sentenceId": "c02-s04-p023-03090-s002",
      "sentenceText": "If we didn’t feel as much pressure to feel happy and simply let our negative moods linger a bit, our own psychological immune system would kick in, attack the “psychological virus” of unhappiness, and remove it.",
      "sentenceSha256": "196810d2e66fa887e0f9dd46c4c2f84dd1ad079e49daac9c532be3decd114779",
      "readingUnitId": "c02-s04-p023-03090-r001-003",
      "parentQuestionId": "q-c02-020",
      "parentFingerprint": "4bf3102c776c7a2b224c2fa45d1470f5864920786160be3443d6cee43a07adfc",
      "passageSha256": "c8a6b5e125eed102b375f8b0804696a3e32ebd4bd608e1ce29320c1fb6ef6a83",
      "pdfPages": [
        23
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c02-0068",
      "sentenceId": "c02-s05-p023-05160-s001",
      "sentenceText": "The second element of the happiness trap is that happiness is actually easier to attain if you don’t want too much of it.",
      "sentenceSha256": "07996e109717e2078241e35dc168e031f342abb3fee69e2d96e3dc4c6f8f5498",
      "readingUnitId": "c02-s05-p023-05160-r001-004",
      "parentQuestionId": "q-c02-068",
      "parentFingerprint": "e3d051c97f0f6f02302925d728f4d2b5ca1400cb418968a9a45f7ce76ff56c9a",
      "passageSha256": "421cc5970606921d69c8a1563130e3247b68071dd6c36048aeef7253051f6d15",
      "pdfPages": [
        23
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c02-0069",
      "sentenceId": "c02-s05-p023-05160-s002",
      "sentenceText": "The social psychologist Barry Schwartz found the power of “good enough.”",
      "sentenceSha256": "a181a154d3651d2d36a6078b2d9632744b3d2e6c1da2599fa00a8fcc37880978",
      "readingUnitId": "c02-s05-p023-05160-r001-004",
      "parentQuestionId": "q-c02-068",
      "parentFingerprint": "e3d051c97f0f6f02302925d728f4d2b5ca1400cb418968a9a45f7ce76ff56c9a",
      "passageSha256": "421cc5970606921d69c8a1563130e3247b68071dd6c36048aeef7253051f6d15",
      "pdfPages": [
        23
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c02-0070",
      "sentenceId": "c02-s05-p023-05160-s004",
      "sentenceText": "Let’s say you are a high school senior.",
      "sentenceSha256": "7dbbe3d8ae8a1b1f458647cf19c348509dec8e53bc8a12e9a824660749134c53",
      "readingUnitId": "c02-s05-p023-05160-r001-004",
      "parentQuestionId": "q-c02-068",
      "parentFingerprint": "e3d051c97f0f6f02302925d728f4d2b5ca1400cb418968a9a45f7ce76ff56c9a",
      "passageSha256": "421cc5970606921d69c8a1563130e3247b68071dd6c36048aeef7253051f6d15",
      "pdfPages": [
        23
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c02-0071",
      "sentenceId": "c02-s05-p023-05160-s005",
      "sentenceText": "You have an almost perfect GPA.",
      "sentenceSha256": "e98ba64f6529e47e7c547cd59e18183ff42bba00990a8c123af8a346caa1e5c3",
      "readingUnitId": "c02-s05-p023-05160-r005-008",
