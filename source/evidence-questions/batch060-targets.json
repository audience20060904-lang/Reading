      "pdfPages": [
        154
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c13-0103",
      "sentenceId": "c13-s05-p154-00982-s010",
      "sentenceText": "The selection of fish is as meticulous.",
      "sentenceSha256": "5d51bfbf00acc412aefe1814b7095298ed378a0c5c528d69e7095e1c8577fab3",
      "readingUnitId": "c13-s05-p154-00982-r009-012",
