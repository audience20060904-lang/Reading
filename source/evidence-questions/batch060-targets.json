      "passageSha256": "62a8fbefd0a1043b62d53895d4505871efda25f00019676986c1adcfe7521912",
      "pdfPages": [
        155
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c13-0111",
      "sentenceId": "c13-s05-p155-01140-s006",
      "sentenceText": "Second, like all sushi chefs in Japan, Jiro faced diverse, unexpected challenges over time.",
