      "passageSha256": "5b30f2b55b0114fbc71d95293f7dbf4a8db279739ef680839b0a491d7ac10e58",
      "pdfPages": [
        155
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c13-0112",
      "sentenceId": "c13-s05-p155-01140-s007",
      "sentenceText": "As some popular sushi fish disappeared from Tokyo Bay, Jiro had to adjust the type of sushi he served over the years.",
