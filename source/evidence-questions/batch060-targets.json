      "pdfPages": [
        154
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c13-0102",
      "sentenceId": "c13-s05-p154-00982-s009",
      "sentenceText": "He pays close and critical attention to each customer’s facial expressions after each bite.",
