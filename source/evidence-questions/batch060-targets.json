      "pdfPages": [
        154
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c13-0101",
      "sentenceId": "c13-s05-p154-00982-s007",
      "sentenceText": "He could have been satisfied with the methods he had already developed to get to the pinnacle of culinary art.",
