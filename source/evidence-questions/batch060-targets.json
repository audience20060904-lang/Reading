      "pdfPages": [
        155
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c13-0113",
      "sentenceId": "c13-s05-p155-01140-s008",
      "sentenceText": "All these environmental changes have forced him to change the way he creates his menu.",
