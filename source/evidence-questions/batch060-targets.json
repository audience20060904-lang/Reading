    },
    {
      "order": 18,
      "questionId": "qe-c13-0114",
      "sentenceId": "c13-s05-p155-01140-s011",
      "sentenceText": "Because of all the challenges, he hasn’t had time to really ruminate on his mistakes (I assume even a master makes them now and then).",
