  "targets": [
    {
      "order": 1,
      "questionId": "qe-c03-0057",
      "sentenceId": "c03-s06-p033-06330-s001",
      "sentenceText": "Decades of psychological research, including some of my own studies, have undoubtedly established happiness and meaning as paths to a good life with countless benefits.",
      "sentenceSha256": "b35720f86a0f07c68377522cd08a1eda77895cc43483aed8a3d0b1526328fcd2",
      "readingUnitId": "c03-s06-p033-06330-r001-004",
      "parentQuestionId": "q-c03-046",
      "parentFingerprint": "9d35f0a32f8dc977ce37c9ca734cbde50bb1ca28a00f55cb085d2807327a44c3",
      "passageSha256": "a1770e7b842dcb9c806b370da287c81236a38b1cca8dbbaef350ba8c938ba4b5",
      "pdfPages": [
        33,
        34
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c03-0058",
      "sentenceId": "c03-s06-p033-06330-s004",
      "sentenceText": "It may not be stable or comfortable, but it is exhilarating.",
      "sentenceSha256": "fa88b0d292c652892f2b3332007ae80aed32d8b8e4517a9023b2d6aa66c5a6d8",
      "readingUnitId": "c03-s06-p033-06330-r001-004",
      "parentQuestionId": "q-c03-046",
      "parentFingerprint": "9d35f0a32f8dc977ce37c9ca734cbde50bb1ca28a00f55cb085d2807327a44c3",
      "passageSha256": "a1770e7b842dcb9c806b370da287c81236a38b1cca8dbbaef350ba8c938ba4b5",
      "pdfPages": [
        33,
        34
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c03-0059",
      "sentenceId": "c03-s06-p033-06330-s005",
      "sentenceText": "It may not be filled with contentment, but it is dramatic.",
      "sentenceSha256": "06ffd6769180c1a0a521dad0141dc1ca9b1eddf1891403d27f6b4f74a250fc1a",
      "readingUnitId": "c03-s06-p033-06330-r005-007",
      "parentQuestionId": "q-c03-047",
      "parentFingerprint": "d60cb27100096f0fa22949b624233c4eb9ff28175614bf8eaa546004377492eb",
      "passageSha256": "c72ed2f64a374170833dd76b52f953f93de40a214b62c1a27cad362af3e93b30",
      "pdfPages": [
        34
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c04-0001",
      "sentenceId": "c04-s01-p035-03458-s001",
      "sentenceText": "So far, I have told you some secrets to happiness and meaning in life.",
      "sentenceSha256": "77e655ea5e0450ea9530b28a523c2c4dcc972b5247e9ad88947d8a60996de516",
      "readingUnitId": "c04-s01-p035-03458-r001-004",
      "parentQuestionId": "q-c04-001",
      "parentFingerprint": "b1d7e2eae65f317fc1d9b21a7611ab7630857672e8b913da109e228670c5042f",
      "passageSha256": "5f868c23fd8d2f8642ec6ffbc0866df1225be22ee31012d793486d967fd8a498",
      "pdfPages": [
        35
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c04-0002",
      "sentenceId": "c04-s01-p035-03458-s002",
      "sentenceText": "It isn’t big wins that bring happiness, but rather the small joys in life, like having tea with your best friend.",
      "sentenceSha256": "03d136c32bbc586b0d79bfafbbace155e534adf7224540274ed70da4a4193cbc",
      "readingUnitId": "c04-s01-p035-03458-r001-004",
      "parentQuestionId": "q-c04-001",
      "parentFingerprint": "b1d7e2eae65f317fc1d9b21a7611ab7630857672e8b913da109e228670c5042f",
      "passageSha256": "5f868c23fd8d2f8642ec6ffbc0866df1225be22ee31012d793486d967fd8a498",
      "pdfPages": [
        35
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c04-0003",
      "sentenceId": "c04-s01-p035-03458-s004",
      "sentenceText": "Similarly, meaning in life comes from dedication to a particular cause you care about dearly and making a difference in that chosen realm.",
      "sentenceSha256": "5f7e8ac7b8f04b931cbc558a7a8459030ff8ee260e10720b10bee5fffb9f082a",
      "readingUnitId": "c04-s01-p035-03458-r001-004",
      "parentQuestionId": "q-c04-001",
      "parentFingerprint": "b1d7e2eae65f317fc1d9b21a7611ab7630857672e8b913da109e228670c5042f",
      "passageSha256": "5f868c23fd8d2f8642ec6ffbc0866df1225be22ee31012d793486d967fd8a498",
      "pdfPages": [
        35
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c04-0004",
      "sentenceId": "c04-s01-p035-03458-s005",
      "sentenceText": "Overall, a life of stability, rather than a life of exploration and change, gets you closer to happiness and meaning in life.",
      "sentenceSha256": "90f2bbc88ee1be8a509c0f86e02b6f338a5ec4bf5c3df14bf4565b7a1d7326f2",
      "readingUnitId": "c04-s01-p035-03458-r005-006",
      "parentQuestionId": "q-c04-002",
      "parentFingerprint": "ceab3cfcd2689d834be58163ca21d9315d57f7942c7ae43186a4c5ef454c517e",
      "passageSha256": "4670216db42c2a3321817eef5f4de23454c6045ade4ffda67d809e5a7976ae83",
      "pdfPages": [
        35
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c04-0005",
      "sentenceId": "c04-s01-p035-05212-s001",
      "sentenceText": "Hermann Hesse, one of the most influential German novelists of the twentieth century and the 1946 Nobel laureate, depicted memorable characters struggling to find a path to the good life in several novels.",
      "sentenceSha256": "318d97bd0a187201469d12f4adaf9e3e2ccb149d777745c6cfd6c2db9f1e5950",
      "readingUnitId": "c04-s01-p035-05212-r001-004",
      "parentQuestionId": "q-c04-003",
      "parentFingerprint": "1dbf25996b44352152b5740de65c1e44947d042b01d0143363ab16976cb3ac94",
      "passageSha256": "69b7276a42304c5a990c33175ca684ded2fbe408af16b36b001f887f0631f7c6",
      "pdfPages": [
        35
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c04-0006",
      "sentenceId": "c04-s01-p035-05212-s002",
      "sentenceText": "Narcissus and Goldmund is one of the most popular Hesse novels, which also became a feature film in 2020.",
      "sentenceSha256": "e35c5b47e8ef0dff039802a553c28bb35f2e148350c6cec9eda760d33ec667a7",
      "readingUnitId": "c04-s01-p035-05212-r001-004",
      "parentQuestionId": "q-c04-003",
      "parentFingerprint": "1dbf25996b44352152b5740de65c1e44947d042b01d0143363ab16976cb3ac94",
      "passageSha256": "69b7276a42304c5a990c33175ca684ded2fbe408af16b36b001f887f0631f7c6",
      "pdfPages": [
        35
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c04-0007",
      "sentenceId": "c04-s01-p035-05212-s004",
      "sentenceText": "He is smart and popular.",
      "sentenceSha256": "a258c059d24e25d8cd01c5a22eff650c90d705a5f79f4c8b3071cd6d666a438b",
      "readingUnitId": "c04-s01-p035-05212-r001-004",
      "parentQuestionId": "q-c04-003",
      "parentFingerprint": "1dbf25996b44352152b5740de65c1e44947d042b01d0143363ab16976cb3ac94",
      "passageSha256": "69b7276a42304c5a990c33175ca684ded2fbe408af16b36b001f887f0631f7c6",
      "pdfPages": [
        35
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c04-0008",
      "sentenceId": "c04-s01-p035-05212-s005",
      "sentenceText": "He is happy with his cloistered life and finds his simple, religious life very meaningful.",
      "sentenceSha256": "d7289323a18e3db6da689d7f51c282370abddc44d4f3c648a81c0b8c4243aeba",
      "readingUnitId": "c04-s01-p035-05212-r005-007",
      "parentQuestionId": "q-c04-004",
      "parentFingerprint": "96cb733bcc7f76c5cd199d519edd096e04186582f45ffb3435d6b85604808d10",
      "passageSha256": "f599fd16c62e42694e4d6d8674336a9cbc22cee90b03f20971a36f42fb403e32",
      "pdfPages": [
        35
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c04-0009",
      "sentenceId": "c04-s01-p035-05212-s006",
      "sentenceText": "Narcissus becomes a well-respected Aristotelian scholar and the head of his monastery.",
      "sentenceSha256": "c367f6c809b0ec73c8d2c622e8bf2f1cca9c8d7ceadb05503efa02df15bcb450",
      "readingUnitId": "c04-s01-p035-05212-r005-007",
      "parentQuestionId": "q-c04-004",
      "parentFingerprint": "96cb733bcc7f76c5cd199d519edd096e04186582f45ffb3435d6b85604808d10",
      "passageSha256": "f599fd16c62e42694e4d6d8674336a9cbc22cee90b03f20971a36f42fb403e32",
      "pdfPages": [
        35
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c04-0010",
      "sentenceId": "c04-s01-p036-00750-s001",
      "sentenceText": "Meanwhile, his childhood friend Goldmund yearns for a life outside the cloister and decides to lead the life of a vagabond artist, lacking food, shelter, and stable companions.",
      "sentenceSha256": "e0230748a3bbd62e6943a7ff9dd9837d804d7dac5af1460489b12b01c6c5f0ba",
      "readingUnitId": "c04-s01-p036-00750-r001-004",
      "parentQuestionId": "q-c04-005",
      "parentFingerprint": "7a2c019267b0134f3c41e3c66541256e70f0ba2fc830270e991b991244712974",
      "passageSha256": "e1bf5e952c2d04272571d9841a8ac954f7fe00b11cd2f2fc5ae0148e613150fd",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c04-0011",
      "sentenceId": "c04-s01-p036-00750-s004",
      "sentenceText": "Was it worth experiencing?”",
      "sentenceSha256": "4da30d9e29c059d12f1660cda3276df281955bfccb8c2593f01d20732d87ce6a",
      "readingUnitId": "c04-s01-p036-00750-r001-004",
      "parentQuestionId": "q-c04-005",
      "parentFingerprint": "7a2c019267b0134f3c41e3c66541256e70f0ba2fc830270e991b991244712974",
      "passageSha256": "e1bf5e952c2d04272571d9841a8ac954f7fe00b11cd2f2fc5ae0148e613150fd",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c04-0012",
      "sentenceId": "c04-s01-p036-00750-s005",
      "sentenceText": "Unlike Narcissus, Goldmund often feels guilty, unhappy, and as if his life is meaningless.",
      "sentenceSha256": "7fe807aee70359aebc8cf0b03da5b85acdb6670e8729822e53de831446d693c3",
      "readingUnitId": "c04-s01-p036-00750-r005-006",
      "parentQuestionId": "q-c04-006",
      "parentFingerprint": "27eaaccf3bab3d5fbfbe04c7f6ec86f060de28bc76157fbc4fbf36d385b88557",
      "passageSha256": "c290851fe5d630080b5ddae065b437634e1759254a46cb9d657ce3dd13de2feb",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c04-0013",
      "sentenceId": "c04-s01-p036-02505-s001",
      "sentenceText": "At the end of the novel, it is Narcissus who wonders if his happy and meaningful life was lacking something.",
      "sentenceSha256": "76f20e23f2fafe877e6094976e69c80b8902e27d44d49dea0b66d685e716713e",
      "readingUnitId": "c04-s01-p036-02505-r001-004",
      "parentQuestionId": "q-c04-007",
      "parentFingerprint": "cc1a0de102690dc8d43b6b7f9606853aae801b83981edbe8527653174db0ff80",
      "passageSha256": "32c748fb078e5fa6c60f5981340fef7f3d5e5ed3cd6d0b70289c1ab2536b7639",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c04-0014",
      "sentenceId": "c04-s01-p036-02505-s002",
      "sentenceText": "Narcissus knows that those who remained in the cloister view his life as far “better, righter, steadier, more orderly, and more exemplary” than Goldmund’s life of exploration and moral digression.",
      "sentenceSha256": "c8a8da38ffc317869f12dd6f10a9c711dcd2de8f325dcf0b308bd55809c7533d",
      "readingUnitId": "c04-s01-p036-02505-r001-004",
      "parentQuestionId": "q-c04-007",
      "parentFingerprint": "cc1a0de102690dc8d43b6b7f9606853aae801b83981edbe8527653174db0ff80",
      "passageSha256": "32c748fb078e5fa6c60f5981340fef7f3d5e5ed3cd6d0b70289c1ab2536b7639",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c04-0015",
      "sentenceId": "c04-s01-p036-02505-s005",
      "sentenceText": "His life is happy and meaningful but utterly missing experiential richness.",
      "sentenceSha256": "b34660d8ef0e3b372bae0bdf849f1e4402824a202fd7d071abebb5e0aea5ec33",
      "readingUnitId": "c04-s01-p036-02505-r005-008",
      "parentQuestionId": "q-c04-008",
      "parentFingerprint": "390ac634078a1678f0fc21e724a3a78598ad78aff87b2bf4aa182cb1795a5048",
      "passageSha256": "3625e32ad4bc6e1f5beaff3150480da3efcbd0be4d52c4905982b0b1ede594ba",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c04-0016",
      "sentenceId": "c04-s01-p036-02505-s006",
      "sentenceText": "By contrast, Goldmund’s life is hard, but spontaneous, creative, and unpredictable: a psychologically rich life.",
      "sentenceSha256": "b120363102cc7e673d5063c5224f940d080ffaf7c6dfef0b9c2ec38c606f1eaa",
      "readingUnitId": "c04-s01-p036-02505-r005-008",
      "parentQuestionId": "q-c04-008",
      "parentFingerprint": "390ac634078a1678f0fc21e724a3a78598ad78aff87b2bf4aa182cb1795a5048",
      "passageSha256": "3625e32ad4bc6e1f5beaff3150480da3efcbd0be4d52c4905982b0b1ede594ba",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c04-0017",
      "sentenceId": "c04-s01-p036-02505-s008",
      "sentenceText": "Which life would you choose?",
      "sentenceSha256": "95590a8c9d1542f3aa5ba60f5708a6a0ced6f11e47fc8f1e73d96938502ab9af",
      "readingUnitId": "c04-s01-p036-02505-r005-008",
      "parentQuestionId": "q-c04-008",
      "parentFingerprint": "390ac634078a1678f0fc21e724a3a78598ad78aff87b2bf4aa182cb1795a5048",
      "passageSha256": "3625e32ad4bc6e1f5beaff3150480da3efcbd0be4d52c4905982b0b1ede594ba",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c04-0018",
      "sentenceId": "c04-s02-p036-05160-s001",
      "sentenceText": "Hesse is not the only author to suggest the importance of exploration.",
      "sentenceSha256": "b31fbe660ff369abe46cc9e4a883a1bb1f6a65b1238ca7e5638057832410f3c8",
      "readingUnitId": "c04-s02-p036-05160-r001-004",
      "parentQuestionId": "q-c04-009",
      "parentFingerprint": "15bd3631a61cdafeeafbab440ee8ee80f38e4c498fd1dfe5ebc902b6300f2364",
      "passageSha256": "b67afc8774d286cb0fcc4adb10c5e558521ab5968d0557b5aaf5d013ed1ab386",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c04-0019",
      "sentenceId": "c04-s02-p036-05160-s002",
      "sentenceText": "As with Narcissus and Goldmund, at the core of Søren Kierkegaard’s Either/Or is this dilemma: Should we pursue an aesthetic life or a virtuous life?",
      "sentenceSha256": "a86a1c7ba2113cf2663b28bd162937eaa98cda39acfff90273986720af916e6b",
      "readingUnitId": "c04-s02-p036-05160-r001-004",
      "parentQuestionId": "q-c04-009",
      "parentFingerprint": "15bd3631a61cdafeeafbab440ee8ee80f38e4c498fd1dfe5ebc902b6300f2364",
      "passageSha256": "b67afc8774d286cb0fcc4adb10c5e558521ab5968d0557b5aaf5d013ed1ab386",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c04-0020",
      "sentenceId": "c04-s02-p036-05160-s004",
      "sentenceText": "A promotes an aesthetic life, or the life of beauty and adventure.",
      "sentenceSha256": "7ada5d90b6048663f2d4bba2958358ea1bbab2f9aa7059364d71ef432281c7d0",
      "readingUnitId": "c04-s02-p036-05160-r001-004",
      "parentQuestionId": "q-c04-009",
      "parentFingerprint": "15bd3631a61cdafeeafbab440ee8ee80f38e4c498fd1dfe5ebc902b6300f2364",
      "passageSha256": "b67afc8774d286cb0fcc4adb10c5e558521ab5968d0557b5aaf5d013ed1ab386",
      "pdfPages": [
        36
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c04-0021",
      "sentenceId": "c04-s02-p036-05160-s005",
      "sentenceText": "He argues that spontaneity and acceptance of arbitrariness are the keys to this life.",
      "sentenceSha256": "a46f14af06439bcc983ca31efcd975d7bc5df0b8e403901a04855a318d1d751e",
      "readingUnitId": "c04-s02-p036-05160-r005-008",
      "parentQuestionId": "q-c04-010",
      "parentFingerprint": "fa1dc6c97ea1851be338b0d01d3fbf21a16693053a8c0202299a8d8da051726a",
      "passageSha256": "987a64d6afb0a2eedd2507b85e75b4e200b066dbdc76f7755219544f2c3e3294",
      "pdfPages": [
        36,
        37
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c04-0022",
      "sentenceId": "c04-s02-p036-05160-s008",
      "sentenceText": "Unsurprisingly, A is against marriage, characterizing it as fearful monotony, perpetual sameness, and dreadful stillness.",
      "sentenceSha256": "aa25e94fee78c4bb210f8c2d9f0db85f3712d45aaddfdde7b2cf5053fe6a25b4",
      "readingUnitId": "c04-s02-p036-05160-r005-008",
