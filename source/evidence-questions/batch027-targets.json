      "questionId": "qe-c07-0093",
      "sentenceId": "c07-s05-p076-01725-s001",
      "sentenceText": "Of course, we could act spontaneously by ourselves.",
      "sentenceSha256": "222bb27dccb2cad075cb439f7644135b6eb2847f38c03319c6b352284d606d81",
      "readingUnitId": "c07-s05-p076-01725-r001-004",
