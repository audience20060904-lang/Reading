    },
    {
      "order": 20,
      "questionId": "qe-c07-0102",
      "sentenceId": "c07-s06-p076-05355-s002",
      "sentenceText": "As a researcher, I try to stay up to date on the latest literature, statistics, data visualization, and so forth.",
      "sentenceSha256": "d8c0ba965d5ce0ca0d6a2667d9d86076b66f468e21b6bdadefec333dc1321675",
