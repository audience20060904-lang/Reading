    },
    {
      "order": 19,
      "questionId": "qe-c07-0101",
      "sentenceId": "c07-s06-p076-05355-s001",
      "sentenceText": "Most of us strive to become better at what we do for a living.",
      "sentenceSha256": "38383570bf2e2506497d8d7dac9fc00666a1fa08138a81428b415813a10a2072",
      "readingUnitId": "c07-s06-p076-05355-r001-004",
