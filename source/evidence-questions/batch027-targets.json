      "pdfPages": [
        76
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c07-0100",
      "sentenceId": "c07-s05-p076-01725-s011",
      "sentenceText": "We can and should be like Moritz once in a while.",
      "sentenceSha256": "9d4ce658dd0e309ff44952ae6db9767633ef9bc998e4e3cdec50dc9c268d59c2",
      "readingUnitId": "c07-s05-p076-01725-r008-011",
      "parentQuestionId": "q-c07-059",
      "parentFingerprint": "ca9aa98b87759ceaa7ac8783581d303d115689ca9a3c9581f6b616b736c60d7e",
      "passageSha256": "22e3b616e3d3ce8f40708f2fcf477f583887caa831b9df3fd1794713e53933e2",
      "pdfPages": [
        76
