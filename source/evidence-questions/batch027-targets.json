        75
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c07-0088",
      "sentenceId": "c07-s05-p075-04770-s001",
      "sentenceText": "In the essay “Why Is It Hard to Make Friends Over 30?”",
      "sentenceSha256": "36267beda9c7f7d912b05f9b35105d3afa13053c871363ae8e3b1d2f99eab031",
      "readingUnitId": "c07-s05-p075-04770-r001-004",
