    },
    {
      "order": 2,
      "questionId": "qe-c10-0104",
      "sentenceId": "c10-s07-p113-03210-s002",
      "sentenceText": "For instance, have you wondered why American cities and suburbs look alike?",
      "sentenceSha256": "695ffb08740649bee1f0dedbac5461ec7b14b0b660dc68dd980b17d8408359b5",
      "readingUnitId": "c10-s07-p113-03210-r001-004",
      "parentQuestionId": "q-c10-060",
      "parentFingerprint": "67ddd6e79b03cdc4fc0f6c4cc00358236e6a993da94aa28eb7b90425dbd0fed1",
      "passageSha256": "0f9414c6c4a3eb227cb3fc911afd54739cdf74db6888f0f7b6a3953f438f08d7",
      "pdfPages": [
        113
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c10-0105",
      "sentenceId": "c10-s07-p113-03210-s003",
      "sentenceText": "When I first went to a large shopping mall in Staten Island, New York, I was impressed by the size and number of stores.",
      "sentenceSha256": "3d05a0ca894f19c752003834a37f87359accc6f29706d4be15e8bb709f9028b5",
      "readingUnitId": "c10-s07-p113-03210-r001-004",
      "parentQuestionId": "q-c10-060",
      "parentFingerprint": "67ddd6e79b03cdc4fc0f6c4cc00358236e6a993da94aa28eb7b90425dbd0fed1",
      "passageSha256": "0f9414c6c4a3eb227cb3fc911afd54739cdf74db6888f0f7b6a3953f438f08d7",
      "pdfPages": [
        113
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c10-0106",
      "sentenceId": "c10-s07-p113-03210-s004",
      "sentenceText": "When I later went to a medium-sized shopping mall in a suburb of Portland, Maine, I was puzzled.",
      "sentenceSha256": "0d5925909a14c1eea7c985571fa8cd86816f88edb398071fb7b3599300c9f9ef",
      "readingUnitId": "c10-s07-p113-03210-r001-004",
      "parentQuestionId": "q-c10-060",
      "parentFingerprint": "67ddd6e79b03cdc4fc0f6c4cc00358236e6a993da94aa28eb7b90425dbd0fed1",
      "passageSha256": "0f9414c6c4a3eb227cb3fc911afd54739cdf74db6888f0f7b6a3953f438f08d7",
      "pdfPages": [
        113
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c10-0107",
      "sentenceId": "c10-s07-p113-04575-s001",
      "sentenceText": "As a graduate student, I started going to psychology conferences in various cities around the U.S. and experienced a similar feeling.",
      "sentenceSha256": "49d5a6837dff53b37e6bd089c551dda4ff2d6b6dc9420fc5e10d5286c7484023",
      "readingUnitId": "c10-s07-p113-04575-r001-004",
      "parentQuestionId": "q-c10-062",
      "parentFingerprint": "e4ee6c217a03d00b6e2a3c91de61ba636dff6828355acec1da61cf46d4025487",
      "passageSha256": "79a4704de68c3970ead40f1175108f602e9ed735bce0192bb90cc823c8656920",
      "pdfPages": [
        113
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c10-0108",
      "sentenceId": "c10-s07-p113-04575-s002",
      "sentenceText": "I would fly into a large airport, which was usually located in a faraway suburb of a major city.",
      "sentenceSha256": "77ae937b50a17e304ad90bad52241c589d7f314222b0525fd391e7f482bffc5a",
      "readingUnitId": "c10-s07-p113-04575-r001-004",
      "parentQuestionId": "q-c10-062",
      "parentFingerprint": "e4ee6c217a03d00b6e2a3c91de61ba636dff6828355acec1da61cf46d4025487",
      "passageSha256": "79a4704de68c3970ead40f1175108f602e9ed735bce0192bb90cc823c8656920",
      "pdfPages": [
        113
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c10-0109",
      "sentenceId": "c10-s07-p113-04575-s004",
      "sentenceText": "Why do all these cities look alike?",
      "sentenceSha256": "e681c5b02d77367163b3f55eb6c25205c4490737ed01ec70be776b0bd9a4098b",
      "readingUnitId": "c10-s07-p113-04575-r001-004",
      "parentQuestionId": "q-c10-062",
      "parentFingerprint": "e4ee6c217a03d00b6e2a3c91de61ba636dff6828355acec1da61cf46d4025487",
      "passageSha256": "79a4704de68c3970ead40f1175108f602e9ed735bce0192bb90cc823c8656920",
      "pdfPages": [
        113
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c10-0110",
      "sentenceId": "c10-s07-p113-04575-s005",
      "sentenceText": "This was not the case in Japan: Tokyo and Osaka are both large cities with many high-rise buildings and large train stations.",
      "sentenceSha256": "fec89f614261d2271b011458d2a266fab3a071e4cfc9071eb3947634ea9860bf",
      "readingUnitId": "c10-s07-p113-04575-r005-007",
      "parentQuestionId": "q-c10-063",
      "parentFingerprint": "abace8ec532eda796796a4b091595d2e25e7d7f7fc6ce0ddf8f3fd9e351c9370",
      "passageSha256": "ba6562891c2da75883e947cb1d09dca916a29322a77cfcc69709799491c05bde",
      "pdfPages": [
        113
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c10-0111",
      "sentenceId": "c10-s07-p113-04575-s007",
      "sentenceText": "In American suburbs, whether you’re outside of New York or LA, you can expect to see the same stores, like Target and Whole Foods, and the same restaurants, like the Cheesecake Factory and Panera.",
      "sentenceSha256": "af4f23eaea6e7ca47bd2335426479eecda3396e945d0449b660b064cc0a7a9c9",
      "readingUnitId": "c10-s07-p113-04575-r005-007",
      "parentQuestionId": "q-c10-063",
      "parentFingerprint": "abace8ec532eda796796a4b091595d2e25e7d7f7fc6ce0ddf8f3fd9e351c9370",
      "passageSha256": "ba6562891c2da75883e947cb1d09dca916a29322a77cfcc69709799491c05bde",
      "pdfPages": [
        113
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c10-0112",
      "sentenceId": "c10-s07-p114-00750-s001",
      "sentenceText": "When I was in Charlottesville, I would go to a local coffee shop every day and never went to Starbucks.",
      "sentenceSha256": "ce463aa0e0527faf3a8f64621cddcb25e6b4293bb7b2c214bf9e5ceb20e8898a",
      "readingUnitId": "c10-s07-p114-00750-r001-004",
      "parentQuestionId": "q-c10-064",
      "parentFingerprint": "1ba685c3f7c6a76c572eb5c35f822cc76cc5c1f96f7265e8f5cc7242de02672e",
      "passageSha256": "aed7ae8efd9a8ff59754ad919642cd0480692a8c08bc390264eea2cf76f8cf36",
      "pdfPages": [
        114
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c10-0113",
      "sentenceId": "c10-s07-p114-00750-s003",
      "sentenceText": "When I was in the psychology building (Gilmer Hall) in Charlottesville and saw a graduate student walking by, I would greet them with a very curt “hey.”",
      "sentenceSha256": "727bda383b715762ad8364a1724e3888b5408c0663763eb8b02d414e5d609ea1",
      "readingUnitId": "c10-s07-p114-00750-r001-004",
      "parentQuestionId": "q-c10-064",
      "parentFingerprint": "1ba685c3f7c6a76c572eb5c35f822cc76cc5c1f96f7265e8f5cc7242de02672e",
      "passageSha256": "aed7ae8efd9a8ff59754ad919642cd0480692a8c08bc390264eea2cf76f8cf36",
      "pdfPages": [
        114
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c10-0114",
      "sentenceId": "c10-s07-p114-00750-s005",
      "sentenceText": "and almost hugged him.",
      "sentenceSha256": "6710d8a8cc2da6cedbedd5eb3182224916432291122a3b70f48bae4ff802812b",
      "readingUnitId": "c10-s07-p114-00750-r001-004",
      "parentQuestionId": "q-c10-064",
      "parentFingerprint": "1ba685c3f7c6a76c572eb5c35f822cc76cc5c1f96f7265e8f5cc7242de02672e",
      "passageSha256": "aed7ae8efd9a8ff59754ad919642cd0480692a8c08bc390264eea2cf76f8cf36",
      "pdfPages": [
        114
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c10-0115",
      "sentenceId": "c10-s07-p114-00750-s006",
      "sentenceText": "Would I ever hug him in Gilmer Hall?",
      "sentenceSha256": "4bb5c48d08b91339e9588c59acd3cdcdd5215d8bf189e5128a3cffc4ce6ce705",
      "readingUnitId": "c10-s07-p114-00750-r005-008",
      "parentQuestionId": "q-c10-065",
      "parentFingerprint": "d405d6d938e5f744108b4748132c0e436eaa089fc01eac9d73dfdd4bb82dc57f",
      "passageSha256": "0d43268a0face8c9c8831dd9759741d73f20f77c8634f1ab33088e97121a33ca",
      "pdfPages": [
        114
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c10-0116",
      "sentenceId": "c10-s07-p114-00750-s007",
      "sentenceText": "No chance.",
      "sentenceSha256": "c30b55f6c04ebd74b77054d8e3e8ac9f3aeeb7554b4135e501c489a9bcb94076",
      "readingUnitId": "c10-s07-p114-00750-r005-008",
      "parentQuestionId": "q-c10-065",
      "parentFingerprint": "d405d6d938e5f744108b4748132c0e436eaa089fc01eac9d73dfdd4bb82dc57f",
      "passageSha256": "0d43268a0face8c9c8831dd9759741d73f20f77c8634f1ab33088e97121a33ca",
      "pdfPages": [
        114
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c10-0117",
      "sentenceId": "c10-s07-p114-02700-s002",
      "sentenceText": "We tested whether there were more national chain stores such as Chili’s, Whole Foods, and Payless Shoes in mobile states such as Nevada and Florida than in stable states such as Pennsylvania and West Virginia.",
      "sentenceSha256": "a36558a5a7e8a63be5507f0f9c58dd9bb10e72aa9850f6b8429f0047a659e0a0",
      "readingUnitId": "c10-s07-p114-02700-r002-004",
      "parentQuestionId": "q-c10-068",
      "parentFingerprint": "1679ace32fd09be5fb28dbc8e706a2f0170799a733a8e25f18eb63c5f4ae6b4a",
      "passageSha256": "51e3ae98f0043ebcde1c76c1afba0d8feeac5ca6069533b646942833a4ab0888",
      "pdfPages": [
        114
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c10-0118",
      "sentenceId": "c10-s07-p114-02700-s004",
      "sentenceText": "If so, national chain stores should be more popular in U.S. states where there are a lot of newcomers, such as Nevada and Florida.",
      "sentenceSha256": "e97a0c469db5c9c6bd2e11cf526a5353b82f2009e1b1a294c7894fb92d220a05",
      "readingUnitId": "c10-s07-p114-02700-r002-004",
      "parentQuestionId": "q-c10-068",
      "parentFingerprint": "1679ace32fd09be5fb28dbc8e706a2f0170799a733a8e25f18eb63c5f4ae6b4a",
      "passageSha256": "51e3ae98f0043ebcde1c76c1afba0d8feeac5ca6069533b646942833a4ab0888",
      "pdfPages": [
        114
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c10-0119",
      "sentenceId": "c10-s07-p114-02700-s005",
      "sentenceText": "Sure enough, there are more national chain stores in mobile states than in stable states.",
      "sentenceSha256": "9b04fd281169a8ebde229f8dafd90ddf9990cd7149905ee64e775182931cce5e",
      "readingUnitId": "c10-s07-p114-02700-r005-006",
      "parentQuestionId": "q-c10-069",
      "parentFingerprint": "c60324ced1f75c3f23d7cdba7709ca21eae3be9b1d2a97a743a1a5fbf1bb41c6",
      "passageSha256": "6450a518e0c639357c3abbbe4deafc5e3e4b4d80b89c9c338d6cf4a4024a2b0d",
      "pdfPages": [
        114
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c10-0120",
      "sentenceId": "c10-s07-p115-01140-s001",
      "sentenceText": "In all three conditions, we observed the mere exposure effect, replicating the earlier findings.",
      "sentenceSha256": "510ce067e7ca487b83ca75e515e12f890b583fb7c3c79d235ca9588b4f632a50",
      "readingUnitId": "c10-s07-p115-01140-r001-003",
      "parentQuestionId": "q-c10-073",
      "parentFingerprint": "ed52185500ca65f13af8df5827a5a23cef81cc701be28c501f70504a96f463a3",
      "passageSha256": "9da2e0334c3e8fb7c849b530be4a9e348489acee365835467bcb15ed1bce0ff6",
      "pdfPages": [
        115
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c10-0121",
      "sentenceId": "c10-s07-p115-01140-s003",
      "sentenceText": "That is, when they thought about moving around frequently in the future, they liked a familiar Chinese character or a familiar face more than when they thought about staying in one place for a long time or about a typical day.",
      "sentenceSha256": "47a2a80085ad7c198100a6e81679239345b29affa0908ac38168c18040a4191f",
      "readingUnitId": "c10-s07-p115-01140-r001-003",
      "parentQuestionId": "q-c10-073",
      "parentFingerprint": "ed52185500ca65f13af8df5827a5a23cef81cc701be28c501f70504a96f463a3",
      "passageSha256": "9da2e0334c3e8fb7c849b530be4a9e348489acee365835467bcb15ed1bce0ff6",
      "pdfPages": [
        115
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c10-0122",
      "sentenceId": "c10-s07-p115-01140-s005",
      "sentenceText": "In other words, stress and anxiety amplify our tendency to like a familiar object.",
      "sentenceSha256": "6e4475bf9fa299c59d9177a1c0fd6a970b99d7b2f494cb33f8704d94a186ec82",
      "readingUnitId": "c10-s07-p115-01140-r004-005",
      "parentQuestionId": "q-c10-074",
      "parentFingerprint": "9cdad90965f3939244a9ca8d9aaad8d8745095fa27024488f563d31d782ba7f1",
      "passageSha256": "d918daa14cd274eec178c6cca1f5e45b0c15b59d9af9f90964094e98a57a92e7",
      "pdfPages": [
        115
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c10-0123",
      "sentenceId": "c10-s07-p115-03285-s001",
      "sentenceText": "The mere exposure effect is a replicable phenomenon and fun to read about.",
      "sentenceSha256": "1d96ba5d130a12a583b4184ab9c41fc1315837e7312c9c6d8340c6b9594d8816",
      "readingUnitId": "c10-s07-p115-03285-r001-004",
      "parentQuestionId": "q-c10-075",
      "parentFingerprint": "6ad38824d822e298350d220fa016d3fdf1aff301549bad2e7a8e23f2af705fb0",
      "passageSha256": "3d7c6201967f241006ebe6a827026617521c52e1b8ce3aecc7057b74029f2024",
      "pdfPages": [
        115
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c10-0124",
      "sentenceId": "c10-s07-p115-03285-s003",
      "sentenceText": "What about the secretary problem as it applies to finding a partner?",
      "sentenceSha256": "158a5d6ae7d3fff8dde40748a4d5a2cac6e29db9559c2979e838a855c4e5da9e",
      "readingUnitId": "c10-s07-p115-03285-r001-004",
      "parentQuestionId": "q-c10-075",
      "parentFingerprint": "6ad38824d822e298350d220fa016d3fdf1aff301549bad2e7a8e23f2af705fb0",
      "passageSha256": "3d7c6201967f241006ebe6a827026617521c52e1b8ce3aecc7057b74029f2024",
      "pdfPages": [
        115
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c10-0125",
      "sentenceId": "c10-s07-p115-03285-s005",
      "sentenceText": "You are supposed to seriously consider a dozen potential mates if you want to have a really good partner.",
      "sentenceSha256": "899a02b33097423d57f9fe8d01286038172fcab80fe8783d0e04e8ce409f8b67",
      "readingUnitId": "c10-s07-p115-03285-r005-008",
      "parentQuestionId": "q-c10-076",
      "parentFingerprint": "bc3dadf9c16b81f413f46324db000e90eec29a4107f172ece827ddc53acb0ebd",
      "passageSha256": "347d8e813b8d8abdb59889d0a5468caf7c0c8ad9ec71e3ac6bf3328a330b01fb",
      "pdfPages": [
        115
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c10-0126",
      "sentenceId": "c10-s07-p115-03285-s006",
      "sentenceText": "These are stressful processes.",
      "sentenceSha256": "fd29a466534d91e6b5253f87be2765697419ca3b6a84d38ceaaed31a6c0bb875",
      "readingUnitId": "c10-s07-p115-03285-r005-008",
