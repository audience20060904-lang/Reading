      "sentenceId": "c06-s07-p066-04455-s010",
      "sentenceText": "Keep on reading!",
      "sentenceSha256": "e5349fd7ce1fed0f9d2f53faab7577f111c97fb4d450c48d0f1a07bd70ea5289",
      "readingUnitId": "c06-s07-p066-04455-r007-010",
