      "pdfPages": [
        66
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c06-0147",
      "sentenceId": "c06-s07-p066-02505-s001",
      "sentenceText": "Who is happy?",
      "sentenceSha256": "ae67f06889a99c864edd38e7cd854b288f8dca4415078afc89d48001109855cf",
      "readingUnitId": "c06-s07-p066-02505-r001-003",
      "parentQuestionId": "q-c06-087",
      "parentFingerprint": "5d475893b265e217aa665d7aea29b34827c88d1a010446f3a0c2753e42d4d461",
      "passageSha256": "0c7840f3e8dea725db1f9c1573366b488ee0382057a205e484906d04133d4934",
      "pdfPages": [
        66
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c06-0148",
      "sentenceId": "c06-s07-p066-03675-s001",
      "sentenceText": "Finally, who leads a meaningful life?",
      "sentenceSha256": "970fa3827be3a90f6ee164ba4d551f7743d581e383078ac35c26403a85799ff3",
      "readingUnitId": "c06-s07-p066-03675-r001-002",
      "parentQuestionId": "q-c06-088",
      "parentFingerprint": "6b50e0e6a02619cfc030cc34594577a91df3b8e9d5afe5f8ac9f7ca158e11c60",
      "passageSha256": "5ad03c9e808bbffd3a71682eb506f81d9d1e6b4e0978dd6ce9d748a7b13dd0e3",
      "pdfPages": [
        66
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c06-0149",
      "sentenceId": "c06-s07-p066-04455-s001",
      "sentenceText": "In short, openness to experiences represents the most striking difference between the personality correlates of a psychologically rich life and those of a happy and meaningful life.",
      "sentenceSha256": "a2f8f9dfb5fc4ab2dce359de5ab50b67e6a932a04e14b1b8f346fc49fe23c423",
      "readingUnitId": "c06-s07-p066-04455-r001-003",
      "parentQuestionId": "q-c06-089",
      "parentFingerprint": "b38476484f53ce9e8f6248ab0a34d0d55dc8a1488a2a05654e41f444f38aa8ad",
      "passageSha256": "12b6b28b4c4f83750ce0f69e717aacba3d228cf9093ee25bee6b5e0898d58dfa",
      "pdfPages": [
        66
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c06-0150",
      "sentenceId": "c06-s07-p066-04455-s003",
      "sentenceText": "Personality research on psychological richness reveals that there is a path to a good life via being open to new experiences.",
      "sentenceSha256": "2797edf840265a829a837afd99b64ec41ebb3b5028606e96c7df60157322288b",
      "readingUnitId": "c06-s07-p066-04455-r001-003",
      "parentQuestionId": "q-c06-089",
      "parentFingerprint": "b38476484f53ce9e8f6248ab0a34d0d55dc8a1488a2a05654e41f444f38aa8ad",
      "passageSha256": "12b6b28b4c4f83750ce0f69e717aacba3d228cf9093ee25bee6b5e0898d58dfa",
      "pdfPages": [
        66
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c06-0151",
      "sentenceId": "c06-s07-p066-04455-s004",
      "sentenceText": "A lesson from personality psychology, then, is that it is important to know who you are (you can take a Big Five personality test on my website!).",
      "sentenceSha256": "f44c85cb27a6b9d23a823065323b918568b444ccf04260f70cd4a611a16a118b",
      "readingUnitId": "c06-s07-p066-04455-r004-006",
      "parentQuestionId": "q-c06-090",
      "parentFingerprint": "088a8aa1172e57c30fd69ad669245971325a0b063e212f05378e23fe0b4f446f",
      "passageSha256": "e8766010b289f3a576863b008e71b60a6dc436ed1d4190a810b3d197d4f2d350",
      "pdfPages": [
        66
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c06-0152",
      "sentenceId": "c06-s07-p066-04455-s005",
      "sentenceText": "It is also important to know which personality traits are associated with each dimension of a good life.",
      "sentenceSha256": "f02c82dffaa534be0756504c92fb303f4953e3f9d35b232d9d2e0ff5d32e32d5",
      "readingUnitId": "c06-s07-p066-04455-r004-006",
      "parentQuestionId": "q-c06-090",
      "parentFingerprint": "088a8aa1172e57c30fd69ad669245971325a0b063e212f05378e23fe0b4f446f",
      "passageSha256": "e8766010b289f3a576863b008e71b60a6dc436ed1d4190a810b3d197d4f2d350",
      "pdfPages": [
        66
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c06-0153",
      "sentenceId": "c06-s07-p066-04455-s009",
      "sentenceText": "Don’t give up.",
      "sentenceSha256": "b7b60ec2bfcc201326cec5337b6a849a4dc2e175a48a6f9e8465436faf117962",
      "readingUnitId": "c06-s07-p066-04455-r007-010",
