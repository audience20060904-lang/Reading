      "questionId": "qe-c09-0051",
      "sentenceId": "c09-s02-p092-05625-s011",
      "sentenceText": "Like everyone else you were born into bondage.",
      "sentenceSha256": "c19c590bdf2648399f4dd0a52d5a1ef8fe9b2db2a60a6d58304b0e46d1ae1dde",
