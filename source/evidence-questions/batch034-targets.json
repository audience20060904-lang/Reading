      "passageSha256": "fcaf8b872ece57dad41b41a7881c176526b6bd875fe6096134f7d30b1d784db5",
      "pdfPages": [
        92
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c09-0037",
      "sentenceId": "c09-s02-p092-02310-s001",
      "sentenceText": "Lastly, in order for reading and watching to be rich, it has to have some complexity and eventually change your perspective.",
      "sentenceSha256": "e2664489cce5af4b0dae617819f451abc924cd7d9fc5a16773caf57f6bd07ce4",
      "readingUnitId": "c09-s02-p092-02310-r001-003",
