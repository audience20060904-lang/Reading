      "pdfPages": [
        92
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c09-0040",
      "sentenceId": "c09-s02-p092-03285-s002",
      "sentenceText": "For me, Akira Kurosawa’s 1950 film Rashomon falls into this category of a rich aesthetic experience.",
      "sentenceSha256": "15ada4eb9cca736a50d2636e3f8bcde06765111e0269c69d751c55906ec2e0b0",
      "readingUnitId": "c09-s02-p092-03285-r001-004",
      "parentQuestionId": "q-c09-021",
      "parentFingerprint": "705784a7b53498ff1db07cb0e79d17688c5a5246d970b210e94a53f4be257820",
      "passageSha256": "92d8f4c5bf9a1b5b306fe840e3b55816b6853829c3d5f552bb29e4e261fed4f0",
      "pdfPages": [
        92
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c09-0041",
      "sentenceId": "c09-s02-p092-03285-s004",
      "sentenceText": "Each character leads the audience to believe that their version is the truth, but the next version goes on to contradict the previous one just as convincingly.",
      "sentenceSha256": "ff9204d498dba4388b30f65eaaf5106a1d79aa6fb50ffa7889f2990cd6cb72e8",
      "readingUnitId": "c09-s02-p092-03285-r001-004",
      "parentQuestionId": "q-c09-021",
      "parentFingerprint": "705784a7b53498ff1db07cb0e79d17688c5a5246d970b210e94a53f4be257820",
      "passageSha256": "92d8f4c5bf9a1b5b306fe840e3b55816b6853829c3d5f552bb29e4e261fed4f0",
      "pdfPages": [
        92
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c09-0042",
      "sentenceId": "c09-s02-p092-03285-s007",
      "sentenceText": "I found Rashomon to be a deep, interesting, and psychologically rich film.",
      "sentenceSha256": "0e8e0e422537cf63d86c3dcc190e8edc2ce83869ee6d65f215abc8fd16b21530",
      "readingUnitId": "c09-s02-p092-03285-r005-007",
