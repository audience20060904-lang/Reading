      "passageSha256": "fd84a0d32a328eb4d68d149b6ba71f565cbb9fae141414051b2886941f273cb3",
      "pdfPages": [
        92
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c09-0045",
      "sentenceId": "c09-s02-p092-05625-s004",
      "sentenceText": "It is all around us.",
      "sentenceSha256": "47a7e03a2642819e6c03d48e19e00b7c71a17ac863bea177ae8b42c48dac2990",
