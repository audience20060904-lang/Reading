        101
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c09-0139",
      "sentenceId": "c09-s05-p101-03480-s002",
      "sentenceText": "There were many moments during the playoffs when I thought it was over.",
      "sentenceSha256": "dcadceac2054c451c1315c11fcf8290cf29b2214c0b00003ac1c42ac63b0080c",
      "readingUnitId": "c09-s05-p101-03480-r001-004",
