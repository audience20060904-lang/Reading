    },
    {
      "order": 9,
      "questionId": "qe-c09-0137",
      "sentenceId": "c09-s05-p101-01335-s005",
      "sentenceText": "Phoenix had a chance to win game five, but their star forward, Charles Barkley, uncharacteristically missed both free throws toward the end of regulation and the game went into overtime.",
      "sentenceSha256": "a9e60c0db58b43c8e732dcf04fa775daaa6a1ccafcd74bf673779094c5fd1cf9",
      "readingUnitId": "c09-s05-p101-01335-r005-008",
