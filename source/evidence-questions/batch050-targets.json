  "targets": [
    {
      "order": 1,
      "questionId": "qe-c11-0057",
      "sentenceId": "c11-s03-p126-01140-s010",
      "sentenceText": "Going through something as significant as Katrina with your loved ones and friends.",
      "sentenceSha256": "7f36e80ce62992d26b7b7ed004003c64783ab3b44311e2b5d26d040a82e66cad",
      "readingUnitId": "c11-s03-p126-01140-r009-012",
      "parentQuestionId": "q-c11-028",
      "parentFingerprint": "0d11c75a90a4e000036918fb11d088a2a7d073f97a8d9fb733f0bf0d4df9bd0c",
      "passageSha256": "f02ded688f843b1dd9e14fe32f0a05b85b0edc528d31cb6ec57e4ae4b9724fe9",
      "pdfPages": [
        126
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c11-0058",
      "sentenceId": "c11-s04-p126-04575-s001",
      "sentenceText": "On January 17, 1995, a magnitude 7.3 earthquake shook Kobe and the surrounding areas of Japan.",
      "sentenceSha256": "25f8e0766a899fc6ba69b0438bc263c3efa871bc5fa3a643473747c182e67f86",
      "readingUnitId": "c11-s04-p126-04575-r001-004",
      "parentQuestionId": "q-c11-030",
      "parentFingerprint": "148025610749601937702ecaa639b4ca77a4ca4e81e5ebefe7771e302c8d7091",
      "passageSha256": "17547272bc7c06c4bbcae141c64dfa5f39457a3523b710539a78ab63aa185870",
      "pdfPages": [
        126
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c11-0059",
      "sentenceId": "c11-s04-p126-04575-s002",
      "sentenceText": "Known as the Hanshin-Awaji earthquake, its epicenter was close to downtown Kobe, a city with a population of 1.42 million people.",
      "sentenceSha256": "c82aa15fa4b1246b760aa29e31f4838fe6fb9ef1cd34f4f619706d966b210063",
      "readingUnitId": "c11-s04-p126-04575-r001-004",
      "parentQuestionId": "q-c11-030",
      "parentFingerprint": "148025610749601937702ecaa639b4ca77a4ca4e81e5ebefe7771e302c8d7091",
      "passageSha256": "17547272bc7c06c4bbcae141c64dfa5f39457a3523b710539a78ab63aa185870",
      "pdfPages": [
        126
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c11-0060",
      "sentenceId": "c11-s04-p126-04575-s003",
      "sentenceText": "Collapsed houses, ruined highways, and fires made it look like a war zone.",
      "sentenceSha256": "c43746a5c2517ff97c6bd2d688f65e66b28b49b537eda8ced52748f8749f1305",
      "readingUnitId": "c11-s04-p126-04575-r001-004",
      "parentQuestionId": "q-c11-030",
      "parentFingerprint": "148025610749601937702ecaa639b4ca77a4ca4e81e5ebefe7771e302c8d7091",
      "passageSha256": "17547272bc7c06c4bbcae141c64dfa5f39457a3523b710539a78ab63aa185870",
      "pdfPages": [
        126
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c11-0061",
      "sentenceId": "c11-s04-p126-04575-s006",
      "sentenceText": "So this earthquake surprised and devastated Kobe residents.",
      "sentenceSha256": "7537692adb8b37c5c9ae22f17fb2d1636d47a4d1110cc71b46f1f8b897a5dbc0",
      "readingUnitId": "c11-s04-p126-04575-r005-006",
      "parentQuestionId": "q-c11-031",
      "parentFingerprint": "293fe682a5aec25dbd8dc0ad30807c0e9fc178b4578680f5f085daace2d603e3",
      "passageSha256": "bd6d696a36e8d4eb564318a69b85fd171017a98c31f07201ede11c09af0c20de",
      "pdfPages": [
        126
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c11-0062",
      "sentenceId": "c11-s04-p126-06135-s001",
      "sentenceText": "How deep are the psychological scars that these experiences leave?",
      "sentenceSha256": "a6aca5102bcadae01b92b916cdccb4f92698b216916383ae7cc2532ed7c0cf0a",
      "readingUnitId": "c11-s04-p126-06135-r001-004",
      "parentQuestionId": "q-c11-032",
      "parentFingerprint": "9427957eb2234016daef4144e37be48afd01b64bd857576f6cbca6711c7c7c02",
      "passageSha256": "40cfdf26a92f52b73f140de4cc280d2811db2fa4c5f6d120c485268da8aef492",
      "pdfPages": [
        126,
        127
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c11-0063",
      "sentenceId": "c11-s04-p126-06135-s002",
      "sentenceText": "To investigate, I spent my sabbatical year (2012–2013) in Kobe.",
      "sentenceSha256": "52e97a595f7865839e22bdb270a695a8a56f5da2bc01dcd8bdd359b0a23a8b76",
      "readingUnitId": "c11-s04-p126-06135-r001-004",
      "parentQuestionId": "q-c11-032",
      "parentFingerprint": "9427957eb2234016daef4144e37be48afd01b64bd857576f6cbca6711c7c7c02",
      "passageSha256": "40cfdf26a92f52b73f140de4cc280d2811db2fa4c5f6d120c485268da8aef492",
      "pdfPages": [
        126,
        127
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c11-0064",
      "sentenceId": "c11-s04-p126-06135-s003",
      "sentenceText": "I analyzed the Hyogo Life Recovery Surveys, which were conducted across the city of Kobe and its surrounding areas in 2001, 2003, 2005, and 2011.",
      "sentenceSha256": "1e1ef70a4ebb7a8efab500430e6d9a62a0c38e07c4cdded67bdfbc8948930a26",
      "readingUnitId": "c11-s04-p126-06135-r001-004",
      "parentQuestionId": "q-c11-032",
      "parentFingerprint": "9427957eb2234016daef4144e37be48afd01b64bd857576f6cbca6711c7c7c02",
      "passageSha256": "40cfdf26a92f52b73f140de4cc280d2811db2fa4c5f6d120c485268da8aef492",
      "pdfPages": [
        126,
        127
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c11-0065",
      "sentenceId": "c11-s04-p127-01920-s001",
      "sentenceText": "Yet psychological scars were still visible for those who had lost their homes.",
      "sentenceSha256": "9074eebbab0807ee1345c1a3f500959317140cdb231a286863d70d83598469db",
      "readingUnitId": "c11-s04-p127-01920-r001-004",
      "parentQuestionId": "q-c11-034",
      "parentFingerprint": "d8ff129b4593da7b29081baedfc79511db7744494c792e14c1bd25228cf09a7b",
      "passageSha256": "74f580e4b538b110c29991eb98f0a6496c04a573144cce4e077442933f4f9ee1",
      "pdfPages": [
        127
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c11-0066",
      "sentenceId": "c11-s04-p127-01920-s002",
      "sentenceText": "For instance, in 2001 Kobe residents whose houses were completely destroyed by the 1995 earthquake were significantly less satisfied with their lives and reported more negative emotions and more physical illnesses than those whose houses had suffered no damage in 1995.",
      "sentenceSha256": "da910093ced04c87a3d0b8336989c9a749aeeb616d017bf0c1320590f2b8f918",
      "readingUnitId": "c11-s04-p127-01920-r001-004",
      "parentQuestionId": "q-c11-034",
      "parentFingerprint": "d8ff129b4593da7b29081baedfc79511db7744494c792e14c1bd25228cf09a7b",
      "passageSha256": "74f580e4b538b110c29991eb98f0a6496c04a573144cce4e077442933f4f9ee1",
      "pdfPages": [
        127
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c11-0067",
      "sentenceId": "c11-s04-p127-01920-s004",
      "sentenceText": "The psychological immune system was not enough for the devastation of the earthquake.",
      "sentenceSha256": "4d5c14715e50d63335c0887122d2d59a49b8d962e17418cef0a7f83d6d8aff81",
      "readingUnitId": "c11-s04-p127-01920-r001-004",
      "parentQuestionId": "q-c11-034",
      "parentFingerprint": "d8ff129b4593da7b29081baedfc79511db7744494c792e14c1bd25228cf09a7b",
      "passageSha256": "74f580e4b538b110c29991eb98f0a6496c04a573144cce4e077442933f4f9ee1",
      "pdfPages": [
        127
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c11-0068",
      "sentenceId": "c11-s04-p127-03870-s001",
      "sentenceText": "Our surveys also indicated the more home damage they had incurred, the more likely it was that they had lost a loved one.",
      "sentenceSha256": "47af742dfc1b68f3e85ac192cc63ca56de90e714b2e8b5948b5914040a9b9ab4",
      "readingUnitId": "c11-s04-p127-03870-r001-004",
      "parentQuestionId": "q-c11-036",
      "parentFingerprint": "0ef9b23faf7c1fb1cf0ea65704496c13187b2c263f1e37421912eaf15c3b4ec6",
      "passageSha256": "c8d5aa552c56aca94fa016ba045347e4255dd398f176c93aa7b022d352860e75",
      "pdfPages": [
        127
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c11-0069",
      "sentenceId": "c11-s04-p127-03870-s002",
      "sentenceText": "This human loss could also have a lingering negative effect on well-being.",
      "sentenceSha256": "e7e22df347c767cd26dfb774806dad8289bb3b15602d3371aa7dd33013244da4",
      "readingUnitId": "c11-s04-p127-03870-r001-004",
      "parentQuestionId": "q-c11-036",
      "parentFingerprint": "0ef9b23faf7c1fb1cf0ea65704496c13187b2c263f1e37421912eaf15c3b4ec6",
      "passageSha256": "c8d5aa552c56aca94fa016ba045347e4255dd398f176c93aa7b022d352860e75",
      "pdfPages": [
        127
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c11-0070",
      "sentenceId": "c11-s05-p127-06135-s001",
      "sentenceText": "In A Paradise Built in Hell, Rebecca Solnit documents numerous examples of prosocial actions among disaster victims.",
      "sentenceSha256": "cde3f228ee7fb052fdf6fde801c67dcc3dfd29e461253c49cd3218ba60d968be",
      "readingUnitId": "c11-s05-p127-06135-r001-003",
      "parentQuestionId": "q-c11-038",
      "parentFingerprint": "e291be6161e99339eef17d2592349494f02696d190bf082b234986a34f299300",
      "passageSha256": "5dea17e41a9139982d56203bbda2a1992f14868784ee7783e3d3266115046855",
      "pdfPages": [
        127
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c11-0071",
      "sentenceId": "c11-s05-p127-06135-s005",
      "sentenceText": "The very depth of emotion, the connecting to the core of one’s being, the calling into play one’s strongest feelings and abilities, can be rich, even on deathbeds, in wars and emergencies.”",
      "sentenceSha256": "7cafa4735ae8c1e5b520d5e574eafc06d8c8b26a1b97fcbd4f3e62cd51deeab6",
      "readingUnitId": "c11-s05-p127-06135-r004-005",
      "parentQuestionId": "q-c11-039",
      "parentFingerprint": "d304d258f5392b57c199c391e5f1309ef110a499989c5c52876b6d9e33dbe4e5",
      "passageSha256": "d4b0000503d797e64fb8b5f24b18930b95e9889625f72ee266c3d93c5a037ee6",
      "pdfPages": [
        127,
        128
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c11-0072",
      "sentenceId": "c11-s05-p128-03090-s001",
      "sentenceText": "So, according to Solnit, even devastating natural disasters such as the 1995 Hanshin-Awaji earthquake should have some silver linings.",
      "sentenceSha256": "82cfcab6d500cce2dac7230cb5267514ae25d4c5520c9943e9ad8a298714beb9",
      "readingUnitId": "c11-s05-p128-03090-r001-004",
      "parentQuestionId": "q-c11-041",
      "parentFingerprint": "897b9f022eba03b1751685cab23c4636daf3cf405c0fb2d0bdd206c523c9fccb",
      "passageSha256": "a09aa2e39e3ec441116507ada958be2c52c5017317d238fb7c401167a080b140",
      "pdfPages": [
        128
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c11-0073",
      "sentenceId": "c11-s05-p128-03090-s002",
      "sentenceText": "I remember watching surviving children who were interviewed on TV back in 1995.",
      "sentenceSha256": "b5315e547347472d8b7530f8d89840498bdb52a0ef047cde29943fa1527fdf7a",
      "readingUnitId": "c11-s05-p128-03090-r001-004",
      "parentQuestionId": "q-c11-041",
      "parentFingerprint": "897b9f022eba03b1751685cab23c4636daf3cf405c0fb2d0bdd206c523c9fccb",
      "passageSha256": "a09aa2e39e3ec441116507ada958be2c52c5017317d238fb7c401167a080b140",
      "pdfPages": [
        128
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c11-0074",
      "sentenceId": "c11-s05-p128-03090-s003",
      "sentenceText": "They were asked what they wanted to become.",
      "sentenceSha256": "49ddcb2acc3c241e1751a10f3a7df7088310b29c8ec80b12d9fdf4b5adcbae31",
      "readingUnitId": "c11-s05-p128-03090-r001-004",
      "parentQuestionId": "q-c11-041",
      "parentFingerprint": "897b9f022eba03b1751685cab23c4636daf3cf405c0fb2d0bdd206c523c9fccb",
      "passageSha256": "a09aa2e39e3ec441116507ada958be2c52c5017317d238fb7c401167a080b140",
      "pdfPages": [
        128
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c11-0075",
      "sentenceId": "c11-s05-p128-04455-s001",
      "sentenceText": "The best, most direct evidence for this can be found in studies conducted by Jean Decety and his colleagues.",
      "sentenceSha256": "9e68f46171305982faa7265b0a11c56468b2e0b66a89ae8c193ab20b49127e24",
      "readingUnitId": "c11-s05-p128-04455-r001-004",
      "parentQuestionId": "q-c11-043",
      "parentFingerprint": "5767e4fe83143d210fdc8d8bf77f70a76bfa2ad80b3670f4992a082afbb22dc2",
      "passageSha256": "086dc1fa1ba2ffb93400d8e04ed1a2c109b75bf89db8b16b1b7931cf0393e917",
      "pdfPages": [
        128
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c11-0076",
      "sentenceId": "c11-s05-p128-04455-s002",
      "sentenceText": "They collected data on altruistic giving from six- and nine-year-old Chinese children living in Sichuan, China, in April 2008.",
      "sentenceSha256": "dd644dd78b9eb071d818040bf243cb0e56b81c80c7264ea9177c30befa0f20b4",
      "readingUnitId": "c11-s05-p128-04455-r001-004",
      "parentQuestionId": "q-c11-043",
      "parentFingerprint": "5767e4fe83143d210fdc8d8bf77f70a76bfa2ad80b3670f4992a082afbb22dc2",
      "passageSha256": "086dc1fa1ba2ffb93400d8e04ed1a2c109b75bf89db8b16b1b7931cf0393e917",
      "pdfPages": [
        128
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c11-0077",
      "sentenceId": "c11-s05-p128-04455-s003",
      "sentenceText": "Just one month later, on May 12, 2008, a magnitude 7.9 earthquake hit Sichuan.",
      "sentenceSha256": "976111b5fdb6c2ed2bde9fcffd13bfc86239320d8a982bed94f6000b8d0079c8",
      "readingUnitId": "c11-s05-p128-04455-r001-004",
      "parentQuestionId": "q-c11-043",
      "parentFingerprint": "5767e4fe83143d210fdc8d8bf77f70a76bfa2ad80b3670f4992a082afbb22dc2",
      "passageSha256": "086dc1fa1ba2ffb93400d8e04ed1a2c109b75bf89db8b16b1b7931cf0393e917",
      "pdfPages": [
        128
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c11-0078",
      "sentenceId": "c11-s05-p128-06600-s001",
      "sentenceText": "The experiment went like this: One child at a time was invited to a quiet room in their school, where they were greeted by a female researcher who told them they could pick ten stickers for themselves out of a hundred stickers.",
      "sentenceSha256": "a8e94283caa2a0c4d2c0ed1391430ce4ff71e105f8238a941ce49486adc5953f",
      "readingUnitId": "c11-s05-p128-06600-r001-003",
      "parentQuestionId": "q-c11-045",
      "parentFingerprint": "4895c22fdd7f5fb5bd449b6b920ca048c786ec919087cd4a9330f9207d8f3d90",
      "passageSha256": "13d2b5b4ecca08f4e48423c7cdbcefce2c1320e038ff4a0eaf82ed1de7158fbb",
      "pdfPages": [
        128,
        129
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c11-0079",
      "sentenceId": "c11-s05-p128-06600-s002",
      "sentenceText": "After the children picked their favorite ten, they were told that some of their classmates had not been selected to play this game and would not receive any stickers.",
      "sentenceSha256": "e195fd9767d9a32b38fc54cecb2fc861502877c66d52940a7e99e6217b9c1e92",
      "readingUnitId": "c11-s05-p128-06600-r001-003",
      "parentQuestionId": "q-c11-045",
      "parentFingerprint": "4895c22fdd7f5fb5bd449b6b920ca048c786ec919087cd4a9330f9207d8f3d90",
      "passageSha256": "13d2b5b4ecca08f4e48423c7cdbcefce2c1320e038ff4a0eaf82ed1de7158fbb",
      "pdfPages": [
        128,
        129
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c11-0080",
      "sentenceId": "c11-s05-p128-06600-s004",
      "sentenceText": "They were given an empty envelope for any stickers they wanted to donate to an anonymous classmate.",
      "sentenceSha256": "19533a4ccb7382df73b194ee0a47f519580aa64e7ed58d60347065b656a87d78",
      "readingUnitId": "c11-s05-p128-06600-r004-007",
      "parentQuestionId": "q-c11-046",
      "parentFingerprint": "7a18c269624e5e2e4ab6f66e71c941bf005154aa5c55f1c222df3ece14181fde",
      "passageSha256": "69f36f717fd33f617466c21e2a58129630bb4ee3b8b66647e3dbfda1bd7c2d93",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c11-0081",
      "sentenceId": "c11-s05-p128-06600-s005",
      "sentenceText": "After the session was over, the researcher counted how many stickers each child donated as a behavioral measure of altruistic giving.",
      "sentenceSha256": "2eaeeb0ebccbbcec5968cc504ca7320cd9031db035e59e3d21b5c0d8857e3250",
      "readingUnitId": "c11-s05-p128-06600-r004-007",
      "parentQuestionId": "q-c11-046",
      "parentFingerprint": "7a18c269624e5e2e4ab6f66e71c941bf005154aa5c55f1c222df3ece14181fde",
      "passageSha256": "69f36f717fd33f617466c21e2a58129630bb4ee3b8b66647e3dbfda1bd7c2d93",
      "pdfPages": [
        129
      ]
    }
  ]
}
