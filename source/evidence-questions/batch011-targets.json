      "passageSha256": "fd56a0a5273a76aac1bc89d883d606c2dd0d5374a4e0185f4d1a4491dfe6fdb4",
      "pdfPages": [
        39
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c04-0045",
      "sentenceId": "c04-s04-p039-02625-s001",
      "sentenceText": "Steve Jobs is another example of someone who chose a life of exploration.",
      "sentenceSha256": "aac69181fd61bb1f61bf2297338d1c3486b5c2188e30a58415a20a797e6f2837",
      "readingUnitId": "c04-s04-p039-02625-r001-004",
      "parentQuestionId": "q-c04-025",
