      "passageSha256": "5205f387321b907c1b00f1fa460e2663dec7f38b6083632ccd5dd42ca7fea00a",
      "pdfPages": [
        39
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c04-0046",
      "sentenceId": "c04-s04-p039-02625-s003",
      "sentenceText": "He was smart but hated school.",
      "sentenceSha256": "183db5e5381ff70178646afb203bcce7dd2f6af745e02c779472907fe5f969f1",
      "readingUnitId": "c04-s04-p039-02625-r001-004",
