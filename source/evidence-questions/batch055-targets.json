    {
      "order": 11,
      "questionId": "qe-c12-0077",
      "sentenceId": "c12-s05-p141-03090-s010",
      "sentenceText": "“Uh…huge, pink paintings?",
      "sentenceSha256": "b2fff7eeefd23d5710376edaa0fbbb7839534cc63fd92a3734b450e2a58e9216",
      "readingUnitId": "c12-s05-p141-03090-r009-012",
