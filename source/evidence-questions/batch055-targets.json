    },
    {
      "order": 5,
      "questionId": "qe-c12-0071",
      "sentenceId": "c12-s05-p141-00750-s006",
      "sentenceText": "After a while, these people need more excitement.",
      "sentenceSha256": "f91c4b9ece311ee41f920de072b13cb1e34559be2895b5e6508246f5fb66d83d",
      "readingUnitId": "c12-s05-p141-00750-r005-007",
