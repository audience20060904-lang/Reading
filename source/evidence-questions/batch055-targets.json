    },
    {
      "order": 3,
      "questionId": "qe-c12-0069",
      "sentenceId": "c12-s05-p141-00750-s001",
      "sentenceText": "Some people are naturally more reflective.",
      "sentenceSha256": "170d24cae38aeec7ec9af97898c580381bd803f54aaf291373f41cea27ee8e3b",
      "readingUnitId": "c12-s05-p141-00750-r001-004",
