      "passageSha256": "c047272f65682f4791660c9d4a27674329c9bc2b877fb4aa6429883a9597566e",
      "pdfPages": [
        141
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c12-0070",
      "sentenceId": "c12-s05-p141-00750-s002",
      "sentenceText": "If you reflect on the events of the day every night, you are much more likely to remember events than those who don’t.",
      "sentenceSha256": "b35ced568bd03da761e0ed2eb7ba87bceee15f340b2b2902ad950607f0e3ba83",
      "readingUnitId": "c12-s05-p141-00750-r001-004",
      "parentQuestionId": "q-c12-050",
      "parentFingerprint": "db61d9df2bdc03387f0813b0d8488673f431ef3052fea4d02604bce0c5daf4ca",
      "passageSha256": "c047272f65682f4791660c9d4a27674329c9bc2b877fb4aa6429883a9597566e",
      "pdfPages": [
        141
