  "targets": [
    {
      "order": 1,
      "questionId": "qe-c10-0053",
      "sentenceId": "c10-s03-p107-06600-s004",
      "sentenceText": "How do people have twelve serious relationships before marriage?",
      "sentenceSha256": "b7bc6a50aefd8b83a4d8d035b91dba0901fe8e62135ef35c842c434b96f016f7",
      "readingUnitId": "c10-s03-p107-06600-r001-004",
      "parentQuestionId": "q-c10-028",
      "parentFingerprint": "6b7d3ed7b95f06b59d5db2b5d2d2380d7507b472232e989ef16292b71424beb2",
      "passageSha256": "82aed2bbd9ea1b7885125ffbfad9e7fbd04de9e6b5ce59550e1388e7973b28bf",
      "pdfPages": [
        107,
        108
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c10-0054",
      "sentenceId": "c10-s04-p108-02430-s001",
      "sentenceText": "If Kepler and the statisticians above have figured out the optimal solution to many of our decisions, why don’t we explore more?",
      "sentenceSha256": "4ae026d94d212eb551adfc782f81da50da4ca95a5dae3313da15338bb70100c1",
      "readingUnitId": "c10-s04-p108-02430-r001-003",
      "parentQuestionId": "q-c10-030",
      "parentFingerprint": "b9716312f9a1881f4f8263e01f5322a2be2c56ad958a4f04befcdb21e10adb83",
      "passageSha256": "8c5c46cf4944b15bbda50d70dc6b5226b42e024b11ba6785091cf38ffcae631e",
      "pdfPages": [
        108
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c10-0055",
      "sentenceId": "c10-s04-p108-02430-s003",
      "sentenceText": "And can it tell us something about the psychologically rich life?",
      "sentenceSha256": "3ae3f2c55aea191732249f1448a5d83ca72baf977722066708368d4f9827b1aa",
      "readingUnitId": "c10-s04-p108-02430-r001-003",
      "parentQuestionId": "q-c10-030",
      "parentFingerprint": "b9716312f9a1881f4f8263e01f5322a2be2c56ad958a4f04befcdb21e10adb83",
      "passageSha256": "8c5c46cf4944b15bbda50d70dc6b5226b42e024b11ba6785091cf38ffcae631e",
      "pdfPages": [
        108
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c10-0056",
      "sentenceId": "c10-s04-p108-03210-s001",
      "sentenceText": "An answer might lie in sociology and social psychology.",
      "sentenceSha256": "8d06e56cf34c47ed2748747985b12b661dd980579bf528aed54f2e4873b7eb42",
      "readingUnitId": "c10-s04-p108-03210-r001-004",
      "parentQuestionId": "q-c10-031",
      "parentFingerprint": "19e1845eca1ed9d09a85b1dd4ff28587add8bb9c84fdd420286dd266062b8522",
      "passageSha256": "1cb965080dd57a1671b0f802eb8ea3ab4cbf69fe0ffd9baaa5a82a917be41ea3",
      "pdfPages": [
        108
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c10-0057",
      "sentenceId": "c10-s04-p108-03210-s003",
      "sentenceText": "In order to learn about the geography of marriage in Philadelphia, Bossard wanted to see how far people lived from each other before they decided to get married.",
      "sentenceSha256": "6462fae42a6202f49f816557cc1f9df6ec876754781670f0059ea319cac4174d",
      "readingUnitId": "c10-s04-p108-03210-r001-004",
      "parentQuestionId": "q-c10-031",
      "parentFingerprint": "19e1845eca1ed9d09a85b1dd4ff28587add8bb9c84fdd420286dd266062b8522",
      "passageSha256": "1cb965080dd57a1671b0f802eb8ea3ab4cbf69fe0ffd9baaa5a82a917be41ea3",
      "pdfPages": [
        108
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c10-0058",
      "sentenceId": "c10-s04-p108-03210-s004",
      "sentenceText": "If bachelors and bachelorettes explored their options widely, many would marry someone who lived far away from them.",
      "sentenceSha256": "004860a7bb0572bac985ee9cbb272beab4068478a4e7adb40362e11c15de6b4e",
      "readingUnitId": "c10-s04-p108-03210-r001-004",
      "parentQuestionId": "q-c10-031",
      "parentFingerprint": "19e1845eca1ed9d09a85b1dd4ff28587add8bb9c84fdd420286dd266062b8522",
      "passageSha256": "1cb965080dd57a1671b0f802eb8ea3ab4cbf69fe0ffd9baaa5a82a917be41ea3",
      "pdfPages": [
        108
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c10-0059",
      "sentenceId": "c10-s04-p108-04770-s001",
      "sentenceText": "It turned out that Philadelphians in the 1930s found their partners nearby.",
      "sentenceSha256": "7f66297b6f1bdcece8bbdd201df1f5bd8b89f4c5f5f3ee72b34c27994a02abd3",
      "readingUnitId": "c10-s04-p108-04770-r001-004",
      "parentQuestionId": "q-c10-032",
      "parentFingerprint": "f3c2bfe64b2d2380834ac0061f92e4b384db5b8a8dfcbc41af920706b13f832f",
      "passageSha256": "c1219c0b347be61d43e604089d2f3086719b1b3a565dd35f636e2d2607d415a3",
      "pdfPages": [
        108
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c10-0060",
      "sentenceId": "c10-s04-p108-04770-s002",
      "sentenceText": "Only 890 couples, or 17.8 percent, were made up of a partner living in Philadelphia and the other living outside the city before marriage.",
      "sentenceSha256": "a37d931e9d0dd83095356e31f1ddb2665377b679efd4f7402b1fff5bfce2ccd1",
      "readingUnitId": "c10-s04-p108-04770-r001-004",
      "parentQuestionId": "q-c10-032",
      "parentFingerprint": "f3c2bfe64b2d2380834ac0061f92e4b384db5b8a8dfcbc41af920706b13f832f",
      "passageSha256": "c1219c0b347be61d43e604089d2f3086719b1b3a565dd35f636e2d2607d415a3",
      "pdfPages": [
        108
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c10-0061",
      "sentenceId": "c10-s04-p108-04770-s003",
      "sentenceText": "The remaining 82.2 percent of the couples had lived separately in Philadelphia before marriage.",
      "sentenceSha256": "94638d6b24af7c1227207c0e50504bfda1ad9fd8633443edbba81b8ae4f37880",
      "readingUnitId": "c10-s04-p108-04770-r001-004",
      "parentQuestionId": "q-c10-032",
      "parentFingerprint": "f3c2bfe64b2d2380834ac0061f92e4b384db5b8a8dfcbc41af920706b13f832f",
      "passageSha256": "c1219c0b347be61d43e604089d2f3086719b1b3a565dd35f636e2d2607d415a3",
      "pdfPages": [
        108
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c10-0062",
      "sentenceId": "c10-s04-p108-04770-s006",
      "sentenceText": "How else would the majority of matches have been made within twenty city blocks?",
      "sentenceSha256": "87aed0740dfba454d33d609c87f4d47acf65c5438e45630f859bc041211828a0",
      "readingUnitId": "c10-s04-p108-04770-r005-007",
      "parentQuestionId": "q-c10-033",
      "parentFingerprint": "95114cb42dbffe0c0de9ddaa4ca55ac9674d098f9cc7bdbc23d22810f3e14351",
      "passageSha256": "00ad21e739473e372e039c7ff65678b97fe9e5337adc8970f5a00c3e4f9b941d",
      "pdfPages": [
        108,
        109
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c10-0063",
      "sentenceId": "c10-s04-p108-04770-s007",
      "sentenceText": "Reflecting upon his findings, Bossard commented, “Cupid may have wings, but apparently they are not adapted for long flights.”",
      "sentenceSha256": "fb88acb262fb890978af130c7bafd715920e6ac9e27066369a225031f0624e80",
      "readingUnitId": "c10-s04-p108-04770-r005-007",
      "parentQuestionId": "q-c10-033",
      "parentFingerprint": "95114cb42dbffe0c0de9ddaa4ca55ac9674d098f9cc7bdbc23d22810f3e14351",
      "passageSha256": "00ad21e739473e372e039c7ff65678b97fe9e5337adc8970f5a00c3e4f9b941d",
      "pdfPages": [
        108,
        109
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c10-0064",
      "sentenceId": "c10-s04-p109-01140-s002",
      "sentenceText": "For one thing, in 1931 Philadelphia was ethnically and racially segregated.",
      "sentenceSha256": "96e1fa8a2aac078b01d24a4148d8a5a239a772d328c4fe0ebfa5803f230d7ecb",
      "readingUnitId": "c10-s04-p109-01140-r001-004",
      "parentQuestionId": "q-c10-034",
      "parentFingerprint": "5a947023ea6b1a1d2315fa4362f6108d40f8fcf81d8dacfe1308ca47c4bd1796",
      "passageSha256": "57fe710fc3436b4902337fb9e3f60bdafaad3680f01b90da1596c55329a9db54",
      "pdfPages": [
        109
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c10-0065",
      "sentenceId": "c10-s04-p109-01140-s004",
      "sentenceText": "Proximity also meant that people were more likely to have interactions nearby than they would with people who lived farther away.",
      "sentenceSha256": "7d970b458cfa0edb8644e5e9cb4110dcdebddbde30c50475f676694324d81d16",
      "readingUnitId": "c10-s04-p109-01140-r001-004",
      "parentQuestionId": "q-c10-034",
      "parentFingerprint": "5a947023ea6b1a1d2315fa4362f6108d40f8fcf81d8dacfe1308ca47c4bd1796",
      "passageSha256": "57fe710fc3436b4902337fb9e3f60bdafaad3680f01b90da1596c55329a9db54",
      "pdfPages": [
        109
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c10-0066",
      "sentenceId": "c10-s04-p109-02505-s001",
      "sentenceText": "You might say, well, the Philadelphia study is great, but that was 1931.",
      "sentenceSha256": "f212ea89bec9d88978567884401e408ba6b6a0c20f16a261a370d0a72447f34c",
      "readingUnitId": "c10-s04-p109-02505-r001-004",
      "parentQuestionId": "q-c10-036",
      "parentFingerprint": "8b7c8a4dfa79a4f606413f15f79d37e463b94cecd5723c78f1cb3926b9dd38a6",
      "passageSha256": "58225f904492c096f61f2b1664e1e460a05763a03ef4da327859cfc0efeebe0c",
      "pdfPages": [
        109
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c10-0067",
      "sentenceId": "c10-s04-p109-02505-s003",
      "sentenceText": "In 1931, it was nearly impossible to marry someone of a different race.",
      "sentenceSha256": "8deb9d49f9cbea9594ede5b9a18b2d0efcd76425b7e2363af3a44d668c89ade7",
      "readingUnitId": "c10-s04-p109-02505-r001-004",
      "parentQuestionId": "q-c10-036",
      "parentFingerprint": "8b7c8a4dfa79a4f606413f15f79d37e463b94cecd5723c78f1cb3926b9dd38a6",
      "passageSha256": "58225f904492c096f61f2b1664e1e460a05763a03ef4da327859cfc0efeebe0c",
      "pdfPages": [
        109
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c10-0068",
      "sentenceId": "c10-s04-p109-02505-s004",
      "sentenceText": "Even among the white population, people from different religions rarely married each other.",
      "sentenceSha256": "d7633b96a8b56ac8fc1019abefd20c8ea6afb66f017540851ddd17f1511f4b2a",
      "readingUnitId": "c10-s04-p109-02505-r001-004",
      "parentQuestionId": "q-c10-036",
      "parentFingerprint": "8b7c8a4dfa79a4f606413f15f79d37e463b94cecd5723c78f1cb3926b9dd38a6",
      "passageSha256": "58225f904492c096f61f2b1664e1e460a05763a03ef4da327859cfc0efeebe0c",
      "pdfPages": [
        109
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c10-0069",
      "sentenceId": "c10-s04-p109-03870-s001",
      "sentenceText": "Karen Haandrikman and her colleagues asked this exact question, looking at the vital statistics for the entire population of the Netherlands.",
      "sentenceSha256": "c51aed9359971cab66eb0afcf04c4355d9ebfa5cd29910ba4a0e0b65b871b0d9",
      "readingUnitId": "c10-s04-p109-03870-r001-003",
      "parentQuestionId": "q-c10-038",
      "parentFingerprint": "32776c5cfe684c728a6e749089bc8c017b64ab6683d4694a7ba8bc1c7a36ca88",
      "passageSha256": "d3ea3df0b5ad3e477ba89a1ada175e17d0ad4fd7517c2b9faed2098b8d345dea",
      "pdfPages": [
        109
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c10-0070",
      "sentenceId": "c10-s04-p109-03870-s002",
      "sentenceText": "Yes, you read that right: the entire population of the Netherlands.",
      "sentenceSha256": "0d1909c1ccc8da6afa166fa17c2139afcce86968efecf2b09c91aa3197009ef1",
      "readingUnitId": "c10-s04-p109-03870-r001-003",
      "parentQuestionId": "q-c10-038",
      "parentFingerprint": "32776c5cfe684c728a6e749089bc8c017b64ab6683d4694a7ba8bc1c7a36ca88",
      "passageSha256": "d3ea3df0b5ad3e477ba89a1ada175e17d0ad4fd7517c2b9faed2098b8d345dea",
      "pdfPages": [
        109
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c10-0071",
      "sentenceId": "c10-s04-p109-04845-s001",
      "sentenceText": "First, the researchers looked at where each individual had lived prior to cohabitation.",
      "sentenceSha256": "260bd8d48c326a3cb6747ee6361b96a8c8a93ab96fcd7b2a779311a5f257d8c9",
      "readingUnitId": "c10-s04-p109-04845-r001-003",
      "parentQuestionId": "q-c10-039",
      "parentFingerprint": "810ecf3e1dec1e838c55b1c5ea339a975059e3db8315895aeba7d57380166585",
      "passageSha256": "2d7e360df220c39a4c956bbb55172e19d9a1e87f1116334e81e362f7981fcec3",
      "pdfPages": [
        109
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c10-0072",
      "sentenceId": "c10-s04-p109-04845-s003",
      "sentenceText": "Both sets of data showed that the most common residential distance between partners prior to cohabitation was just one kilometer, or .62 miles.",
      "sentenceSha256": "b3e551525a2ba27c02b4855c89010c1ad2ecf643dfda9a67710b032ff862e571",
      "readingUnitId": "c10-s04-p109-04845-r001-003",
      "parentQuestionId": "q-c10-039",
      "parentFingerprint": "810ecf3e1dec1e838c55b1c5ea339a975059e3db8315895aeba7d57380166585",
      "passageSha256": "2d7e360df220c39a4c956bbb55172e19d9a1e87f1116334e81e362f7981fcec3",
      "pdfPages": [
        109
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c10-0073",
      "sentenceId": "c10-s04-p109-04845-s004",
      "sentenceText": "Roughly 13 percent of newly cohabiting couples had lived roughly one kilometer away from each other right before they started cohabitating; roughly 10.5 percent of them had lived roughly one kilometer away five years before they started cohabitating.",
      "sentenceSha256": "53443e92bbdd5316747fdabd4ee817dbfcb9ffd2e267732f703febe8d1fbdaa1",
      "readingUnitId": "c10-s04-p109-04845-r004-006",
      "parentQuestionId": "q-c10-040",
      "parentFingerprint": "c930b48913468c6fe36df5154c075f81b5ea1dda59534186400a5db94204ee1c",
      "passageSha256": "b43c4931f515fc810848dde381aa1a84db9dc3729ff255d1e122d2d807cd2a4d",
      "pdfPages": [
        109,
        110
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c10-0074",
      "sentenceId": "c10-s04-p109-04845-s006",
      "sentenceText": "That is, half of Dutch people who started cohabitating in 2004 chose a partner who had been born less than fifteen miles away from their own birthplace.",
      "sentenceSha256": "3251b6f0ddee16f7100eb0763c66827d1d601a1433fe7b7f69e878e5813f0ebd",
      "readingUnitId": "c10-s04-p109-04845-r004-006",
      "parentQuestionId": "q-c10-040",
      "parentFingerprint": "c930b48913468c6fe36df5154c075f81b5ea1dda59534186400a5db94204ee1c",
      "passageSha256": "b43c4931f515fc810848dde381aa1a84db9dc3729ff255d1e122d2d807cd2a4d",
      "pdfPages": [
        109,
        110
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c10-0075",
      "sentenceId": "c10-s04-p109-04845-s007",
      "sentenceText": "These statistics suggest an astonishingly small world, even for a quite cosmopolitan European country.",
      "sentenceSha256": "73403fa0fbb0df01f5c20f4fc05dbcaaa4628805739fc9886d2b8bcce292628d",
      "readingUnitId": "c10-s04-p109-04845-r007-010",
      "parentQuestionId": "q-c10-041",
      "parentFingerprint": "b9f8ad15cd6a92769cf8085b5e51be8e61b39385ddfc9c83edeba7329eecd080",
      "passageSha256": "32ce85770e129a31a1561500fda98844181c0b8990212ad9b8ca6a5b07495863",
      "pdfPages": [
        110
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c10-0076",
      "sentenceId": "c10-s04-p109-04845-s008",
      "sentenceText": "Online dating became popular in the early 2000s.",
      "sentenceSha256": "1b73ddd1cee353accc3ad85dd8ed361cf2bcc750182641a50a64f1def96eb17a",
      "readingUnitId": "c10-s04-p109-04845-r007-010",
      "parentQuestionId": "q-c10-041",
      "parentFingerprint": "b9f8ad15cd6a92769cf8085b5e51be8e61b39385ddfc9c83edeba7329eecd080",
      "passageSha256": "32ce85770e129a31a1561500fda98844181c0b8990212ad9b8ca6a5b07495863",
      "pdfPages": [
        110
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c10-0077",
      "sentenceId": "c10-s04-p109-04845-s010",
      "sentenceText": "What does this tell us?",
      "sentenceSha256": "6c13f5b96be56499a449a112c9e9bb488c535baeafd324207043e9b4553f4eb4",
      "readingUnitId": "c10-s04-p109-04845-r007-010",
