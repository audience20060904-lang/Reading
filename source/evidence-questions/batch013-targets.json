      "readingUnitId": "c05-s01-p044-06578-r001-004",
      "parentQuestionId": "q-c05-005",
      "parentFingerprint": "087a9b29eab5da9bec4dd49ff92f53acc3bbbcd065f43a51d1093d537d080ad3",
      "passageSha256": "51535a5c4b76d277d78e48219bcc85c750273e4a5b4d93ce56c210a2083d5c53",
      "pdfPages": [
        44,
        45
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c05-0009",
      "sentenceId": "c05-s01-p044-06578-s005",
      "sentenceText": "She laughed, cheered, felt outraged and pained, and ultimately found herself deeply moved by the experience.",
