    {
      "order": 22,
      "questionId": "qe-c05-0007",
      "sentenceId": "c05-s01-p044-06578-s001",
      "sentenceText": "Grace and Rachel gave the most memorable answers.",
      "sentenceSha256": "45a0a7fb4b826391c22df5f160aa0a5efd7ba236ea5c99a9b13390aa324c4d61",
      "readingUnitId": "c05-s01-p044-06578-r001-004",
