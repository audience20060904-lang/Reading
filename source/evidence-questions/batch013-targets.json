    },
    {
      "order": 17,
      "questionId": "qe-c05-0002",
      "sentenceId": "c05-s01-p044-04628-s001",
      "sentenceText": "To find out, I held two focus group meetings in September 2015.",
      "sentenceSha256": "a20045b49e142f895331204fee2932f4b61d12ab92fd331833830466405295b7",
      "readingUnitId": "c05-s01-p044-04628-r001-004",
