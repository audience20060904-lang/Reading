    },
    {
      "order": 23,
      "questionId": "qe-c05-0008",
      "sentenceId": "c05-s01-p044-06578-s002",
      "sentenceText": "Grace was a sophomore from a suburb of Washington D.C. She went to her first professional wrestling event with friends over the weekend.",
