    },
    {
      "order": 14,
      "questionId": "qe-c10-0191",
      "sentenceId": "c10-s09-p120-01530-s001",
      "sentenceText": "So, why should multicultural experiences be associated with creativity?",
      "sentenceSha256": "2cb2946453ca98122e8774ca47023f2724a46f03548b4fd763c60822b40652fc",
      "readingUnitId": "c10-s09-p120-01530-r001-004",
      "parentQuestionId": "q-c10-108",
      "parentFingerprint": "330c8494618235f1ff18d47880859a3be3ceb333def747722d8e86158fd325c8",
      "passageSha256": "aa27f9cfb884e9463a9ba38f4ad95cafd116248cfdacbed2713433ed1fb5e8b2",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c10-0192",
      "sentenceId": "c10-s09-p120-01530-s003",
      "sentenceText": "One new concept I learned about when I moved to the U.S. was the possibility of building or renovating your own house.",
      "sentenceSha256": "db15a51fa52f410b60f2dc4910b5055da5c87470197936ee80922d02f181e355",
      "readingUnitId": "c10-s09-p120-01530-r001-004",
      "parentQuestionId": "q-c10-108",
      "parentFingerprint": "330c8494618235f1ff18d47880859a3be3ceb333def747722d8e86158fd325c8",
      "passageSha256": "aa27f9cfb884e9463a9ba38f4ad95cafd116248cfdacbed2713433ed1fb5e8b2",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c10-0193",
      "sentenceId": "c10-s09-p120-01530-s004",
      "sentenceText": "For an American reader, this is an ordinary idea.",
      "sentenceSha256": "949a5b23d9a9dc27b3234d6df5b3cbe130b9e3390225732aeb648a73cd920ead",
      "readingUnitId": "c10-s09-p120-01530-r001-004",
      "parentQuestionId": "q-c10-108",
      "parentFingerprint": "330c8494618235f1ff18d47880859a3be3ceb333def747722d8e86158fd325c8",
      "passageSha256": "aa27f9cfb884e9463a9ba38f4ad95cafd116248cfdacbed2713433ed1fb5e8b2",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c10-0194",
      "sentenceId": "c10-s09-p120-01530-s005",
      "sentenceText": "To me, it was a radical idea.",
      "sentenceSha256": "8393cdda93e58c23c12ca72604e1b4b495169c5a61b7610a638d078472d03391",
      "readingUnitId": "c10-s09-p120-01530-r005-008",
      "parentQuestionId": "q-c10-109",
      "parentFingerprint": "30266bb3e338ba037137f984572bbd58da7a59a9294b613e38fcd8465336ce4b",
      "passageSha256": "64a102dbeafc01627c5d4e8a45cd6eb78f2214aeffde8d802576f78a34012c66",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c10-0195",
      "sentenceId": "c10-s09-p120-01530-s006",
      "sentenceText": "To be clear, DIY does exist in Japan, but it typically involves small projects like building shelves or bookcases.",
      "sentenceSha256": "969c5e503c7dfe9c46b145a84a7625cfed839e8dceff779b4da9321c3f81acf4",
      "readingUnitId": "c10-s09-p120-01530-r005-008",
      "parentQuestionId": "q-c10-109",
      "parentFingerprint": "30266bb3e338ba037137f984572bbd58da7a59a9294b613e38fcd8465336ce4b",
      "passageSha256": "64a102dbeafc01627c5d4e8a45cd6eb78f2214aeffde8d802576f78a34012c66",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c10-0196",
      "sentenceId": "c10-s09-p120-01530-s008",
      "sentenceText": "That aspiration, that frontier spirit, was new to me.",
      "sentenceSha256": "890d19de3af60dfde50813a3383efbbcefe8782b4f4db8846b8f9615ce9f5a2d",
      "readingUnitId": "c10-s09-p120-01530-r005-008",
      "parentQuestionId": "q-c10-109",
      "parentFingerprint": "30266bb3e338ba037137f984572bbd58da7a59a9294b613e38fcd8465336ce4b",
      "passageSha256": "64a102dbeafc01627c5d4e8a45cd6eb78f2214aeffde8d802576f78a34012c66",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c10-0197",
      "sentenceId": "c10-s09-p120-01530-s009",
      "sentenceText": "American balloon framing is a genius invention that makes constructing houses easier.",
      "sentenceSha256": "c3ad0705c39e08c4197aeeb4f086683553f00655a35ba504dc5e6fb139802a4b",
      "readingUnitId": "c10-s09-p120-01530-r009-011",
      "parentQuestionId": "q-c10-110",
      "parentFingerprint": "825ff88aec6f9d12082b01b9e5edab039c771c9ff73a611803f94ec71831f106",
      "passageSha256": "36c048fb81afc49622654a7e7539a44848572d92192d67a157ffcf4c711d0de5",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c10-0198",
      "sentenceId": "c10-s09-p120-01530-s011",
      "sentenceText": "I bet my college friends in Tokyo would think I was crazy if I decided to build my own house.",
      "sentenceSha256": "49f264864347f1d459d702e7968282f5169d761e1a408dcb6261c40e76227ac1",
      "readingUnitId": "c10-s09-p120-01530-r009-011",
      "parentQuestionId": "q-c10-110",
      "parentFingerprint": "825ff88aec6f9d12082b01b9e5edab039c771c9ff73a611803f94ec71831f106",
      "passageSha256": "36c048fb81afc49622654a7e7539a44848572d92192d67a157ffcf4c711d0de5",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c10-0199",
      "sentenceId": "c10-s09-p120-04065-s002",
      "sentenceText": "A smile is a good example.",
      "sentenceSha256": "e45f83e59d6ce041b23237a7d23e88ddc632ee31dc31d5d087f79569aad9b11a",
      "readingUnitId": "c10-s09-p120-04065-r001-004",
      "parentQuestionId": "q-c10-111",
      "parentFingerprint": "b02ae423d4acbe126eb5c585803a81e288ecc39e4f0ced8519f50bc585d7c691",
      "passageSha256": "481f2dd007f50ca94581ab4f0658f564df227f1ec2ed599aca81914e334f0699",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c10-0200",
      "sentenceId": "c10-s09-p120-04065-s003",
      "sentenceText": "I was raised not to smile in front of people because it could come across as impolite.",
      "sentenceSha256": "ef76fbf6c59be41df2b0fc84ebd0d70698f549ebf680213e51176abcd2482115",
      "readingUnitId": "c10-s09-p120-04065-r001-004",
      "parentQuestionId": "q-c10-111",
      "parentFingerprint": "b02ae423d4acbe126eb5c585803a81e288ecc39e4f0ced8519f50bc585d7c691",
      "passageSha256": "481f2dd007f50ca94581ab4f0658f564df227f1ec2ed599aca81914e334f0699",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c10-0201",
      "sentenceId": "c10-s09-p120-04065-s004",
      "sentenceText": "But when I came to the U.S., everyone told me to smile more because it would be more polite!",
      "sentenceSha256": "b592c22fc81905679a1b62a297da87a52dc9268d6e628aa25957c6295d8d21fc",
      "readingUnitId": "c10-s09-p120-04065-r001-004",
      "parentQuestionId": "q-c10-111",
      "parentFingerprint": "b02ae423d4acbe126eb5c585803a81e288ecc39e4f0ced8519f50bc585d7c691",
      "passageSha256": "481f2dd007f50ca94581ab4f0658f564df227f1ec2ed599aca81914e334f0699",
      "pdfPages": [
        120
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c10-0202",
      "sentenceId": "c10-s09-p120-04065-s005",
      "sentenceText": "Now, when I go back to Japan, I have to consciously try not to smile.",
      "sentenceSha256": "80671afd0d913277c25a12059036576c6344d818dd9aa40482cf26b81fce7f99",
      "readingUnitId": "c10-s09-p120-04065-r005-008",
