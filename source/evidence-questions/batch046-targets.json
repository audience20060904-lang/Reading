      "parentFingerprint": "3caad6afe5a4835cc833466c8c3e3d36884344276e33e7d7fb2b7bb03536af1b",
      "passageSha256": "73ae1f191109e78ee44075aa1a86ffee6de946fb69dfff657710d7cf84a77dec",
      "pdfPages": [
        119
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c10-0185",
      "sentenceId": "c10-s09-p119-05355-s003",
      "sentenceText": "Or is it specific only to him?",
      "sentenceSha256": "015537232dc98a6711b82d56dd283b7c89f9be4dd3b872f56bb4746365af78de",
      "readingUnitId": "c10-s09-p119-05355-r001-004",
