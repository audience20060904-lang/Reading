    },
    {
      "order": 8,
      "questionId": "qe-c13-0079",
      "sentenceId": "c13-s03-p151-03870-s003",
      "sentenceText": "My wife and I often recite a Halloween story about when our first son dressed as Thomas the Tank Engine when he was three years old.",
