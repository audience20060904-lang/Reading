      "sentenceId": "c13-s01-p146-02115-s001",
      "sentenceText": "Their difficulties are in part due to the fact that the moves were initiated by their parents.",
      "sentenceSha256": "c369b2335197a823bbd3715a6c99415b894af1199e004767979c5d8594fbbd3b",
      "readingUnitId": "c13-s01-p146-02115-r001-004",
