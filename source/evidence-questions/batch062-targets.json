    },
    {
      "order": 19,
      "questionId": "qe-c14-0002",
      "sentenceId": "c14-s01-p160-05392-s001",
      "sentenceText": "Toward the end of Toni Morrison’s Jazz, Violet, the main character, recalls a conversation with her hairdresser.",
      "sentenceSha256": "78795f362b54e961b1540b93bc6be853380d72f14fbe07f9c580412fbc6769ce",
      "readingUnitId": "c14-s01-p160-05392-r001-004",
      "parentQuestionId": "q-c14-001",
      "parentFingerprint": "36fa53827ab538d105af4f6f7cf02d5053a46ba439482f3205da411459a56744",
      "passageSha256": "1a9b81fdbf78921d32371ae5d16802fe87272e69df65c02af5b3efa53bb84d6b",
      "pdfPages": [
        160
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c14-0003",
      "sentenceId": "c14-s01-p160-05392-s002",
      "sentenceText": "Her hairdresser says, “What’s the world for you if you can’t make it up the way you want it?”",
      "sentenceSha256": "35160fbb016f818e0bb3bd9f90c6d78a2d703d64ac1561c5c797260ac67d5692",
      "readingUnitId": "c14-s01-p160-05392-r001-004",
      "parentQuestionId": "q-c14-001",
      "parentFingerprint": "36fa53827ab538d105af4f6f7cf02d5053a46ba439482f3205da411459a56744",
      "passageSha256": "1a9b81fdbf78921d32371ae5d16802fe87272e69df65c02af5b3efa53bb84d6b",
      "pdfPages": [
        160
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c14-0004",
      "sentenceId": "c14-s01-p160-05392-s004",
      "sentenceText": "“What’s the point?",
      "sentenceSha256": "99795d4aea4fb8399db2f79df825a197ffd9e8d125ce5fe001928c307590ffda",
      "readingUnitId": "c14-s01-p160-05392-r001-004",
      "parentQuestionId": "q-c14-001",
      "parentFingerprint": "36fa53827ab538d105af4f6f7cf02d5053a46ba439482f3205da411459a56744",
      "passageSha256": "1a9b81fdbf78921d32371ae5d16802fe87272e69df65c02af5b3efa53bb84d6b",
      "pdfPages": [
        160
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c14-0005",
      "sentenceId": "c14-s01-p160-06562-s001",
      "sentenceText": "If you don’t think of the world the way you want it, you forget it is your life.",
      "sentenceSha256": "ce8ab37497e9feeecbcd1d6575f7117f9189c21538d9a2fc7aea5ed243402c1a",
      "readingUnitId": "c14-s01-p160-06562-r001-004",
      "parentQuestionId": "q-c14-003",
      "parentFingerprint": "0aee7b48b5787e73fbbaef9cca7fb8f31ac826260f1cb1b2b47830b62b290e14",
      "passageSha256": "2e98876edc2e958b1d4f7fcceb8dbd33aade777ae5c85a72ec1965fa30bb84fa",
      "pdfPages": [
        160,
        161
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c14-0006",
      "sentenceId": "c14-s01-p160-06562-s002",
      "sentenceText": "So, let us not forget that this is our life and that we want something more than what it is.",
      "sentenceSha256": "09db396cb1332d708d83cf04defe806bc3ce6e0e303c0cee8cb117233b62a7ca",
      "readingUnitId": "c14-s01-p160-06562-r001-004",
      "parentQuestionId": "q-c14-003",
      "parentFingerprint": "0aee7b48b5787e73fbbaef9cca7fb8f31ac826260f1cb1b2b47830b62b290e14",
      "passageSha256": "2e98876edc2e958b1d4f7fcceb8dbd33aade777ae5c85a72ec1965fa30bb84fa",
      "pdfPages": [
        160,
        161
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c14-0007",
      "sentenceId": "c14-s01-p160-06562-s003",
      "sentenceText": "Maybe more happiness, more meaning, or more psychological richness.",
      "sentenceSha256": "9459eb6a9e8a9bf24b4eebbc27e686d1b8cbad7762d3482ece5cd86e31815683",
      "readingUnitId": "c14-s01-p160-06562-r001-004",
