      "passageSha256": "5038825d68ca5c0f03554a9b92a94323a1249f5126905184cbcc3a0ea15825c7",
      "pdfPages": [
        94
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c09-0077",
      "sentenceId": "c09-s03-p094-06210-s001",
      "sentenceText": "For me, arts and sports provide rare moments to escape the endless chatter of everyday life.",
