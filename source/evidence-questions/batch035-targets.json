      "sentenceId": "c09-s02-p093-01140-s002",
      "sentenceText": "This movie is about two families: the poor Kims and the wealthy Parks, both of whom have a son and a daughter.",
      "sentenceSha256": "fd9401545ddd6638e6c3fccc12fb0653aa3de3cab9aad89496851443f23d7037",
      "readingUnitId": "c09-s02-p093-01140-r001-004",
