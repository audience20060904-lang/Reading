  "targets": [
    {
      "order": 1,
      "questionId": "qe-c09-0004",
      "sentenceId": "c09-s01-p089-04238-s003",
      "sentenceText": "He was orphaned at age six.",
      "sentenceSha256": "e8ae4220f6e0cbdbe9882f5289f7dd6ec98855bd34bfaca6d01f3d8bea4d0110",
      "readingUnitId": "c09-s01-p089-04238-r001-004",
      "parentQuestionId": "q-c09-002",
      "parentFingerprint": "2c1cc7083f0c12b61b08a951b5e1db7e8c88ee38e685bac04a17e010b0432151",
      "passageSha256": "9e5e4272f8bd223fc38f977ae3a84b89d04b361d3478a67effcc670986258198",
      "pdfPages": [
        89
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c09-0005",
      "sentenceId": "c09-s01-p089-04238-s006",
      "sentenceText": "He channeled this frustration into a career selling books, starting out with only a rug and nine books set up in the shade under a tree.",
      "sentenceSha256": "c4b078da8ec7bc69fd321dfb8787441149bc95e1a0b56779c0fc6f20357ae606",
      "readingUnitId": "c09-s01-p089-04238-r005-008",
      "parentQuestionId": "q-c09-003",
      "parentFingerprint": "d0ceaca6f07b9a9408eef65d32252beaa42b86f08968cb9d7dd279431d0b2ccd",
      "passageSha256": "36ad63b24bddac2a10954b2fe5ad834e4f84d60fa6749a2d1581b6b8cd5ff6ac",
      "pdfPages": [
        89
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c09-0006",
      "sentenceId": "c09-s01-p089-04238-s007",
      "sentenceText": "Now he owns a bookstore and spends six to eight hours a day reading.",
      "sentenceSha256": "3a4b4c138d6287062db60586649c8eda10f66d014b6a12facb25ca04de3121fd",
      "readingUnitId": "c09-s01-p089-04238-r005-008",
      "parentQuestionId": "q-c09-003",
      "parentFingerprint": "d0ceaca6f07b9a9408eef65d32252beaa42b86f08968cb9d7dd279431d0b2ccd",
      "passageSha256": "36ad63b24bddac2a10954b2fe5ad834e4f84d60fa6749a2d1581b6b8cd5ff6ac",
      "pdfPages": [
        89
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c09-0007",
      "sentenceId": "c09-s01-p089-04238-s008",
      "sentenceText": "In an interview, he said, “My life revolves around reading….",
      "sentenceSha256": "71bee6944ceac49bf5dffa6bc15c362076d6613a5d383b4d00d650a7b9ce8cb5",
      "readingUnitId": "c09-s01-p089-04238-r005-008",
      "parentQuestionId": "q-c09-003",
      "parentFingerprint": "d0ceaca6f07b9a9408eef65d32252beaa42b86f08968cb9d7dd279431d0b2ccd",
      "passageSha256": "36ad63b24bddac2a10954b2fe5ad834e4f84d60fa6749a2d1581b6b8cd5ff6ac",
      "pdfPages": [
        89
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c09-0008",
      "sentenceId": "c09-s01-p089-04238-s010",
      "sentenceText": "Aziz works twelve hours a day and rarely takes vacations.",
      "sentenceSha256": "67f0254c785d84cf7755cb93e4507092038b97281f10dfe1f9edfdfc1744d20b",
      "readingUnitId": "c09-s01-p089-04238-r009-011",
      "parentQuestionId": "q-c09-004",
      "parentFingerprint": "5ad61b148ac2b06b5f2055edc8df01c428fb46657a30e54c055e7051028ade8f",
      "passageSha256": "c77b5112550fd12f769248508bf802a785792a15af2c3b75a709bba8382fb7b2",
      "pdfPages": [
        89
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c09-0009",
      "sentenceId": "c09-s01-p089-04238-s011",
      "sentenceText": "All the same, he has accumulated a wealth of psychologically rich experiences by living 4,000 lives through 4,000 books.",
      "sentenceSha256": "dd22ebabb440850c5c4e0e675bda1e9d960a61056bea904aac9f175f4144d585",
      "readingUnitId": "c09-s01-p089-04238-r009-011",
      "parentQuestionId": "q-c09-004",
      "parentFingerprint": "5ad61b148ac2b06b5f2055edc8df01c428fb46657a30e54c055e7051028ade8f",
      "passageSha256": "c77b5112550fd12f769248508bf802a785792a15af2c3b75a709bba8382fb7b2",
      "pdfPages": [
        89
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c09-0010",
      "sentenceId": "c09-s01-p089-06382-s001",
      "sentenceText": "In Swann’s Way, the opening volume of his masterpiece In Search of Lost Time, Marcel Proust reflects upon his own reading experiences: “These afternoons were crammed with more dramatic events than occur, often, in a whole lifetime.",
      "sentenceSha256": "43f6c67bdedfb68b05d7b694f858607fdef5f76df1cb73634699d52fe5ca8426",
      "readingUnitId": "c09-s01-p089-06382-r001-002",
      "parentQuestionId": "q-c09-005",
      "parentFingerprint": "03c1e8570ece6221077cedb779ae94c6b8e665840f22250811deed9c8be83876",
      "passageSha256": "2307d6adeabc8ec8e2d216e79b93cf4fd3aaf98cf073bd1cba2709cefb583c41",
      "pdfPages": [
        89,
        90
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c09-0011",
      "sentenceId": "c09-s01-p089-06382-s003",
      "sentenceText": "He went on to describe the magic novelists wield, remarking how “for the space of an hour he [the novelist] sets free within us all the joys and sorrows in the world, a few of which only we should have to spend years of our actual life in getting to know, and the most intense of which would never be revealed to us.”",
      "sentenceSha256": "902f9d2c384f44a8241de7f7fd77d50bf59eb68592c14bc86bf12d6b9379fb82",
      "readingUnitId": "c09-s01-p089-06382-r003-004",
      "parentQuestionId": "q-c09-006",
      "parentFingerprint": "75f53fc767eb6784484f1e41fadb538e13b35e6354b1c92cf0d8d735d2a26ee0",
      "passageSha256": "bd8e6206691898f882dee0b611ab611339ba954b9a7e13637476ddf1cddea5cc",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c09-0012",
      "sentenceId": "c09-s01-p090-01920-s002",
      "sentenceText": "In the novel, Mr. Stevens (played by Anthony Hopkins in the film version) served Lord Darlington as best as he could.",
      "sentenceSha256": "a7d7d7ef670d63d56620164328cd6eb9dd5c1a03eddf1924c0bcaa7b1003bb2f",
      "readingUnitId": "c09-s01-p090-01920-r001-003",
      "parentQuestionId": "q-c09-007",
      "parentFingerprint": "0b20079e9e2af4edfb24ca4f1c6a26b134ec5a6d3223b596f6d5e92d5633737c",
      "passageSha256": "d003edd0f935d685684006790517baacd443b07520002128a332083431ac6a29",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c09-0013",
      "sentenceId": "c09-s01-p090-01920-s003",
      "sentenceText": "At the peak of his career, he managed a staff of twenty-eight as Lord Darlington hosted many important meetings during World War II.",
      "sentenceSha256": "39d9df8a6bf8eb37057b9cc6db5b92a58f21632dfe07f1668eff36cfef9471bc",
      "readingUnitId": "c09-s01-p090-01920-r001-003",
      "parentQuestionId": "q-c09-007",
      "parentFingerprint": "0b20079e9e2af4edfb24ca4f1c6a26b134ec5a6d3223b596f6d5e92d5633737c",
      "passageSha256": "d003edd0f935d685684006790517baacd443b07520002128a332083431ac6a29",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c09-0014",
      "sentenceId": "c09-s01-p090-01920-s004",
      "sentenceText": "His greatest pride was his professionalism and ability to carefully plan and perfectly execute all his duties around the house.",
      "sentenceSha256": "4cb39d54b4c69c09de7de379d726d77f3a1ae5d3e3deeafd4fd627f76a60eda9",
      "readingUnitId": "c09-s01-p090-01920-r004-006",
      "parentQuestionId": "q-c09-008",
      "parentFingerprint": "0342fb64bb07ea979bacf134c0925f6702b4f0dd7251d5cacda3ad2ea9291c61",
      "passageSha256": "a0dafa94db370e2f8049d8bd1f6656e0576552efa8007e0e2731cd3257fb06a0",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c09-0015",
      "sentenceId": "c09-s01-p090-04845-s001",
      "sentenceText": "Mr. Stevens dedicated his whole life to Lord Darlington and Darlington Hall.",
      "sentenceSha256": "4f8dadccf8a1672ca5e620258085b85ed0e887d6b06d48021508d8af24bbc175",
      "readingUnitId": "c09-s01-p090-04845-r001-004",
      "parentQuestionId": "q-c09-010",
      "parentFingerprint": "5b3cbf6d859bffcfdc89927568f11ad77af631a7ff1df6abe8ab2421a68ce403",
      "passageSha256": "486da3fdc8868b398fbadc2c8915487fd3b6d7d16a512a89d27e7197b0f6eb29",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c09-0016",
      "sentenceId": "c09-s01-p090-04845-s002",
      "sentenceText": "He had a purpose in life.",
      "sentenceSha256": "e417a4d799eb42e5340bbc0df7c3fce57c59bfc974d545ba6c0dc09eaacd51b1",
      "readingUnitId": "c09-s01-p090-04845-r001-004",
      "parentQuestionId": "q-c09-010",
      "parentFingerprint": "5b3cbf6d859bffcfdc89927568f11ad77af631a7ff1df6abe8ab2421a68ce403",
      "passageSha256": "486da3fdc8868b398fbadc2c8915487fd3b6d7d16a512a89d27e7197b0f6eb29",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c09-0017",
      "sentenceId": "c09-s01-p090-04845-s003",
      "sentenceText": "He had meaning in life—that is, until the war ended and Lord Darlington turned out to be a Nazi sympathizer and a naive, amateur diplomat whose actions ultimately harmed England.",
      "sentenceSha256": "be741de30e9be31de0ba2ec4fb6ed9d8f6f655c85081abb55c3c73988ac92062",
      "readingUnitId": "c09-s01-p090-04845-r001-004",
      "parentQuestionId": "q-c09-010",
      "parentFingerprint": "5b3cbf6d859bffcfdc89927568f11ad77af631a7ff1df6abe8ab2421a68ce403",
      "passageSha256": "486da3fdc8868b398fbadc2c8915487fd3b6d7d16a512a89d27e7197b0f6eb29",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c09-0018",
      "sentenceId": "c09-s01-p090-04845-s005",
      "sentenceText": "At the end of the novel, Mr. Stevens states: “Lord Darlington wasn’t a bad man.",
      "sentenceSha256": "5082970f5812afcc0fe708e19e0775b9e6fa8a9c1592cc27c0d62b5068fd6546",
      "readingUnitId": "c09-s01-p090-04845-r005-008",
      "parentQuestionId": "q-c09-011",
      "parentFingerprint": "5c74d3b5dc1126221ebea80edb0da6cbe3c8cb97a706e29d2a50cecbc0193583",
      "passageSha256": "6c2ff2d79dd8a9bceef6201eec0a16727b5cb963aaa69f8178b5908eb598a0d3",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c09-0019",
      "sentenceId": "c09-s01-p090-04845-s006",
      "sentenceText": "He wasn’t a bad man at all….",
      "sentenceSha256": "afb804a81861422483574518ed8affffd0e1e5a8638504e24762fa40dfd27571",
      "readingUnitId": "c09-s01-p090-04845-r005-008",
      "parentQuestionId": "q-c09-011",
      "parentFingerprint": "5c74d3b5dc1126221ebea80edb0da6cbe3c8cb97a706e29d2a50cecbc0193583",
      "passageSha256": "6c2ff2d79dd8a9bceef6201eec0a16727b5cb963aaa69f8178b5908eb598a0d3",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c09-0020",
      "sentenceId": "c09-s01-p090-04845-s007",
      "sentenceText": "His lordship was a courageous man.",
      "sentenceSha256": "1cbf0c301db1a2d41e523a314b5e82f26e44da273428d0f95a6c93ff2ccd15bd",
      "readingUnitId": "c09-s01-p090-04845-r005-008",
      "parentQuestionId": "q-c09-011",
      "parentFingerprint": "5c74d3b5dc1126221ebea80edb0da6cbe3c8cb97a706e29d2a50cecbc0193583",
      "passageSha256": "6c2ff2d79dd8a9bceef6201eec0a16727b5cb963aaa69f8178b5908eb598a0d3",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c09-0021",
      "sentenceId": "c09-s01-p090-04845-s009",
      "sentenceText": "As for myself, I cannot even claim that.",
      "sentenceSha256": "c320fbad3fb1719aff491a4b6f15d1d47f77c869ec52b8f9ccd6593f8d4e15fd",
      "readingUnitId": "c09-s01-p090-04845-r009-012",
      "parentQuestionId": "q-c09-012",
      "parentFingerprint": "0a16e9bac371a0630a155207dbe3d6f240eabad058b711fc1d55b683c2d01b0b",
      "passageSha256": "f9f1aa648a92bb6e773595b3eeba58ea32dc922871d063290148b8b87618dc9d",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c09-0022",
      "sentenceId": "c09-s01-p090-04845-s010",
      "sentenceText": "You see, I trusted.",
      "sentenceSha256": "8a5cbe99c669525cc35ce50ef45d934ab336c7723156936e498c7b58579c627a",
      "readingUnitId": "c09-s01-p090-04845-r009-012",
      "parentQuestionId": "q-c09-012",
      "parentFingerprint": "0a16e9bac371a0630a155207dbe3d6f240eabad058b711fc1d55b683c2d01b0b",
      "passageSha256": "f9f1aa648a92bb6e773595b3eeba58ea32dc922871d063290148b8b87618dc9d",
      "pdfPages": [
        90
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c09-0023",
      "sentenceId": "c09-s01-p091-00750-s001",
      "sentenceText": "While reading this novel, I was mentally transported to Darlington Hall and the events of the 1930s and the early 1940s.",
      "sentenceSha256": "cb6bb357f17e6a882f1b4cbe22bcabaaeed00d67e6470d687918c97b2af4a45c",
      "readingUnitId": "c09-s01-p091-00750-r001-003",
      "parentQuestionId": "q-c09-013",
      "parentFingerprint": "901ef564bb10e6664d6acf7c156ca7edf5168a3ea3a45356f268e5c4c1ab49a6",
      "passageSha256": "113a3bab93683064bf4c4d9634a13e8a25fba31ed2483491bfd847214f61f859",
      "pdfPages": [
        91
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c09-0024",
      "sentenceId": "c09-s01-p091-00750-s003",
      "sentenceText": "Being Japanese, I have always thought of imperial Japanese colonels and politicians as being pure evil, but I had never considered the morality of those who worked for them, who dedicated their lives to supporting them.",
      "sentenceSha256": "2c4bf5254cc2cc5c5977654fd2ff6fdc92387425bc13d4878fc34570a6a4bfa2",
      "readingUnitId": "c09-s01-p091-00750-r001-003",
      "parentQuestionId": "q-c09-013",
      "parentFingerprint": "901ef564bb10e6664d6acf7c156ca7edf5168a3ea3a45356f268e5c4c1ab49a6",
      "passageSha256": "113a3bab93683064bf4c4d9634a13e8a25fba31ed2483491bfd847214f61f859",
      "pdfPages": [
        91
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c09-0025",
      "sentenceId": "c09-s01-p091-00750-s004",
      "sentenceText": "The Remains of the Day challenged my views of some Japanese colonels during World War II and others in compromised situations: they might have been simply doing their jobs, (falsely) believing that they were serving for a greater good.",
      "sentenceSha256": "3299824267394200624d50f6447f8ba4f91ea154786b0e11d7828511b28714fe",
      "readingUnitId": "c09-s01-p091-00750-r004-007",
      "parentQuestionId": "q-c09-014",
      "parentFingerprint": "791224cdde8cf318627aaa05595800a653c45f6a1a4fa322e801b1d253e18a14",
      "passageSha256": "323e2914fb1b74320585c94c286f81366e90c764fb0b9034874145b5f3546b4f",
      "pdfPages": [
        91
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c09-0026",
      "sentenceId": "c09-s01-p091-00750-s005",
      "sentenceText": "This book certainly changed the way I view Japanese history.",
      "sentenceSha256": "6c1eae8aa9ea3a31234fcfa481b4be9d84e1fe174eb10a54b8d4b3ce440839a4",
      "readingUnitId": "c09-s01-p091-00750-r004-007",
      "parentQuestionId": "q-c09-014",
      "parentFingerprint": "791224cdde8cf318627aaa05595800a653c45f6a1a4fa322e801b1d253e18a14",
      "passageSha256": "323e2914fb1b74320585c94c286f81366e90c764fb0b9034874145b5f3546b4f",
      "pdfPages": [
        91
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c09-0027",
      "sentenceId": "c09-s01-p091-00750-s006",
      "sentenceText": "I might have been an evil colonel in their situations, a possibility that I had never entertained before.",
      "sentenceSha256": "fdd747b7b97ddd4c8590f34bb38595e03e91b33a2c336744b416a6a3139723f6",
      "readingUnitId": "c09-s01-p091-00750-r004-007",
      "parentQuestionId": "q-c09-014",
      "parentFingerprint": "791224cdde8cf318627aaa05595800a653c45f6a1a4fa322e801b1d253e18a14",
      "passageSha256": "323e2914fb1b74320585c94c286f81366e90c764fb0b9034874145b5f3546b4f",
      "pdfPages": [
        91
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c09-0028",
      "sentenceId": "c09-s02-p091-03990-s001",
      "sentenceText": "As the above example shows, it is possible to achieve psychological richness indirectly through books, movies, and art.",
      "sentenceSha256": "cde0f5300bcdd692eb1d13a5e2e559fb95fddd263566d22696e81b7f4fa8a2a3",
      "readingUnitId": "c09-s02-p091-03990-r001-004",
