  "targets": [
    {
      "order": 1,
      "questionId": "qe-c11-0007",
      "sentenceId": "c11-s01-p122-05242-s004",
      "sentenceText": "The best of humanity often comes out of the worst conditions.",
      "sentenceSha256": "e6370535604e799cddc324e79645abf6758cd738ebf6e6cb5aad2af01eebfdb8",
      "readingUnitId": "c11-s01-p122-05242-r001-004",
      "parentQuestionId": "q-c11-003",
      "parentFingerprint": "53a6912d37df71b21f38fc60c4e6200740f7e9fd70797e6afabd64f7460c9e99",
      "passageSha256": "328fcc507f491698ed4c65f149c5d8fdd40e95774b0a309e65fbe90de61bad8b",
      "pdfPages": [
        122
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c11-0008",
      "sentenceId": "c11-s01-p122-06608-s001",
      "sentenceText": "Nietzsche wrote essays comically entitled “Why I Am So Wise,” “Why I Am So Clever,” and “Why I Write Such Good Books.”",
      "sentenceSha256": "55aabcd19f2d84039f0ad9c7913505e5d104c8ff7321d67a0a535d69e8bdeb40",
      "readingUnitId": "c11-s01-p122-06608-r001-004",
      "parentQuestionId": "q-c11-004",
      "parentFingerprint": "09c670026df168817ed491fa2941c7b594057c4d8da7a933ee35b524c1afd2ff",
      "passageSha256": "200a4b0be1d7640da7b6f377f46986bf2726da53273241df43784159b9866c2f",
      "pdfPages": [
        122
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c11-0009",
      "sentenceId": "c11-s01-p122-06608-s002",
      "sentenceText": "He was a funny guy.",
      "sentenceSha256": "68d631c107bc1d665fa1dcf8117fd477a1dcce210bfe9639cdd2ab56d811b948",
      "readingUnitId": "c11-s01-p122-06608-r001-004",
      "parentQuestionId": "q-c11-004",
      "parentFingerprint": "09c670026df168817ed491fa2941c7b594057c4d8da7a933ee35b524c1afd2ff",
      "passageSha256": "200a4b0be1d7640da7b6f377f46986bf2726da53273241df43784159b9866c2f",
      "pdfPages": [
        122
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c11-0010",
      "sentenceId": "c11-s01-p122-06608-s003",
      "sentenceText": "How did he have so many insights?",
      "sentenceSha256": "69d1b7dfd71034ac7f06179a0bde019119dada91d0a38bfb28bfaccd7e872481",
      "readingUnitId": "c11-s01-p122-06608-r001-004",
      "parentQuestionId": "q-c11-004",
      "parentFingerprint": "09c670026df168817ed491fa2941c7b594057c4d8da7a933ee35b524c1afd2ff",
      "passageSha256": "200a4b0be1d7640da7b6f377f46986bf2726da53273241df43784159b9866c2f",
      "pdfPages": [
        122
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c11-0011",
      "sentenceId": "c11-s01-p122-06608-s005",
      "sentenceText": "In 1869, at age twenty-four, he was appointed chair of classical philology (the study of the history of languages) at Basel University, the youngest ever appointed to the post.",
      "sentenceSha256": "e94aa9af286eab2f82ef4656f36ed1cc4245bae15e4cc375aa140684123399d2",
      "readingUnitId": "c11-s01-p122-06608-r005-008",
      "parentQuestionId": "q-c11-005",
      "parentFingerprint": "db316d57369e6fe8dfd90200e150635c11f88ae70ec2063f69ed3d9124c6e803",
      "passageSha256": "dfceaf64fa83cde521dc3cf700c00e18e9aaacd5f010c1c041b2a44963a4a8a0",
      "pdfPages": [
        122,
        123
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c11-0012",
      "sentenceId": "c11-s01-p122-06608-s006",
      "sentenceText": "In 1876, an illness forced him to take leave from Basel.",
      "sentenceSha256": "f7a09a08bb9f141851a3bff4f2d3024116bdd3a1a09c10c854d133639a94bc2c",
      "readingUnitId": "c11-s01-p122-06608-r005-008",
      "parentQuestionId": "q-c11-005",
      "parentFingerprint": "db316d57369e6fe8dfd90200e150635c11f88ae70ec2063f69ed3d9124c6e803",
      "passageSha256": "dfceaf64fa83cde521dc3cf700c00e18e9aaacd5f010c1c041b2a44963a4a8a0",
      "pdfPages": [
        122,
        123
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c11-0013",
      "sentenceId": "c11-s01-p122-06608-s009",
      "sentenceText": "He later recalled that “it permitted, it commanded me to forget; it bestowed on me the necessity of lying still, of leisure, of waiting and being patient.",
      "sentenceSha256": "b0c0f363026c16946664afce47e6f9cda1d24ca7f986a4c872295f74487c623e",
      "readingUnitId": "c11-s01-p122-06608-r009-012",
      "parentQuestionId": "q-c11-006",
      "parentFingerprint": "1f9d49c65b1550e95983e3d5af637c21f0634078ae3ff9ff482dd0a678155deb",
      "passageSha256": "a88e093c08d09b85ee21b9205ceef4af7a9eac403d01219bb250ebb3e475faa3",
      "pdfPages": [
        123
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c11-0014",
      "sentenceId": "c11-s01-p122-06608-s010",
      "sentenceText": "But that means, of thinking.”",
      "sentenceSha256": "0ee360a8fa4c4eaa4a82877347ed0c9aab2891ddaf9762a6ec82369e961be48d",
      "readingUnitId": "c11-s01-p122-06608-r009-012",
      "parentQuestionId": "q-c11-006",
      "parentFingerprint": "1f9d49c65b1550e95983e3d5af637c21f0634078ae3ff9ff482dd0a678155deb",
      "passageSha256": "a88e093c08d09b85ee21b9205ceef4af7a9eac403d01219bb250ebb3e475faa3",
      "pdfPages": [
        123
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c11-0015",
      "sentenceId": "c11-s01-p122-06608-s012",
      "sentenceText": "Looking back on his life, Nietzsche said that he was never happier with himself than in the sickest and most painful periods of his life.",
      "sentenceSha256": "aa8986b411489001e18cafc2e784a562afac3467bdf5a04605644bd2b736af69",
      "readingUnitId": "c11-s01-p122-06608-r009-012",
      "parentQuestionId": "q-c11-006",
      "parentFingerprint": "1f9d49c65b1550e95983e3d5af637c21f0634078ae3ff9ff482dd0a678155deb",
      "passageSha256": "a88e093c08d09b85ee21b9205ceef4af7a9eac403d01219bb250ebb3e475faa3",
      "pdfPages": [
        123
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c11-0016",
      "sentenceId": "c11-s01-p122-06608-s013",
      "sentenceText": "During illness, he felt that he was returning to his natural self.",
      "sentenceSha256": "8238b75013feb3606c8bdbc91769400ba0bed52a6ff761cf48ccb57c2a80b670",
      "readingUnitId": "c11-s01-p122-06608-r013-015",
      "parentQuestionId": "q-c11-007",
      "parentFingerprint": "9de6b1472a32f4e3cefaca176139f5a146dd29de71108a0dc0fabee267ff6989",
      "passageSha256": "cd8053a797896717a9d27bd2cced21e13b4cdfd8bea0a21dd2526ee3be4db315",
      "pdfPages": [
        123
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c11-0017",
      "sentenceId": "c11-s01-p122-06608-s014",
      "sentenceText": "“Looking from the perspective of the sick toward healthier concepts and values and, conversely, looking again from the fullness and self-assurance of a rich life down into the secret work of the instinct of decadence…Now I know how, have the know-how, to reverse perspectives.”",
      "sentenceSha256": "9edfe28ae7d0cd906b0d1cca1d0ac636487b90f379616dee0c36019782353571",
      "readingUnitId": "c11-s01-p122-06608-r013-015",
      "parentQuestionId": "q-c11-007",
      "parentFingerprint": "9de6b1472a32f4e3cefaca176139f5a146dd29de71108a0dc0fabee267ff6989",
      "passageSha256": "cd8053a797896717a9d27bd2cced21e13b4cdfd8bea0a21dd2526ee3be4db315",
      "pdfPages": [
        123
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c11-0018",
      "sentenceId": "c11-s02-p123-04575-s001",
      "sentenceText": "Daniel Kahneman won the 2002 Nobel Prize in economics.",
      "sentenceSha256": "2ad3f39df42e12cd3c4482ede7fd7ec48c7ffb7e3e6afbadb2207d11ae7f43ba",
      "readingUnitId": "c11-s02-p123-04575-r001-003",
      "parentQuestionId": "q-c11-008",
      "parentFingerprint": "464f47a717f5334f13d5ed133f8f392a33233094f792f435d549a20af0791a10",
      "passageSha256": "5c5656412dd184f94de188fad17340548fae5664b5fbff448f26978d0eef66f8",
      "pdfPages": [
        123
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c11-0019",
      "sentenceId": "c11-s02-p123-04575-s002",
      "sentenceText": "With Amos Tversky, he published a series of influential papers in the 1970s and 1980s, establishing himself as one of the most prominent psychologists in the world.",
      "sentenceSha256": "21481d274fc4888fc38842fc73c7c4937508b8bcb90f427d22cb637e68c8a61f",
      "readingUnitId": "c11-s02-p123-04575-r001-003",
      "parentQuestionId": "q-c11-008",
      "parentFingerprint": "464f47a717f5334f13d5ed133f8f392a33233094f792f435d549a20af0791a10",
      "passageSha256": "5c5656412dd184f94de188fad17340548fae5664b5fbff448f26978d0eef66f8",
      "pdfPages": [
        123
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c11-0020",
      "sentenceId": "c11-s02-p123-04575-s004",
      "sentenceText": "For instance, in one widely cited 1974 paper, Tversky and Kahneman described three heuristics: the representativeness heuristic, the availability heuristic, and the anchoring and adjustment heuristic, each of which has generated thousands of further research papers.",
      "sentenceSha256": "349510eda7ed8ea4cecac7f440c7db26b3abc6ee24408b542cd549caa4353b1c",
      "readingUnitId": "c11-s02-p123-04575-r004-005",
      "parentQuestionId": "q-c11-009",
      "parentFingerprint": "efdf72b639a779232c5e8c2d5d94ca95c80181a0e02a7b0ff7fe0e1dee0cb28d",
      "passageSha256": "afd96dacc73d1d166232472a60d8717ed7d69d6f58fb06b3ee86979b2d30e895",
      "pdfPages": [
        123
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c11-0021",
      "sentenceId": "c11-s02-p123-06720-s003",
      "sentenceText": "He escaped Nazi-occupied Paris when he was seven.",
      "sentenceSha256": "c2fa0f7b9e7f893074c03a7cfff210fa085c602c2d945945760f29432ee957c8",
      "readingUnitId": "c11-s02-p123-06720-r001-004",
      "parentQuestionId": "q-c11-010",
      "parentFingerprint": "1fa727701c12541f33b518925aee222a73bafffb06c4208ff02b9589c07c7c3e",
      "passageSha256": "e06336e7661f748be664704701edb1c055591b73b95e69a650f6bdff5b7edb79",
      "pdfPages": [
        123,
        124
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c11-0022",
      "sentenceId": "c11-s02-p123-06720-s004",
      "sentenceText": "In his Nobel biography, Kahneman recalled a scary incident: “It must have been late 1941 or early 1942.",
      "sentenceSha256": "e36ddfe27c1ad0ad88345225915769af35050ee937a018e40551d47d2559ae27",
      "readingUnitId": "c11-s02-p123-06720-r001-004",
      "parentQuestionId": "q-c11-010",
      "parentFingerprint": "1fa727701c12541f33b518925aee222a73bafffb06c4208ff02b9589c07c7c3e",
      "passageSha256": "e06336e7661f748be664704701edb1c055591b73b95e69a650f6bdff5b7edb79",
      "pdfPages": [
        123,
        124
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c11-0023",
      "sentenceId": "c11-s02-p123-06720-s008",
      "sentenceText": "I turned my brown sweater inside out to walk the few blocks home.",
      "sentenceSha256": "88bf81e1a35a8709172830b081c0cf1d2681662e691cbcf8dd432fa01a7c5d7d",
      "readingUnitId": "c11-s02-p123-06720-r005-008",
      "parentQuestionId": "q-c11-011",
      "parentFingerprint": "15ea8d99aeeadbcc1f697214607e330a2f0efd93db63043181b0b56f359458df",
      "passageSha256": "045723562694ef037309cd1b73fc6b2d926926764a36f47f670b4f1e07d6a2e3",
      "pdfPages": [
        124
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c11-0024",
      "sentenceId": "c11-s02-p123-06720-s009",
      "sentenceText": "As I was walking down an empty street, I saw a German soldier approaching.",
      "sentenceSha256": "d58fce8ddeb1f05537e0c802286d086392cdf00098b7cdfd86e5c1e147dfe966",
      "readingUnitId": "c11-s02-p123-06720-r009-012",
      "parentQuestionId": "q-c11-012",
      "parentFingerprint": "8dea712b5147fb7ac58ab11893cce8917875de632a5f9c0df2a169eeb05e02d8",
      "passageSha256": "557c63396fda0721c6763f7690d926af2e1670229278162d88d14f979865620c",
      "pdfPages": [
        124
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c11-0025",
      "sentenceId": "c11-s02-p123-06720-s010",
      "sentenceText": "He was wearing the black uniform that I had been told to fear more than others—the one worn by specially recruited SS soldiers.",
      "sentenceSha256": "f65397f20eabb878f87f60f37c348ffe11321742ac84e773dfcf3b5c6686b7dc",
      "readingUnitId": "c11-s02-p123-06720-r009-012",
      "parentQuestionId": "q-c11-012",
      "parentFingerprint": "8dea712b5147fb7ac58ab11893cce8917875de632a5f9c0df2a169eeb05e02d8",
      "passageSha256": "557c63396fda0721c6763f7690d926af2e1670229278162d88d14f979865620c",
      "pdfPages": [
        124
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c11-0026",
      "sentenceId": "c11-s02-p123-06720-s011",
      "sentenceText": "As I came closer to him, trying to walk fast, I noticed that he was looking at me intently.",
      "sentenceSha256": "4efabe83caaa70600168090fe0139dc4b16788d857daa50ce51e628f2bc7758f",
      "readingUnitId": "c11-s02-p123-06720-r009-012",
      "parentQuestionId": "q-c11-012",
      "parentFingerprint": "8dea712b5147fb7ac58ab11893cce8917875de632a5f9c0df2a169eeb05e02d8",
      "passageSha256": "557c63396fda0721c6763f7690d926af2e1670229278162d88d14f979865620c",
      "pdfPages": [
        124
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c11-0027",
      "sentenceId": "c11-s02-p123-06720-s014",
      "sentenceText": "He was speaking to me with great emotion, in German.",
      "sentenceSha256": "756600c14791645191e7aca74bc23e79703cb4aad68a976cc88617f08b9b8e69",
      "readingUnitId": "c11-s02-p123-06720-r013-016",
      "parentQuestionId": "q-c11-013",
      "parentFingerprint": "5161c6cfbf87761a6bbb853b21f50fcd1091de0f24349fa6eaf15856ba7492dc",
      "passageSha256": "4025b7ba2a8e1a7046b1b85f4c207ebb4ceddd6a0b997c2288ba8c85e816e3fd",
      "pdfPages": [
        124
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c11-0028",
      "sentenceId": "c11-s02-p123-06720-s015",
      "sentenceText": "When he put me down, he opened his wallet, showed me a picture of a boy, and gave me some money.”",
      "sentenceSha256": "b5c3dbe39747e3ff4274de1c0809b5008cd5f578ef67f901e0155e1fe3f2cf0a",
      "readingUnitId": "c11-s02-p123-06720-r013-016",
      "parentQuestionId": "q-c11-013",
      "parentFingerprint": "5161c6cfbf87761a6bbb853b21f50fcd1091de0f24349fa6eaf15856ba7492dc",
      "passageSha256": "4025b7ba2a8e1a7046b1b85f4c207ebb4ceddd6a0b997c2288ba8c85e816e3fd",
      "pdfPages": [
        124
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c11-0029",
      "sentenceId": "c11-s02-p123-06720-s017",
      "sentenceText": "Kahneman went on to say, “I went home more certain than ever that my mother was right: people were endlessly complicated and interesting.”",
      "sentenceSha256": "f0e4ca0ef065834ec7cb6c559b7fb8422a1629a795a5a90410aa53d142bc52e5",
      "readingUnitId": "c11-s02-p123-06720-r017-018",
      "parentQuestionId": "q-c11-014",
      "parentFingerprint": "83a66507fc7973d609878e94378f5e8f596f0d3dc866e7ec0cf63749241baabe",
      "passageSha256": "aec4802cb8f198f1d76effe0f6e22832d43f1f9354bd14b4772062020683a758",
      "pdfPages": [
        124
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c11-0030",
      "sentenceId": "c11-s02-p124-03870-s001",
      "sentenceText": "Kahneman’s father was interned in Drancy and was supposed to be sent to an extermination camp.",
      "sentenceSha256": "6d12797b4b73eea9edd82369bb8c6e450ffe76090df1c608cd7d78d3ec271755",
      "readingUnitId": "c11-s02-p124-03870-r001-004",
      "parentQuestionId": "q-c11-015",
      "parentFingerprint": "24f7c3f3c26f4fc07bead6b066e207da1bad19cea2ccda70fab532eead08f091",
      "passageSha256": "d087e182221910f455a35d089fa05b59d889bd55033aef85c768c8fd65a01e8d",
      "pdfPages": [
        124
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c11-0031",
      "sentenceId": "c11-s02-p124-03870-s003",
      "sentenceText": "Then his family escaped to Vichy, but after the Germans arrived, they had to escape once more to the center of France.",
      "sentenceSha256": "1dea535ff26743b67cb2f8c1916385e8add4e69214e8ce6bf071ebb24a3f7a19",
      "readingUnitId": "c11-s02-p124-03870-r001-004",
      "parentQuestionId": "q-c11-015",
      "parentFingerprint": "24f7c3f3c26f4fc07bead6b066e207da1bad19cea2ccda70fab532eead08f091",
      "passageSha256": "d087e182221910f455a35d089fa05b59d889bd55033aef85c768c8fd65a01e8d",
      "pdfPages": [
        124
      ]
    }
  ]
}
