    },
    {
      "order": 21,
      "questionId": "qe-c08-0097",
      "sentenceId": "c08-s07-p088-00982-s008",
      "sentenceText": "Would I have an interesting story to tell if I did?",
      "sentenceSha256": "75a46c24347614f42d2a618499685ad54fabd1be9bd95bdcf55c42e9201b4e10",
      "readingUnitId": "c08-s07-p088-00982-r005-008",
