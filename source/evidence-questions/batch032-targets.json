      "readingUnitId": "c08-s07-p088-00982-r001-004",
      "parentQuestionId": "q-c08-059",
      "parentFingerprint": "3ba42de49facb890817a11f0bde4e3ea33660ffef8a187fc759d42219ec90aaf",
      "passageSha256": "ade7c57d59fe0ca47de72012ab92bfe5def65d21e451af661c20fa56e5368520",
      "pdfPages": [
        88
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c08-0094",
      "sentenceId": "c08-s07-p088-00982-s003",
      "sentenceText": "Building a brick patio is much harder than hiring someone to do it.",
      "sentenceSha256": "7a0a5771c7ad6f12c1ef6b1e87e4e871cd369d8f839020f2573ae91941a7c812",
      "readingUnitId": "c08-s07-p088-00982-r001-004",
      "parentQuestionId": "q-c08-059",
      "parentFingerprint": "3ba42de49facb890817a11f0bde4e3ea33660ffef8a187fc759d42219ec90aaf",
      "passageSha256": "ade7c57d59fe0ca47de72012ab92bfe5def65d21e451af661c20fa56e5368520",
      "pdfPages": [
        88
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c08-0095",
      "sentenceId": "c08-s07-p088-00982-s005",
      "sentenceText": "Familiarity generates reliable happiness, but it doesn’t generate much richness.",
      "sentenceSha256": "7d2321112d6b07f18a3a7f0f393f39b57caeb7b62691761e09bceffc79508609",
      "readingUnitId": "c08-s07-p088-00982-r005-008",
      "parentQuestionId": "q-c08-060",
      "parentFingerprint": "22d631da274b0caab2ec6075688db253b24485cc1882178a782645c01c73f299",
