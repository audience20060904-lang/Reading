  "targets": [
    {
      "order": 1,
      "questionId": "qe-c14-0034",
      "sentenceId": "c14-s02-p162-06405-s006",
      "sentenceText": "The benefit of the three-dimension framework for defining a good life is that it can be applied to the professional sphere, explaining why some jobs low in happiness or meaning could still be good— psychologically rich—jobs.",
      "sentenceSha256": "bd6a3117b0b1e99cb79a34a907e1e8903c1777efeabe764c1a5e96eda051fe94",
      "readingUnitId": "c14-s02-p162-06405-r004-006",
      "parentQuestionId": "q-c14-019",
      "parentFingerprint": "18c9df364d854ad33dbef7217279f35791c6875b1b5dece3f0f21c1a3bee391b",
      "passageSha256": "ca0e800acf5ad2e61320b944be87cbad3ad0d92de83e5f3466618ec4ba754eb7",
      "pdfPages": [
        163
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c14-0035",
      "sentenceId": "c14-s03-p163-03015-s001",
      "sentenceText": "For your next vacation, would you like to take an all-inclusive luxury tour or a low-key backpacking trip?",
      "sentenceSha256": "61dbcc82ae9f947cd96fadd26c789e482f3063a6f17f0383746810362138e81f",
      "readingUnitId": "c14-s03-p163-03015-r001-004",
      "parentQuestionId": "q-c14-020",
      "parentFingerprint": "6f8aaba73289691bf82398eead7ff0ed0256eb3d6e6ac08ce946b9a48c759ef8",
      "passageSha256": "fa2530493a5076ba60e55d5f8cef8ffeef0261a04c258daf4f82c4f7e633610b",
      "pdfPages": [
        163
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c14-0036",
      "sentenceId": "c14-s03-p163-03015-s002",
      "sentenceText": "The all-inclusive tour is easy.",
      "sentenceSha256": "e978140d8f04e45f4ee6072ccac21150e4f3959ca73dbdffeccff1a537e178d1",
      "readingUnitId": "c14-s03-p163-03015-r001-004",
      "parentQuestionId": "q-c14-020",
      "parentFingerprint": "6f8aaba73289691bf82398eead7ff0ed0256eb3d6e6ac08ce946b9a48c759ef8",
      "passageSha256": "fa2530493a5076ba60e55d5f8cef8ffeef0261a04c258daf4f82c4f7e633610b",
      "pdfPages": [
        163
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c14-0037",
      "sentenceId": "c14-s03-p163-03015-s006",
      "sentenceText": "The backpacking trip would be a lot harder.",
      "sentenceSha256": "d1795c0712058ff3f8685741ce7ed9fedd5d1cf5ae5c1869bb033df202433d74",
      "readingUnitId": "c14-s03-p163-03015-r005-008",
      "parentQuestionId": "q-c14-021",
      "parentFingerprint": "80111b25239b17345f8ab76859dd09eb764f0739394eea75299bcb68d436b0e4",
      "passageSha256": "933a450e5d035e066234452009e9f569daae3e0a1a600f8153caabbbf234400a",
      "pdfPages": [
        163
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c14-0038",
      "sentenceId": "c14-s03-p163-04380-s001",
      "sentenceText": "In the podcast Two Psychologists Four Beers, Yoel Inbar and Alexa Tullett used those trip metaphors to describe a happy life and a psychologically rich life.",
      "sentenceSha256": "991009e3baae3c59ca6c3189067258ff159b2a947e1a70c73632e564e521e063",
      "readingUnitId": "c14-s03-p163-04380-r001-004",
      "parentQuestionId": "q-c14-023",
      "parentFingerprint": "0c868349a9a07e303c601e56f27b26944cc59b19aef63c1d46050bce94a1868c",
      "passageSha256": "5125ff873d9fbbd4cc492e499136f065ef787bcebb37b40e7f61a7a1bc595840",
      "pdfPages": [
        163
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c14-0039",
      "sentenceId": "c14-s03-p163-04380-s005",
      "sentenceText": "When we asked participants from nine countries to describe an ideal life, many Americans wrote about a life that resembled a luxury cruise.",
      "sentenceSha256": "3067e0db3584780d6de3c05acec4016ea8e582cd4037f20e975c92902c26cd69",
      "readingUnitId": "c14-s03-p163-04380-r005-008",
      "parentQuestionId": "q-c14-024",
      "parentFingerprint": "38fc7b90c1bb18617de2d811de33432328188e94c6de35ec9ce4d5dc2c9c3532",
      "passageSha256": "23a85305c0c81b9075ebfa6f77f697b6072389aeec4fa96ae8256d3f3e263624",
      "pdfPages": [
        163
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c14-0040",
      "sentenceId": "c14-s03-p163-04380-s008",
      "sentenceText": "For many, a vacation (and an ideal life) is for relaxation and rejuvenation, for being served and entertained.",
      "sentenceSha256": "35e54581cfbe3548b588d264649c1f2ebbf9eea3b45228b075e77bf62630b121",
      "readingUnitId": "c14-s03-p163-04380-r005-008",
      "parentQuestionId": "q-c14-024",
      "parentFingerprint": "38fc7b90c1bb18617de2d811de33432328188e94c6de35ec9ce4d5dc2c9c3532",
      "passageSha256": "23a85305c0c81b9075ebfa6f77f697b6072389aeec4fa96ae8256d3f3e263624",
      "pdfPages": [
        163
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c14-0041",
      "sentenceId": "c14-s03-p163-06330-s001",
      "sentenceText": "A psychologically rich trip is like a backpacking trip.",
      "sentenceSha256": "77a2fa5f9a51187a33cc8eb70eb0c6e101cdce3b40601163eaf84bdfadceeabe",
      "readingUnitId": "c14-s03-p163-06330-r001-004",
      "parentQuestionId": "q-c14-025",
      "parentFingerprint": "b1627ac0d8b7723643915a25524155d16db2a0222e043d2c68641a36cba61c0a",
      "passageSha256": "8410905cdfaa3914815ddcdcc758cb45df5df003ac02824a51dc081e3a909a59",
      "pdfPages": [
        163
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c14-0042",
      "sentenceId": "c14-s03-p163-06330-s007",
      "sentenceText": "A seventy-hour bus ride…not exactly fun.",
      "sentenceSha256": "e47b8f05d520b15051918b43099fbca445bb6d86bc46da002fb98d533ef8303a",
      "readingUnitId": "c14-s03-p163-06330-r006-007",
      "parentQuestionId": "q-c14-027",
      "parentFingerprint": "7e019250b2b96c399defbea3978c0bf52817af43d90406d99cc482e0310ed8d5",
      "passageSha256": "8436925f5724ef2fee8eca1ad5bba9b7432be5d031af22ac45e51eb4ae5a8edf",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c14-0043",
      "sentenceId": "c14-s03-p164-02115-s002",
      "sentenceText": "All we could afford were youth hostels.",
      "sentenceSha256": "e399ac27d91528b711b3152c48b31089733c9b26a056f3d434eb0b353acdcdea",
      "readingUnitId": "c14-s03-p164-02115-r001-004",
      "parentQuestionId": "q-c14-028",
      "parentFingerprint": "eea34e51bce66bd4dabb1f47be95a9787c71fd60faa823edb0d9fa5f9dd36475",
      "passageSha256": "36532871581e1354363891078278c1c7b5269830211ed78d8c00e71ed92e8e41",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c14-0044",
      "sentenceId": "c14-s03-p164-02115-s003",
      "sentenceText": "The Greyhound stations were almost always in downtown areas, which were not the safest back in 1988.",
      "sentenceSha256": "f8f9d862918df2134a49754c91e110ee49a33ec1fd0c8763981be7d5038c27c0",
      "readingUnitId": "c14-s03-p164-02115-r001-004",
      "parentQuestionId": "q-c14-028",
      "parentFingerprint": "eea34e51bce66bd4dabb1f47be95a9787c71fd60faa823edb0d9fa5f9dd36475",
      "passageSha256": "36532871581e1354363891078278c1c7b5269830211ed78d8c00e71ed92e8e41",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c14-0045",
      "sentenceId": "c14-s03-p164-02115-s005",
      "sentenceText": "In New York City, a guy just outside our youth hostel on Forty-Second Street approached me and asked if he could borrow $20.",
      "sentenceSha256": "583ae8c10926f30e5a8353de0a1333f488a4ddc5be6eac0e72e08aab87a73bd9",
      "readingUnitId": "c14-s03-p164-02115-r005-008",
      "parentQuestionId": "q-c14-029",
      "parentFingerprint": "7db82a2b92c568b0b56dad232b7207504597d59ccc093bca609faf85108620d1",
      "passageSha256": "190cc9312a273a0d02c1c13f63fd461bcf8ce1d3d1c49ea42b4f44a99acbb614",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c14-0046",
      "sentenceId": "c14-s03-p164-02115-s006",
      "sentenceText": "A Citibank was right there.",
      "sentenceSha256": "6a43ba87a68f62dea6d0b24b2e74bad0c9941f3414d8a24c67066b216fd1387a",
      "readingUnitId": "c14-s03-p164-02115-r005-008",
      "parentQuestionId": "q-c14-029",
      "parentFingerprint": "7db82a2b92c568b0b56dad232b7207504597d59ccc093bca609faf85108620d1",
      "passageSha256": "190cc9312a273a0d02c1c13f63fd461bcf8ce1d3d1c49ea42b4f44a99acbb614",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c14-0047",
      "sentenceId": "c14-s03-p164-02115-s008",
      "sentenceText": "“Follow me,” he said.",
      "sentenceSha256": "5c87b6ebe44bf9364ee4d22d4d2c14147205357f54d871b1cfc46df8524c391e",
      "readingUnitId": "c14-s03-p164-02115-r005-008",
      "parentQuestionId": "q-c14-029",
      "parentFingerprint": "7db82a2b92c568b0b56dad232b7207504597d59ccc093bca609faf85108620d1",
      "passageSha256": "190cc9312a273a0d02c1c13f63fd461bcf8ce1d3d1c49ea42b4f44a99acbb614",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c14-0048",
      "sentenceId": "c14-s03-p164-02115-s009",
      "sentenceText": "So I followed him to the bank and queued in line.",
      "sentenceSha256": "1f8f07a31ac8cd1686b57db4f96fed503159543e21d4e180a087e3abfdbca1fc",
      "readingUnitId": "c14-s03-p164-02115-r009-011",
      "parentQuestionId": "q-c14-030",
      "parentFingerprint": "ae2c48a437d3dae037321bc8736ecd035dccee96b9141cd31f0bbe20864e53fe",
      "passageSha256": "3a0c8b73cda7db071c71ecc6239bf4394beea81e8ce2338144482b17a5aa5151",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c14-0049",
      "sentenceId": "c14-s03-p164-02115-s010",
      "sentenceText": "After a while, he disappeared.",
      "sentenceSha256": "4e1b0372eefb7116f5bc17c53eedee216a10a51c9225fecde4043581843fcdea",
      "readingUnitId": "c14-s03-p164-02115-r009-011",
      "parentQuestionId": "q-c14-030",
      "parentFingerprint": "ae2c48a437d3dae037321bc8736ecd035dccee96b9141cd31f0bbe20864e53fe",
      "passageSha256": "3a0c8b73cda7db071c71ecc6239bf4394beea81e8ce2338144482b17a5aa5151",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c14-0050",
      "sentenceId": "c14-s03-p164-04260-s001",
      "sentenceText": "Our bus from New York arrived in Washington D.C. in the early morning and we ended up falling asleep on a park bench near the White House.",
      "sentenceSha256": "52c40da444b819a593cbf4f2b7eab6765b3568419925c5e0bd2bb8c47feee970",
      "readingUnitId": "c14-s03-p164-04260-r001-004",
      "parentQuestionId": "q-c14-031",
      "parentFingerprint": "e8c8033e747c5dbe23054317b9169c1ddcc0e25674880df9258d54afe8b7d640",
      "passageSha256": "99a88a75ecd8385cf7697fa0f007b51c6beea64dd408aa4962b6668f7997cda7",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c14-0051",
      "sentenceId": "c14-s03-p164-04260-s002",
      "sentenceText": "It wasn’t long before a group of police officers on horseback appeared.",
      "sentenceSha256": "fe830022c758f46aeded2ebb79970ef8cf4bf9eadc2eb72aa8cf7c3e0d491958",
      "readingUnitId": "c14-s03-p164-04260-r001-004",
      "parentQuestionId": "q-c14-031",
      "parentFingerprint": "e8c8033e747c5dbe23054317b9169c1ddcc0e25674880df9258d54afe8b7d640",
      "passageSha256": "99a88a75ecd8385cf7697fa0f007b51c6beea64dd408aa4962b6668f7997cda7",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c14-0052",
      "sentenceId": "c14-s03-p164-05430-s001",
      "sentenceText": "When we were in Chicago, there was a huge festival in Grant Park.",
      "sentenceSha256": "a12fbe759b8eece47363fa9b5ce801c3c53642451d7966144085077391bdfa9d",
      "readingUnitId": "c14-s03-p164-05430-r001-004",
      "parentQuestionId": "q-c14-033",
      "parentFingerprint": "843d6380ec2d027dda725a0dd916ab862680b52ab46e721f547de16cc0569547",
      "passageSha256": "d89ffb16d5fbeb24166c625c1682fe19c04cbc3771abdf5ff3046d75c5d19321",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c14-0053",
      "sentenceId": "c14-s03-p164-05430-s002",
      "sentenceText": "My friend went to see a White Sox game, but I wanted to go to this festival.",
      "sentenceSha256": "ee6883b7b76836d67b19a92af3ecf65231941f355871837d10f37c3ddc065981",
      "readingUnitId": "c14-s03-p164-05430-r001-004",
      "parentQuestionId": "q-c14-033",
      "parentFingerprint": "843d6380ec2d027dda725a0dd916ab862680b52ab46e721f547de16cc0569547",
      "passageSha256": "d89ffb16d5fbeb24166c625c1682fe19c04cbc3771abdf5ff3046d75c5d19321",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c14-0054",
      "sentenceId": "c14-s03-p164-05430-s005",
      "sentenceText": "Then we started talking.",
      "sentenceSha256": "af79086c15b7575852ee0f7c03fe5a8b17f36af4cacbf157b988222187962afc",
      "readingUnitId": "c14-s03-p164-05430-r005-008",
      "parentQuestionId": "q-c14-034",
      "parentFingerprint": "87602891d04073a5d674c6214ddb116a9f1b3f0c012aa133d43088354918e940",
      "passageSha256": "241e5ba7e2a11ad487e77c6dc84ee979757744cbf394ca7d3efdaad0fdad6970",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c14-0055",
      "sentenceId": "c14-s03-p164-05430-s006",
      "sentenceText": "Before long, they were so nice that they invited me to a party at one of their houses.",
      "sentenceSha256": "576f274d1246817a74b662d6dd3f2f955f1027d36ddcf2ba8fd835a098d74e16",
      "readingUnitId": "c14-s03-p164-05430-r005-008",
      "parentQuestionId": "q-c14-034",
      "parentFingerprint": "87602891d04073a5d674c6214ddb116a9f1b3f0c012aa133d43088354918e940",
      "passageSha256": "241e5ba7e2a11ad487e77c6dc84ee979757744cbf394ca7d3efdaad0fdad6970",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c14-0056",
      "sentenceId": "c14-s03-p164-05430-s008",
      "sentenceText": "It was the only time I had any alcohol during that trip.",
      "sentenceSha256": "cf9d70e02dea1c81cc14df62b497386d502c84960cb2d968f7629cd51a79d168",
      "readingUnitId": "c14-s03-p164-05430-r005-008",
      "parentQuestionId": "q-c14-034",
      "parentFingerprint": "87602891d04073a5d674c6214ddb116a9f1b3f0c012aa133d43088354918e940",
      "passageSha256": "241e5ba7e2a11ad487e77c6dc84ee979757744cbf394ca7d3efdaad0fdad6970",
      "pdfPages": [
        164
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c14-0057",
      "sentenceId": "c14-s03-p164-05430-s009",
      "sentenceText": "I fell asleep at the party house.",
      "sentenceSha256": "546c1afe3511a86d59a47060ba26bb0c20992323b6488d68455b788d2aae9024",
      "readingUnitId": "c14-s03-p164-05430-r009-012",
      "parentQuestionId": "q-c14-035",
      "parentFingerprint": "c59a6205d485fc1812297262d13d7d2a0b8c3e50bde9b4a3899df6bbf5354080",
      "passageSha256": "de94149836275aabe82356b8340c258549099dd1ac114be0070ff319dce0d8da",
      "pdfPages": [
        164,
        165
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c14-0058",
      "sentenceId": "c14-s03-p164-05430-s010",
      "sentenceText": "The next morning, one of the people I’d met gave me a ride back to the downtown YMCA where I was staying.",
      "sentenceSha256": "f2c2c346352758ed13ef08a887079c29ccad11364dcda01fc49c67c3b8c025d2",
      "readingUnitId": "c14-s03-p164-05430-r009-012",
