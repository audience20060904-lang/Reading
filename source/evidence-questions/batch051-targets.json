  "targets": [
    {
      "order": 1,
      "questionId": "qe-c11-0082",
      "sentenceId": "c11-s05-p129-02700-s001",
      "sentenceText": "Is there other evidence that shows the long-term effect of experiencing natural disasters on victims’ values and occupational preferences?",
      "sentenceSha256": "ed335eec4658a377e6a55eef6224e90e7e0a8e8944efc08681bc1e58f774e4a9",
      "readingUnitId": "c11-s05-p129-02700-r001-003",
      "parentQuestionId": "q-c11-047",
      "parentFingerprint": "8a5c74d7643bef1d7da812d3dcbce100a780a5cfe9812f86e2857198d7d11ef9",
      "passageSha256": "dcf5c71e814d851201ef074cef810372d391f4a7a5b1ae2bd43d6820a636ffd1",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c11-0083",
      "sentenceId": "c11-s05-p129-02700-s003",
      "sentenceText": "We looked at how many people applied to become social workers, firefighters, and kindergarten teachers (jobs hired at the municipal level in Japan).",
      "sentenceSha256": "76533e9f607bc17649110b135768d03d89c6b72738a7abd881074c0da5e6f6c6",
      "readingUnitId": "c11-s05-p129-02700-r001-003",
      "parentQuestionId": "q-c11-047",
      "parentFingerprint": "8a5c74d7643bef1d7da812d3dcbce100a780a5cfe9812f86e2857198d7d11ef9",
      "passageSha256": "dcf5c71e814d851201ef074cef810372d391f4a7a5b1ae2bd43d6820a636ffd1",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c11-0084",
      "sentenceId": "c11-s05-p129-02700-s005",
      "sentenceText": "These findings suggest that the earthquake made prosocial jobs more desirable.",
      "sentenceSha256": "23a342ec2b582fdd715cebbb27c41d7e3f3981f3b294418eabd6028864af4373",
      "readingUnitId": "c11-s05-p129-02700-r004-005",
      "parentQuestionId": "q-c11-048",
      "parentFingerprint": "a930c93b19bf0a3dfc26396e592a7be3c35c0a6c2458fdefa741b597e0066e55",
      "passageSha256": "fc036b2cfcc7a3fde7ae1a570cd20a35ebc03836d02140473664b5d224fac2e8",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c11-0085",
      "sentenceId": "c11-s05-p129-04650-s001",
      "sentenceText": "Recall that, even sixteen years after the Hanshin-Awaji earthquake, Kobe residents who had lost their houses in the quake were less satisfied with their lives and reported more physical symptoms than those whose houses had not been damaged.",
      "sentenceSha256": "ada91d867176fdf133e080af225cb1454f17010ac45603d765137eb87e3518cf",
      "readingUnitId": "c11-s05-p129-04650-r001-004",
      "parentQuestionId": "q-c11-049",
      "parentFingerprint": "1e037d5eb69460576034ba0c5d1cd4dafbdbc1054ec42b4c74dc0205bed9d861",
      "passageSha256": "750b9ce33aad383cce6e3e54abd9742fc42b849a56182bb458e873aa6ec04d26",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c11-0086",
      "sentenceId": "c11-s05-p129-04650-s003",
      "sentenceText": "The tragedy becomes ingrained in their identities and life stories and can rob them of happiness and normalcy.",
      "sentenceSha256": "4965f91e0fa7518f70c8f47c1916cc85beae4cb35613f5f46f3ee40045996eb1",
      "readingUnitId": "c11-s05-p129-04650-r001-004",
      "parentQuestionId": "q-c11-049",
      "parentFingerprint": "1e037d5eb69460576034ba0c5d1cd4dafbdbc1054ec42b4c74dc0205bed9d861",
      "passageSha256": "750b9ce33aad383cce6e3e54abd9742fc42b849a56182bb458e873aa6ec04d26",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c11-0087",
      "sentenceId": "c11-s05-p129-04650-s004",
      "sentenceText": "No one wishes to suffer such a tragedy.",
      "sentenceSha256": "9bbc7c189907fd98f6b31369bdee7443e048898b455067e3db00b0909af5e0c5",
      "readingUnitId": "c11-s05-p129-04650-r001-004",
      "parentQuestionId": "q-c11-049",
      "parentFingerprint": "1e037d5eb69460576034ba0c5d1cd4dafbdbc1054ec42b4c74dc0205bed9d861",
      "passageSha256": "750b9ce33aad383cce6e3e54abd9742fc42b849a56182bb458e873aa6ec04d26",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c11-0088",
      "sentenceId": "c11-s05-p129-04650-s005",
      "sentenceText": "Yet, even if happiness is impossible in the aftermath, survivors can still lead a good life.",
      "sentenceSha256": "bc04ee4e9f0f8e6d4af94d1ea6926329b5140d71e102bb41e93c5c56c32898a0",
      "readingUnitId": "c11-s05-p129-04650-r005-008",
      "parentQuestionId": "q-c11-050",
      "parentFingerprint": "56fc2a093a60866aaa1cf105d9eac4c7aa85a4d9c3fe5b9f164ffab1c06374b2",
      "passageSha256": "a245537e2113e0d31b5d0d13e2945d9989ebf2e5fd2f3bbb0027383d6708da79",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c11-0089",
      "sentenceId": "c11-s05-p129-04650-s006",
      "sentenceText": "Indeed, some of the best qualities of humankind emerge as antidotes to grief in these difficult times: many survivors become more prosocial.",
      "sentenceSha256": "4efe63927d75342e12e0e698b617e93bf4433e4e2ddd0a285ea8b0313cc568e9",
      "readingUnitId": "c11-s05-p129-04650-r005-008",
      "parentQuestionId": "q-c11-050",
      "parentFingerprint": "56fc2a093a60866aaa1cf105d9eac4c7aa85a4d9c3fe5b9f164ffab1c06374b2",
      "passageSha256": "a245537e2113e0d31b5d0d13e2945d9989ebf2e5fd2f3bbb0027383d6708da79",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c11-0090",
      "sentenceId": "c11-s05-p129-04650-s008",
      "sentenceText": "They discovered “a treasure amidst ruins.”",
      "sentenceSha256": "1d7b9a74e32be098c4f54825a8f0039384ebbc5cb61f736a42d352876ff99996",
      "readingUnitId": "c11-s05-p129-04650-r005-008",
      "parentQuestionId": "q-c11-050",
      "parentFingerprint": "56fc2a093a60866aaa1cf105d9eac4c7aa85a4d9c3fe5b9f164ffab1c06374b2",
      "passageSha256": "a245537e2113e0d31b5d0d13e2945d9989ebf2e5fd2f3bbb0027383d6708da79",
      "pdfPages": [
        129
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c11-0091",
      "sentenceId": "c11-s06-p130-00982-s001",
      "sentenceText": "The COVID-19 pandemic disrupted all of our lives, changing the way we live and work.",
      "sentenceSha256": "7c91e0b2a7bcf4367c3cb7b81b9e693f7d008d03607c8c32a7f91525915266fb",
      "readingUnitId": "c11-s06-p130-00982-r001-004",
      "parentQuestionId": "q-c11-051",
      "parentFingerprint": "84567bef7f48a0ef2e6f3dd09dab03ad169e717a9420a41c16a6860fe9256f18",
      "passageSha256": "4d14380a17abdf7610082170fa21e99148da094c95490f7ad0f339ea9e0ed27d",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c11-0092",
      "sentenceId": "c11-s06-p130-00982-s002",
      "sentenceText": "Has it changed the way we view the world?",
      "sentenceSha256": "68285d5afc60b50cdd27f80f03e290468702a1bbc4481c86b6196e1f301b53d5",
      "readingUnitId": "c11-s06-p130-00982-r001-004",
      "parentQuestionId": "q-c11-051",
      "parentFingerprint": "84567bef7f48a0ef2e6f3dd09dab03ad169e717a9420a41c16a6860fe9256f18",
      "passageSha256": "4d14380a17abdf7610082170fa21e99148da094c95490f7ad0f339ea9e0ed27d",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c11-0093",
      "sentenceId": "c11-s06-p130-00982-s003",
      "sentenceText": "Has it enhanced psychological richness?",
      "sentenceSha256": "514a7b16542ff6db25e011f24cd31a7cc12cf1da640ec21a2f0c0cd3846fa482",
      "readingUnitId": "c11-s06-p130-00982-r001-004",
      "parentQuestionId": "q-c11-051",
      "parentFingerprint": "84567bef7f48a0ef2e6f3dd09dab03ad169e717a9420a41c16a6860fe9256f18",
      "passageSha256": "4d14380a17abdf7610082170fa21e99148da094c95490f7ad0f339ea9e0ed27d",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c11-0094",
      "sentenceId": "c11-s06-p130-00982-s005",
      "sentenceText": "Participants were given an unexpected monetary bonus: $5 in the U.S. and €4 in Italy.",
      "sentenceSha256": "06a9c22a2745047b7526ea54bba9a3f7aac41f522add419c3ef3b27f6a99695f",
      "readingUnitId": "c11-s06-p130-00982-r005-008",
      "parentQuestionId": "q-c11-052",
      "parentFingerprint": "0c6b0fd853231ad8b2d3b61bfe318cbea47179eec5f4116ba4c918487f35fe2b",
      "passageSha256": "5529570c92899a28a2958973d2361ca0b4a0f319b4a63f49bb35d70fae1fdd1c",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c11-0095",
      "sentenceId": "c11-s06-p130-00982-s006",
      "sentenceText": "Then they were asked if they would like to donate some of the money to a charity in the state/region where they lived, a national charity, or an international charity.",
      "sentenceSha256": "9bbe21887223e00e218fcab340bca90530d8b23d4648899a2f51db2373f20b2f",
      "readingUnitId": "c11-s06-p130-00982-r005-008",
      "parentQuestionId": "q-c11-052",
      "parentFingerprint": "0c6b0fd853231ad8b2d3b61bfe318cbea47179eec5f4116ba4c918487f35fe2b",
      "passageSha256": "5529570c92899a28a2958973d2361ca0b4a0f319b4a63f49bb35d70fae1fdd1c",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c11-0096",
      "sentenceId": "c11-s06-p130-00982-s008",
      "sentenceText": "Both American and Italian participants exposed to COVID-19 not only were more likely to donate to a charity than those who were unexposed, but also donated more.",
      "sentenceSha256": "545169502fa579d548ab7434a18945b2fb652a43a560717e4ae9bb372953141a",
      "readingUnitId": "c11-s06-p130-00982-r005-008",
      "parentQuestionId": "q-c11-052",
      "parentFingerprint": "0c6b0fd853231ad8b2d3b61bfe318cbea47179eec5f4116ba4c918487f35fe2b",
      "passageSha256": "5529570c92899a28a2958973d2361ca0b4a0f319b4a63f49bb35d70fae1fdd1c",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c11-0097",
      "sentenceId": "c11-s06-p130-03908-s001",
      "sentenceText": "Did an unusual experience of COVID-19 increase psychological richness?",
      "sentenceSha256": "cf0dc8c5817ea151a966988e88f037d309ad61a70ac13af03aafa6c949059f8f",
      "readingUnitId": "c11-s06-p130-03908-r001-004",
      "parentQuestionId": "q-c11-054",
      "parentFingerprint": "0f08db636de3f7a19dae32bf9f705beeb05247c84f07fbe4ea60eb366ed20e30",
      "passageSha256": "e775fac0b6dea84353e7da007ec2cf2e82988949f5424733d8ee55a8a54d9fee",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c11-0098",
      "sentenceId": "c11-s06-p130-03908-s002",
      "sentenceText": "Micael Dahlen and Helge Thorbjørnsen directly tested this question.",
      "sentenceSha256": "1c19952caecd1557b9509e8cb2cd3e765ca106bd3be58cefe792cf34c7ecdb8c",
      "readingUnitId": "c11-s06-p130-03908-r001-004",
      "parentQuestionId": "q-c11-054",
      "parentFingerprint": "0f08db636de3f7a19dae32bf9f705beeb05247c84f07fbe4ea60eb366ed20e30",
      "passageSha256": "e775fac0b6dea84353e7da007ec2cf2e82988949f5424733d8ee55a8a54d9fee",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c11-0099",
      "sentenceId": "c11-s06-p130-03908-s003",
      "sentenceText": "During the second week of April 2021, 973 Swedes anonymously filled out a questionnaire that asked about their COVID-19 status as well as whether they felt they were living a psychologically rich life.",
      "sentenceSha256": "e4c2bf8a92f05c5ef582c8446e6faac3120cec9d47f355a045cb9080dc855f61",
      "readingUnitId": "c11-s06-p130-03908-r001-004",
      "parentQuestionId": "q-c11-054",
      "parentFingerprint": "0f08db636de3f7a19dae32bf9f705beeb05247c84f07fbe4ea60eb366ed20e30",
      "passageSha256": "e775fac0b6dea84353e7da007ec2cf2e82988949f5424733d8ee55a8a54d9fee",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c11-0100",
      "sentenceId": "c11-s06-p130-03908-s006",
      "sentenceText": "That is, those who’d had COVID-19 regretted less than those who had not.",
      "sentenceSha256": "82f96a4ff04dcd9bd34f277e1ccfedfc652453be59d5619b5cd3a5a6689c40ba",
      "readingUnitId": "c11-s06-p130-03908-r005-006",
      "parentQuestionId": "q-c11-055",
      "parentFingerprint": "211a4d04a034eb130e0bc7169057807c42966315b5e1598acfa9ced07038e4e3",
      "passageSha256": "f013d23632246ad546d4dde39713226a7398b804eb68313a8d490b2afd85ac16",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c11-0101",
      "sentenceId": "c11-s06-p130-05858-s001",
      "sentenceText": "Dahlen and Thorbjørnsen then conducted a second survey from a representative sample of Swedes in June 2021.",
      "sentenceSha256": "0715ea3bffddfd1970a7753294373b0e56f43554fb1b00c68ad199113694b7a4",
      "readingUnitId": "c11-s06-p130-05858-r001-004",
      "parentQuestionId": "q-c11-056",
      "parentFingerprint": "ad73a6fa9e769792d4a9e762fba849351183c15c33bd69e0416af24452eb5ce5",
      "passageSha256": "bb4aada3d43b7e7fd8fcc41389a3ee64df8cf11fc76f11223b57d5db0bb38b83",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c11-0102",
      "sentenceId": "c11-s06-p130-05858-s002",
      "sentenceText": "Replicating the results from the first study, those who’d previously caught COVID-19 reported that their lives were psychologically richer than those who had not.",
      "sentenceSha256": "711f2073293bf62e644cadb353301b2cf3d1a4dd29827dc9591247ced6f99639",
      "readingUnitId": "c11-s06-p130-05858-r001-004",
      "parentQuestionId": "q-c11-056",
      "parentFingerprint": "ad73a6fa9e769792d4a9e762fba849351183c15c33bd69e0416af24452eb5ce5",
      "passageSha256": "bb4aada3d43b7e7fd8fcc41389a3ee64df8cf11fc76f11223b57d5db0bb38b83",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c11-0103",
      "sentenceId": "c11-s06-p130-05858-s004",
      "sentenceText": "So it appears that the experience of COVID-19 made them less afraid of death and helped them live without fear.",
      "sentenceSha256": "08272e417359f1311bf8eb9e3f86062869fc61d06a52f2578b708af727349018",
      "readingUnitId": "c11-s06-p130-05858-r001-004",
      "parentQuestionId": "q-c11-056",
      "parentFingerprint": "ad73a6fa9e769792d4a9e762fba849351183c15c33bd69e0416af24452eb5ce5",
      "passageSha256": "bb4aada3d43b7e7fd8fcc41389a3ee64df8cf11fc76f11223b57d5db0bb38b83",
      "pdfPages": [
        130
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c11-0104",
      "sentenceId": "c11-s07-p131-01845-s003",
      "sentenceText": "A day after the Great Kanto earthquake in 1923, a rumor that Koreans were looting and rioting spread quickly.",
      "sentenceSha256": "04151cf12f884665b379fdd10dcfb933a87d6fc6be62e08d1f5613e315507425",
      "readingUnitId": "c11-s07-p131-01845-r001-004",
      "parentQuestionId": "q-c11-058",
      "parentFingerprint": "309c0857eb53ce82ffe996b329770a93508db0aff9ed92f05df1191fa58cae3b",
      "passageSha256": "676df2a07191c2e873a52ace65638032ee8e208e36fe2604c3ac31c8fba00d9f",
      "pdfPages": [
        131
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c11-0105",
      "sentenceId": "c11-s07-p131-01845-s004",
      "sentenceText": "A panic ensued, and at least 6,000 Koreans were killed in the greater Tokyo area.",
      "sentenceSha256": "93efa91a5507f1fa54d57aadee58e17eda90caf5c87553298ee70a13f733028f",
      "readingUnitId": "c11-s07-p131-01845-r001-004",
      "parentQuestionId": "q-c11-058",
      "parentFingerprint": "309c0857eb53ce82ffe996b329770a93508db0aff9ed92f05df1191fa58cae3b",
      "passageSha256": "676df2a07191c2e873a52ace65638032ee8e208e36fe2604c3ac31c8fba00d9f",
      "pdfPages": [
        131
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c11-0106",
      "sentenceId": "c11-s07-p131-01845-s006",
      "sentenceText": "Vigilantes were formed and they inflicted unprovoked violence on Black residents.",
      "sentenceSha256": "c140836da0b06d0315558b508d65601963b874d3dc637ebf9ad95b22e2d3ba69",
      "readingUnitId": "c11-s07-p131-01845-r005-008",
