      "pdfPages": [
        115
      ]
    },
    {
      "order": 2,
      "questionId": "qe-c10-0129",
      "sentenceId": "c10-s07-p115-05430-s004",
      "sentenceText": "It doesn’t make rational sense, but psychologically it does.",
      "sentenceSha256": "af8955db826c04987dda2a4f9255f022542c5b6631fd9dcf1ca0006b347901b2",
      "readingUnitId": "c10-s07-p115-05430-r001-004",
      "parentQuestionId": "q-c10-078",
      "parentFingerprint": "cad54696feea0b1f4cdbcc6c545dca4738efda81d34d6b7e90fe279b041d5e59",
      "passageSha256": "7638031d15456f947f761c3fe8a64a114cfb6997d86c2bb3191f4a26bfa6638b",
      "pdfPages": [
        115
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c10-0130",
      "sentenceId": "c10-s07-p115-05430-s005",
      "sentenceText": "We can commiserate and understand each other.",
      "sentenceSha256": "9fa0508cbaf72b84714c54ee6c6a183c564ce9e4e36207f1790bdc430e2cdcce",
      "readingUnitId": "c10-s07-p115-05430-r005-008",
      "parentQuestionId": "q-c10-079",
      "parentFingerprint": "72dbf388d88c036697391f146fba3409a36bc8fb6dd059495b36978ed78d07b1",
      "passageSha256": "05a08d8ee362965ba0704d8a49bc7221e503fd462f62315406201fd84864d58d",
      "pdfPages": [
        115
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c10-0131",
      "sentenceId": "c10-s07-p115-05430-s006",
      "sentenceText": "Familiarity is a powerful force.",
      "sentenceSha256": "27019f2aecd42d2c514cb7ec06b1d163c009f4e23ac4cc831660b25fb221831a",
      "readingUnitId": "c10-s07-p115-05430-r005-008",
