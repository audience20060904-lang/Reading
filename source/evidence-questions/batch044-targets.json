      "questionId": "qe-c10-0128",
      "sentenceId": "c10-s07-p115-05430-s003",
      "sentenceText": "Why did I go all the way from Tokyo to Lewiston, Maine, to hang out with other Japanese people?",
      "sentenceSha256": "18acc59b184cb1e249eac2061d16ad3d4c51fa90295176bad12c5b5469a3d391",
      "readingUnitId": "c10-s07-p115-05430-r001-004",
