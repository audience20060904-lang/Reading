      "passageSha256": "05a08d8ee362965ba0704d8a49bc7221e503fd462f62315406201fd84864d58d",
      "pdfPages": [
        115
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c10-0132",
      "sentenceId": "c10-s08-p116-01650-s001",
      "sentenceText": "Take house hunting, for example.",
      "sentenceSha256": "077f2841ab2ff0203aa4542e70aa09fcddca4a2242920c2d478bb93b5e312eb7",
      "readingUnitId": "c10-s08-p116-01650-r001-004",
      "parentQuestionId": "q-c10-081",
