    },
    {
      "order": 2,
      "questionId": "qe-c01-0002",
      "sentenceId": "c01-s01-p007-03458-s005",
      "sentenceText": "He played in a neighborhood softball league into his fifties and enjoyed annual neighborhood association trips to various hot springs.",
      "sentenceSha256": "d337458a1dd721ae9097ac26edc4a06007fedfea972a062c92b90a0fef8bc598",
      "readingUnitId": "c01-s01-p007-03458-r004-006",
      "parentQuestionId": "q-c01-034",
      "parentFingerprint": "448d119d1d1abb7e189f5ab072a0ac263c4dea907db5c99945caf2c93720d11e",
      "passageSha256": "4860250cf6926f69622e3ea6671e28aa109b8fe6599adbe363d8a712afe648b7",
      "pdfPages": [
        7
      ]
    },
    {
      "order": 3,
      "questionId": "qe-c01-0003",
      "sentenceId": "c01-s01-p007-05992-s001",
      "sentenceText": "Yoshi is my father, and I am his son a world away.",
      "sentenceSha256": "dc6a4f1a313327242d8fd7e71931e78e2b0207a066c85f010eb8cfbd3cd138bf",
      "readingUnitId": "c01-s01-p007-05992-r001-002",
      "parentQuestionId": "q-c01-035",
      "parentFingerprint": "340d16e3c64478c1d1058f61c0dd8e3d760dc427b828e7af562930a54c7b32b8",
      "passageSha256": "709e9a03c199eac4082555d4a4e8ed5726869c576552d4bf7afd720de41eaa9f",
      "pdfPages": [
        7
      ]
    },
    {
      "order": 4,
      "questionId": "qe-c01-0004",
      "sentenceId": "c01-s01-p007-05992-s005",
      "sentenceText": "I had just broken up with my girlfriend in Tokyo and was tired of being in a relationship.",
      "sentenceSha256": "ddd6b7ca85355a5d41d5f14fa6623e407692aa3438a6a55aa1b2462e48e72233",
      "readingUnitId": "c01-s01-p007-05992-r004-005",
      "parentQuestionId": "q-c01-036",
      "parentFingerprint": "f40a92d517677e4eba9f29a3cef8cd7ff654fbbeb57caa732e4c1c438d8708df",
      "passageSha256": "d97601be6b75091f57bb73ac2b61dad6feb3e01edfc44868e985e19681985ced",
      "pdfPages": [
        7,
        8
      ]
    },
    {
      "order": 5,
      "questionId": "qe-c01-0005",
      "sentenceId": "c01-s01-p007-05992-s008",
      "sentenceText": "She was about to start graduate school in Boston.",
      "sentenceSha256": "037b9acda0b5394026de05b2e3c28561abccb079f6154ea8531b0b75a0af7d8d",
      "readingUnitId": "c01-s01-p007-05992-r008-011",
      "parentQuestionId": "q-c01-037",
      "parentFingerprint": "fecce4aa30281affa14eaa717601e8d7239656452586c46550b688685e84b606",
      "passageSha256": "cfb0c09cbe2e1184cdb46923e23290e34c4fd8f8b7ac3f0f250214720a3158da",
      "pdfPages": [
        8
      ]
    },
    {
      "order": 6,
      "questionId": "qe-c01-0006",
      "sentenceId": "c01-s01-p007-05992-s009",
      "sentenceText": "I was about to start a year in Lewiston, Maine.",
      "sentenceSha256": "c66609ecf770524e7ebf3e0cc488c5e483b67c96e37b73b44e565ff001fd558c",
      "readingUnitId": "c01-s01-p007-05992-r008-011",
      "parentQuestionId": "q-c01-037",
      "parentFingerprint": "fecce4aa30281affa14eaa717601e8d7239656452586c46550b688685e84b606",
      "passageSha256": "cfb0c09cbe2e1184cdb46923e23290e34c4fd8f8b7ac3f0f250214720a3158da",
      "pdfPages": [
        8
      ]
    },
    {
      "order": 7,
      "questionId": "qe-c01-0007",
      "sentenceId": "c01-s01-p007-05992-s011",
      "sentenceText": "In May, I had to go back to Tokyo.",
      "sentenceSha256": "cb80fb0a265ec7a646e6ccee052a5ae22aa2669b1d47cfd849b0670e469cb56c",
      "readingUnitId": "c01-s01-p007-05992-r008-011",
      "parentQuestionId": "q-c01-037",
      "parentFingerprint": "fecce4aa30281affa14eaa717601e8d7239656452586c46550b688685e84b606",
      "passageSha256": "cfb0c09cbe2e1184cdb46923e23290e34c4fd8f8b7ac3f0f250214720a3158da",
      "pdfPages": [
        8
      ]
    },
    {
      "order": 8,
      "questionId": "qe-c01-0008",
      "sentenceId": "c01-s01-p007-05992-s014",
      "sentenceText": "Next were stops of varying lengths in New York City; Champaign, Illinois; Minneapolis, Minnesota; and Charlottesville, Virginia, before moving onward to Chicago.",
      "sentenceSha256": "dd5aa3e3d0345b0c5a17f201c99673917b64961f58ac3fa752e0080a11d99f61",
      "readingUnitId": "c01-s01-p007-05992-r014-016",
      "parentQuestionId": "q-c01-039",
      "parentFingerprint": "b49c974df2b9e4931a7f6e8238dcc940c569da679c880a94c4007c57be755197",
      "passageSha256": "a09002a399a53dcca96c32e4ba4e8bd33b570c75c55349a7788497b782f93ef1",
      "pdfPages": [
        8
      ]
    },
    {
      "order": 9,
      "questionId": "qe-c01-0009",
      "sentenceId": "c01-s01-p007-05992-s016",
      "sentenceText": "I have not seen any of my elementary school friends in years.",
      "sentenceSha256": "0f0ce7436e92fb5f8d097d3b9f0166e2380d3b3cc0d0c4d78e1328e88a75baf9",
      "readingUnitId": "c01-s01-p007-05992-r014-016",
      "parentQuestionId": "q-c01-039",
      "parentFingerprint": "b49c974df2b9e4931a7f6e8238dcc940c569da679c880a94c4007c57be755197",
      "passageSha256": "a09002a399a53dcca96c32e4ba4e8bd33b570c75c55349a7788497b782f93ef1",
      "pdfPages": [
        8
      ]
    },
    {
      "order": 10,
      "questionId": "qe-c01-0010",
      "sentenceId": "c01-s01-p008-04260-s002",
      "sentenceText": "An annual cherry blossom party in spring, the Obon dance festival in summer, a foliage tour in fall, and hot springs in winter.",
      "sentenceSha256": "932c57893b1ba6bc819b458cf44fed0d7c82001236b5d32a34627edf650f797a",
      "readingUnitId": "c01-s01-p008-04260-r001-004",
      "parentQuestionId": "q-c01-040",
      "parentFingerprint": "ba8afc3ada1968f3fab0428fa96999da2cd3733f8ef25d1f6deb3ca99adf890a",
      "passageSha256": "2856a62f103c73967e8d6b59f7c510e32d96bfd8722976dc13320487026dc611",
      "pdfPages": [
        8
      ]
    },
    {
      "order": 11,
      "questionId": "qe-c01-0011",
      "sentenceId": "c01-s01-p008-04260-s003",
      "sentenceText": "It’s a cozy life, a good life.",
      "sentenceSha256": "6e2508c7a15eecb2f99840f965ea9ef351ade329b5fc62ec385e919fd27e2a04",
      "readingUnitId": "c01-s01-p008-04260-r001-004",
      "parentQuestionId": "q-c01-040",
      "parentFingerprint": "ba8afc3ada1968f3fab0428fa96999da2cd3733f8ef25d1f6deb3ca99adf890a",
      "passageSha256": "2856a62f103c73967e8d6b59f7c510e32d96bfd8722976dc13320487026dc611",
      "pdfPages": [
        8
      ]
    },
    {
      "order": 12,
      "questionId": "qe-c01-0012",
      "sentenceId": "c01-s02-p009-00982-s001",
      "sentenceText": "I think back to when I was graduating high school, when I was faced with the question framed in the immortal words of The Clash: “Should I stay or should I go?”",
      "sentenceSha256": "e5a3d011d964e6d800879504faa6ca564687535bd6536f1cb2f540d2268802e4",
      "readingUnitId": "c01-s02-p009-00982-r001-004",
      "parentQuestionId": "q-c01-041",
      "parentFingerprint": "5a7006d97f08817decf69f3cc10cbfdacef30d38deaf5905a5858b18cd7fdcb4",
      "passageSha256": "2242d079c8c8ae375fedf9c7f67719acac45b390b87fbeb61dea6614a7b2f9bb",
      "pdfPages": [
        9
      ]
    },
    {
      "order": 13,
      "questionId": "qe-c01-0013",
      "sentenceId": "c01-s02-p009-00982-s005",
      "sentenceText": "This question has been at the center of both my personal life and my academic research for decades.",
      "sentenceSha256": "6eb5cb4d71d92ef837086c2951451164601e1aef71b16a5543c5d1ae5f2c97ce",
      "readingUnitId": "c01-s02-p009-00982-r005-008",
      "parentQuestionId": "q-c01-042",
      "parentFingerprint": "73d7c5bf28d240efa639db2d9e31dae58149a98c512e55b09b4d691789f7ad4a",
      "passageSha256": "a8c5368d3751554bb3597cd0af2a4b65a85b3fa2778c76d88c97d0f5194a939e",
      "pdfPages": [
        9
      ]
    },
    {
      "order": 14,
      "questionId": "qe-c01-0014",
      "sentenceId": "c01-s02-p009-00982-s006",
      "sentenceText": "I imagine most of you have also asked yourselves that very same question, not just once or twice, but many times over.",
      "sentenceSha256": "5dc498c2ed908626834736c6e675e1b847683e77b14e148cbd4133675b74e83b",
      "readingUnitId": "c01-s02-p009-00982-r005-008",
      "parentQuestionId": "q-c01-042",
      "parentFingerprint": "73d7c5bf28d240efa639db2d9e31dae58149a98c512e55b09b4d691789f7ad4a",
      "passageSha256": "a8c5368d3751554bb3597cd0af2a4b65a85b3fa2778c76d88c97d0f5194a939e",
      "pdfPages": [
        9
      ]
    },
    {
      "order": 15,
      "questionId": "qe-c01-0015",
      "sentenceId": "c01-s02-p009-04298-s001",
      "sentenceText": "When author Donna Tartt was asked what questions she was grappling with in her novel The Goldfinch, she said, “What is a good life?…To be happy oneself?",
      "sentenceSha256": "f5a75c167f2976beee3d9af99fc8222ac8882b6175c3f7fdb3f3b39f015adb37",
      "readingUnitId": "c01-s02-p009-04298-r001-006",
      "parentQuestionId": "q-c01-012",
      "parentFingerprint": "91bfefa368cc2b1289c5fad71958ed0ab79c999ee538579b771c547870b2e99f",
      "passageSha256": "6f9a88a3fc831ad92d946fffb4b058503423f4987e7afee82820fa6b788eefb1",
      "pdfPages": [
        9
      ]
    },
    {
      "order": 16,
      "questionId": "qe-c01-0016",
      "sentenceId": "c01-s02-p009-04298-s002",
      "sentenceText": "Is it personal happiness?",
      "sentenceSha256": "bacee2190fde6f1902d1b7db887e57c59afa7148ceab0a51d823e4ae50083270",
      "readingUnitId": "c01-s02-p009-04298-r001-006",
      "parentQuestionId": "q-c01-012",
      "parentFingerprint": "91bfefa368cc2b1289c5fad71958ed0ab79c999ee538579b771c547870b2e99f",
      "passageSha256": "6f9a88a3fc831ad92d946fffb4b058503423f4987e7afee82820fa6b788eefb1",
      "pdfPages": [
        9
      ]
    },
    {
      "order": 17,
      "questionId": "qe-c01-0017",
      "sentenceId": "c01-s02-p009-04298-s003",
      "sentenceText": "Or is it to make other people happy even at the expense of one’s own happiness?”",
      "sentenceSha256": "7b723dab4cf801a33b9adb3114c8f5c0f517505e6737ccf2f0b50134ed4d3e1c",
      "readingUnitId": "c01-s02-p009-04298-r001-006",
      "parentQuestionId": "q-c01-012",
      "parentFingerprint": "91bfefa368cc2b1289c5fad71958ed0ab79c999ee538579b771c547870b2e99f",
      "passageSha256": "6f9a88a3fc831ad92d946fffb4b058503423f4987e7afee82820fa6b788eefb1",
      "pdfPages": [
        9
      ]
    },
    {
      "order": 18,
      "questionId": "qe-c01-0018",
      "sentenceId": "c01-s02-p009-04298-s004",
      "sentenceText": "Tartt’s question is profound.",
      "sentenceSha256": "befd3d38bb634915f63c3220f6f9f91fbbbe2562e78c080a18e5db5424bf5ca7",
      "readingUnitId": "c01-s02-p009-04298-r001-006",
      "parentQuestionId": "q-c01-012",
      "parentFingerprint": "91bfefa368cc2b1289c5fad71958ed0ab79c999ee538579b771c547870b2e99f",
      "passageSha256": "6f9a88a3fc831ad92d946fffb4b058503423f4987e7afee82820fa6b788eefb1",
      "pdfPages": [
        9
      ]
    },
    {
      "order": 19,
      "questionId": "qe-c01-0019",
      "sentenceId": "c01-s02-p009-05468-s001",
      "sentenceText": "First, what is personal happiness?",
      "sentenceSha256": "9d7fdfef407a630661177cced8799f30e6abae3069021547be93c621ba0f5bc4",
      "readingUnitId": "c01-s02-p009-05468-r001-004",
      "parentQuestionId": "q-c01-044",
      "parentFingerprint": "ac652004fa49f55a3faa2ef67c944f0269cd78371a284a61654df355ef08b2f0",
      "passageSha256": "51922cf9833c81d58e55ca23783281223069ffa9916a42f057d3e537a7514fb6",
      "pdfPages": [
        9
      ]
    },
    {
      "order": 20,
      "questionId": "qe-c01-0020",
      "sentenceId": "c01-s02-p009-05468-s005",
      "sentenceText": "A trip to the beach or the spa?",
      "sentenceSha256": "fb00a1a89ba0e38ad2a262726b1446b7efb71abe98a87cdd23009faab8e1824b",
      "readingUnitId": "c01-s02-p009-05468-r005-006",
      "parentQuestionId": "q-c01-045",
      "parentFingerprint": "e33a08c8ea188f41d6b855679020e387987f3387d96b3ddd1570bda4774490ad",
      "passageSha256": "78e6314228612136690ad8274b4c761192fd788972cd2edbc411a3771e1c4933",
      "pdfPages": [
        9
      ]
    },
    {
      "order": 21,
      "questionId": "qe-c01-0021",
      "sentenceId": "c01-s02-p009-05468-s012",
      "sentenceText": "Indeed, psychologists have found that prosocial spending, writing gratitude letters, and having a satisficer (i.e., happy with good enough) mindset all promote happiness.",
      "sentenceSha256": "572f293a84902cede331f2e295a4cd94adb4108cac4a1ec1ca3a45f906014c2c",
      "readingUnitId": "c01-s02-p009-05468-r011-012",
      "parentQuestionId": "q-c01-047",
      "parentFingerprint": "994777a274cc038b8f5308831c10f5f0a1ac3c7a575fa20c48f1d4ae57c2f466",
      "passageSha256": "73ec9b61695c257a49ef43bbee2e73e8f10a69f2201d1fea9acd9d603f614820",
      "pdfPages": [
        10
      ]
    },
    {
      "order": 22,
      "questionId": "qe-c01-0022",
      "sentenceId": "c01-s02-p010-02895-s001",
      "sentenceText": "Perhaps the key to my father’s good life has been his decision to put the needs of others—my mother and family tradition—above his own.",
      "sentenceSha256": "f0c4ee9c6226db0aa9992b61b33a09228ca76b3fb3abb516addfdd9bef85cf72",
      "readingUnitId": "c01-s02-p010-02895-r001-002",
      "parentQuestionId": "q-c01-048",
      "parentFingerprint": "d9b255b3bc46f7984f4e7d79c3fe5c6e415d822f0e41971d9a3bee07585ccb70",
      "passageSha256": "002d43e8e481fc03c4e06a7600b5742e13f0f930a52b10ff22ba0425786bd7e2",
      "pdfPages": [
        10
      ]
    },
    {
      "order": 23,
      "questionId": "qe-c01-0023",
      "sentenceId": "c01-s02-p010-02895-s007",
      "sentenceText": "French philosopher Jean-Paul Sartre would have called this a life of “bad faith.”",
      "sentenceSha256": "5aab0a523fb2784608bea54003b81af99c4156944c48ff5bb9342411903ec95d",
      "readingUnitId": "c01-s02-p010-02895-r007-008",
      "parentQuestionId": "q-c01-050",
      "parentFingerprint": "b95fd704cc7a8095cc2bcaec492aa54b4a5060956108358b5194471f5f6a274e",
      "passageSha256": "ae636b67d72a33a4632bd309d49d88dcf28fa7b1a8a79712b9bfd99bdbe65651",
      "pdfPages": [
        10
      ]
    },
    {
      "order": 24,
      "questionId": "qe-c01-0024",
      "sentenceId": "c01-s02-p010-05625-s001",
      "sentenceText": "At the opposite end of the spectrum is the neurologist and writer Oliver Sacks, who was an enthusiastic Hells Angels motorcyclist, bodybuilder, and LSD user before launching his writing career.",
      "sentenceSha256": "fa48c3aefbdf9d84ecb704610b3826ad090c8b6e59e5b8e312c3977eb5ebfafc",
      "readingUnitId": "c01-s02-p010-05625-r001-003",
      "parentQuestionId": "q-c01-017",
      "parentFingerprint": "d5198cb6f475d383d705254e5cb14cc2e5798eb45eaa5297bf66e4ee34ab0582",
      "passageSha256": "92f5267f7fd0f45500414767838f0ce3d0de130c2684a799850e887030b74460",
      "pdfPages": [
        10,
        11
      ]
    },
    {
      "order": 25,
      "questionId": "qe-c01-0025",
      "sentenceId": "c01-s02-p010-05625-s002",
      "sentenceText": "He struggled with depression in his college days; his own mother told him that she wished he had never been born when she learned that he was gay; and he spent thirty-five years of his adult life celibate.",
      "sentenceSha256": "4685ba7319c1fec5d017f3cb686741c209886ac7b00aca7b25ac10b0fb2ab724",
      "readingUnitId": "c01-s02-p010-05625-r001-003",
